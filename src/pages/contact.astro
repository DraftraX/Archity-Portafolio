---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { contactData, heroData, playgroundItems } from "../data/portfolioData";

const leftPhoto = playgroundItems[0];
const rightPhoto = playgroundItems[1];
---

<Layout title="Archity — Contact" flexBody={true}>
  <Header />

  <main class="ca-grid relative flex flex-1 flex-col px-4 py-10 sm:py-4">
    <!-- Polaroids laterales en escritorio idénticas a la captura 4 -->
    <div class="pointer-events-none absolute inset-0 hidden lg:block">
      <div class="absolute left-[9%] top-[14%] w-60 xl:w-72 -rotate-8">
        <figure class="pointer-events-auto relative inline-block w-full bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)]">
          <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
          <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
          <div class="aspect-[4/5] w-full overflow-hidden">
            <img src={leftPhoto.src} alt={leftPhoto.captionEn} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <figcaption
            class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70"
            data-es={leftPhoto.captionEs}
            data-en={leftPhoto.captionEn}
          >
            {leftPhoto.captionEs}
          </figcaption>
        </figure>
      </div>

      <div class="absolute right-[9%] top-[18%] w-60 xl:w-72 rotate-9">
        <figure class="pointer-events-auto relative inline-block w-full bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)]">
          <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
          <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
          <div class="aspect-[4/5] w-full overflow-hidden">
            <img src={rightPhoto.src} alt={rightPhoto.captionEn} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <figcaption
            class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70"
            data-es={rightPhoto.captionEs}
            data-en={rightPhoto.captionEn}
          >
            {rightPhoto.captionEs}
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="relative mx-auto my-auto flex w-full max-w-2xl flex-col items-center">
      <div class="flex flex-col items-center">
        <p class="ca-hand text-2xl text-[var(--ca-ink)] sm:text-3xl" data-es={contactData.sayHiEs} data-en={contactData.sayHiEn}>
          {contactData.sayHiEs}
        </p>
        <svg viewBox="0 0 64 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="mt-0.5 h-3 w-20" aria-hidden="true">
          <path d="M3 4c18-3 40-3 58 0"></path>
          <path d="M9 9c14-2.5 32-2.5 46 0"></path>
        </svg>
      </div>

      <!-- Recuadro CONTACT con las 4 esquinas azules -->
      <div class="mt-3 -rotate-2">
        <div class="relative border-[3px] border-[var(--ca-ink)] px-6 py-1.5 sm:px-10">
          <span class="absolute -left-2 -top-2 h-4 w-4 bg-[var(--ca-blue)]"></span>
          <span class="absolute -right-2 -top-2 h-4 w-4 bg-[var(--ca-blue)]"></span>
          <span class="absolute -bottom-2 -left-2 h-4 w-4 bg-[var(--ca-blue)]"></span>
          <span class="absolute -bottom-2 -right-2 h-4 w-4 bg-[var(--ca-blue)]"></span>
          <span
            class="ca-display text-6xl uppercase leading-none tracking-tight text-[var(--ca-ink)] sm:text-8xl lg:text-9xl inline-block"
            data-es={contactData.bannerEs}
            data-en={contactData.bannerEn}
          >
            {contactData.bannerEs}
          </span>
        </div>
      </div>

      <!-- Formulario en nota amarilla de 2 pasos (1/2 -> 2/2) -->
      <div class="mt-5 w-full max-w-md">
        <div class="bg-[var(--ca-yellow-soft)] p-5 shadow-[3px_5px_16px_rgba(17,18,18,0.16)]">
          <form id="ca-contact-form" novalidate>
            <p
              class="ca-mono text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)]"
              data-es={contactData.descriptionEs}
              data-en={contactData.descriptionEn}
            >
              {contactData.descriptionEs}
            </p>

            <div class="grid">
              <!-- Paso 1 (1/2) -->
              <div id="ca-step-1" class="col-start-1 row-start-1">
                <textarea
                  rows="4"
                  id="ca-contact-message"
                  name="message"
                  class="mt-3 min-h-28 w-full resize-none border-0 bg-transparent p-0 text-base text-[var(--ca-ink)] shadow-none outline-none placeholder:text-[var(--ca-ink)]/65 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--ca-blue)]"
                  placeholder="Cuéntame una historia o una idea de proyecto…"
                  data-placeholder-es="Cuéntame una historia o una idea de proyecto…"
                  data-placeholder-en="Tell me a story, or a project idea…"
                  aria-label="Your message"
                ></textarea>
                <button
                  id="ca-btn-next"
                  type="button"
                  class="ca-mono mt-3 inline-flex bg-[var(--ca-ink)] px-4 py-2 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-[var(--ca-blue)] hover:text-[var(--ca-ink)] cursor-pointer"
                  data-es="Siguiente (1/2)"
                  data-en="Next (1/2)"
                >
                  Siguiente (1/2)
                </button>
              </div>

              <!-- Paso 2 (2/2) -->
              <div id="ca-step-2" class="col-start-1 row-start-1 invisible pointer-events-none">
                <div class="mt-3 flex flex-col gap-3">
                  <div>
                    <label
                      class="block ca-mono text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)]/70"
                      for="ca-contact-name"
                      data-es="Nombre"
                      data-en="Name"
                    >
                      Nombre
                    </label>
                    <input
                      type="text"
                      id="ca-contact-name"
                      name="name"
                      autocomplete="name"
                      class="w-full border-0 bg-transparent p-0 text-base text-[var(--ca-ink)] shadow-none outline-none placeholder:text-[var(--ca-ink)]/65 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--ca-blue)] rounded-none border-b-2 border-[var(--ca-ink)]/25 pb-1"
                      placeholder="Tu nombre"
                      data-placeholder-es="Tu nombre"
                      data-placeholder-en="Jane Doe"
                    />
                  </div>
                  <div>
                    <label
                      class="block ca-mono text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)]/70"
                      for="ca-contact-email"
                      data-es="Correo"
                      data-en="Email"
                    >
                      Correo
                    </label>
                    <input
                      type="email"
                      id="ca-contact-email"
                      name="email"
                      autocomplete="email"
                      class="w-full border-0 bg-transparent p-0 text-base text-[var(--ca-ink)] shadow-none outline-none placeholder:text-[var(--ca-ink)]/65 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--ca-blue)] rounded-none border-b-2 border-[var(--ca-ink)]/25 pb-1"
                      placeholder="correo@ejemplo.com"
                      data-placeholder-es="correo@ejemplo.com"
                      data-placeholder-en="jane@example.com"
                    />
                  </div>
                </div>

                <div class="mt-3 flex items-center gap-3">
                  <button
                    id="ca-btn-back"
                    type="button"
                    aria-label="Back to your note"
                    class="ca-mono px-2 py-2 text-sm font-bold text-[var(--ca-ink)]/70 transition-colors hover:text-[var(--ca-ink)] cursor-pointer"
                  >
                    ←
                  </button>
                  <button
                    id="ca-btn-send"
                    type="submit"
                    class="ca-mono inline-flex bg-[var(--ca-ink)] px-4 py-2 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-[var(--ca-blue)] hover:text-[var(--ca-ink)] cursor-pointer"
                    data-es="Enviar (2/2)"
                    data-en="Send (2/2)"
                  >
                    Enviar (2/2)
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

      <div class="mt-5 flex items-center gap-3">
        <svg viewBox="0 0 48 24" fill="none" stroke="var(--ca-ink)" stroke-width="1.8" stroke-linecap="round" class="h-6 w-12" aria-hidden="true">
          <path d="M2 6c12 10 26 14 40 12"></path>
          <path d="M36 14l6 4-7 3"></path>
        </svg>
        <p class="ca-hand text-2xl text-[var(--ca-ink)] sm:text-3xl" data-es={heroData.statusEs} data-en={heroData.statusEn}>
          {heroData.statusEs}
        </p>
      </div>

      <p class="mt-2 text-sm font-bold">
        <a href={`mailto:${contactData.email}`} class="ca-mono text-[var(--ca-blue)] underline-offset-2 hover:underline">
          {contactData.email}
        </a>
      </p>

      <div class="mt-4 flex gap-2 rounded-2xl bg-white px-6 py-2.5 shadow-[0_12px_32px_rgba(17,18,18,0.12)] sm:gap-6 sm:px-8">
        <a
          href="https://www.linkedin.com/company/archit-tech/posts/?viewAsMember=true"
          target="_blank"
          rel="noopener"
          class="ca-mono flex flex-col items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)] transition-colors hover:text-[var(--ca-blue)]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
          LinkedIn
        </a>

        <a
          href="https://www.facebook.com/profile.php?id=61590953622590"
          target="_blank"
          rel="noopener"
          class="ca-mono flex flex-col items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)] transition-colors hover:text-[var(--ca-blue)]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z"></path>
          </svg>
          Facebook
        </a>

        <a
          href="https://wa.me/51940771896?text=Hola%20Archity,%20vi%20su%20portafolio%20y%20me%20gustar%C3%ADa%20conversar."
          target="_blank"
          rel="noopener"
          class="ca-mono flex flex-col items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)] transition-colors hover:text-[var(--ca-blue)]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12.031 2c-5.516 0-9.999 4.486-9.999 10.001 0 1.766.461 3.489 1.338 5.008L2 22l5.125-1.344c1.471.801 3.129 1.224 4.904 1.225h.004c5.515 0 9.998-4.486 9.998-10.001 0-2.672-1.04-5.184-2.928-7.073C17.215 3.04 14.703 2 12.031 2zm5.828 14.122c-.246.693-1.434 1.326-1.988 1.409-.508.076-1.151.108-1.858-.116-.429-.136-.978-.318-1.682-.622-2.961-1.278-4.894-4.258-5.042-4.455-.148-.197-1.205-1.602-1.205-3.056 0-1.454.763-2.169 1.034-2.465.271-.296.591-.37.788-.37.197 0 .394.002.566.01.182.009.426-.069.665.508.246.592.838 2.046.912 2.194.074.148.123.32.025.517-.099.197-.148.32-.296.493-.148.172-.311.385-.444.517-.148.148-.302.309-.13.605.172.296.766 1.264 1.645 2.047 1.13.998 2.083 1.307 2.379 1.455.296.148.468.123.641-.074.172-.197.739-.863.936-1.159.197-.296.394-.246.665-.148.271.099 1.725.813 2.021.961.296.148.493.222.567.345.074.123.074.715-.172 1.408z"></path>
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  const step1 = document.getElementById("ca-step-1");
  const step2 = document.getElementById("ca-step-2");
  const btnNext = document.getElementById("ca-btn-next");
  const btnBack = document.getElementById("ca-btn-back");
  const contactForm = document.getElementById("ca-contact-form") as HTMLFormElement | null;
  const msgInput = document.getElementById("ca-contact-message") as HTMLTextAreaElement | null;
  const nameInput = document.getElementById("ca-contact-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("ca-contact-email") as HTMLInputElement | null;

  btnNext?.addEventListener("click", () => {
    if (msgInput && !msgInput.value.trim()) {
      msgInput.focus();
      return;
    }
    step1?.classList.add("invisible", "pointer-events-none");
    step2?.classList.remove("invisible", "pointer-events-none");
    nameInput?.focus();
  });

  btnBack?.addEventListener("click", () => {
    step2?.classList.add("invisible", "pointer-events-none");
    step1?.classList.remove("invisible", "pointer-events-none");
    msgInput?.focus();
  });

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const message = msgInput?.value.trim() || "Hola Archity, me gustaría conversar sobre un proyecto.";
    const name = nameInput?.value.trim() || "Cliente";
    const contact = emailInput?.value.trim() || "";
    const text = `Hola Archity, soy *${name}*${contact ? ` (${contact})` : ""}.\n\n${message}`;
    const waUrl = `https://wa.me/51940771896?text=${encodeURIComponent(text)}`;
    window.open(waUrl, "_blank", "noopener");
  });
</script>
