---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { playgroundItems } from "../data/portfolioData";
---

<Layout title="Archity — Playground">
  <Header />

  <main class="ca-grid relative h-[calc(100vh-4.5rem)] overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-6 z-40 flex -translate-x-1/2 flex-col items-center text-center">
      <p class="ca-hand text-2xl text-[var(--ca-ink)] sm:text-3xl">playground</p>
      <span class="mt-2">
        <span
          class="ca-display text-5xl leading-[0.92] tracking-tight text-[var(--ca-ink)] sm:text-7xl inline-block"
          data-es="SOLO POR DIVERSIÓN"
          data-en="JUST FOR FUN"
        >
          SOLO POR DIVERSIÓN
        </span>
      </span>
    </div>

    <div id="ca-playground-wheel" class="absolute inset-0">
      <div
        id="ca-playground-stage"
        class="h-full w-full transition-transform duration-200 ease-out"
        style="transform:scale(1);transform-origin:50% 45%"
      >
        {
          playgroundItems.map((item) => (
            <div
              data-pg-card
              class={`
                absolute select-none ${item.w}
                cursor-grab touch-none active:cursor-grabbing [&_img]:pointer-events-none
              `}
              style={`left:${item.left};top:${item.top}`}
            >
              <div class="w-full">
                <div class={`relative ${item.tilt} w-full`}>
                  <div class="overflow-hidden bg-[var(--ca-surface)] shadow-[0_10px_28px_rgba(17,18,18,0.22)]">
                    <div class="relative overflow-hidden aspect-[4/5] w-full">
                      <img
                        src={item.src}
                        alt={item.captionEn}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                    </div>
                  </div>
                  <span
                    class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-2xl sm:text-4xl -rotate-6 absolute -left-3 -top-4 max-w-[85%]"
                    style={`background-color:${item.color}`}
                    data-es={item.captionEs}
                    data-en={item.captionEn}
                  >
                    {item.captionEs}
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="absolute bottom-6 right-6 z-40 flex flex-col gap-2">
      <button
        id="ca-pg-zoom-in"
        type="button"
        aria-label="Zoom in"
        class="ca-mono flex h-11 w-11 items-center justify-center border-2 border-[var(--ca-ink)] bg-[var(--ca-surface)] text-xl font-bold text-[var(--ca-ink)] transition-colors hover:bg-[var(--ca-blue)] hover:text-white cursor-pointer"
      >
        +
      </button>
      <button
        id="ca-pg-zoom-out"
        type="button"
        aria-label="Zoom out"
        class="ca-mono flex h-11 w-11 items-center justify-center border-2 border-[var(--ca-ink)] bg-[var(--ca-surface)] text-xl font-bold text-[var(--ca-ink)] transition-colors hover:bg-[var(--ca-blue)] hover:text-white cursor-pointer"
      >
        −
      </button>
    </div>
  </main>
</Layout>

<script>
  const wheelEl = document.getElementById("ca-playground-wheel");
  const stageEl = document.getElementById("ca-playground-stage");
  const zoomInBtn = document.getElementById("ca-pg-zoom-in");
  const zoomOutBtn = document.getElementById("ca-pg-zoom-out");

  let scale = 1;
  let topZ = 10;

  const updateScale = (next: number) => {
    scale = Math.min(2.5, Math.max(0.35, next));
    if (stageEl) {
      stageEl.style.transform = `scale(${scale})`;
    }
  };

  wheelEl?.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      updateScale(scale * (e.deltaY < 0 ? 1.08 : 0.92));
    },
    { passive: false }
  );

  zoomInBtn?.addEventListener("click", () => {
    updateScale(scale * 1.2);
  });

  zoomOutBtn?.addEventListener("click", () => {
    updateScale(scale * 0.8);
  });

  let activeDrag: {
    el: HTMLElement;
    startX: number;
    startY: number;
    origLeft: number;
    origTop: number;
  } | null = null;

  document.querySelectorAll<HTMLElement>("[data-pg-card]").forEach((card) => {
    card.addEventListener("pointerdown", (e) => {
      try {
        card.setPointerCapture(e.pointerId);
      } catch (_) {}
      topZ += 1;
      card.style.zIndex = String(topZ);
      activeDrag = {
        el: card,
        startX: e.clientX,
        startY: e.clientY,
        origLeft: card.offsetLeft,
        origTop: card.offsetTop,
      };
    });

    card.addEventListener("pointermove", (e) => {
      if (!activeDrag || activeDrag.el !== card) return;
      card.style.left = `${activeDrag.origLeft + (e.clientX - activeDrag.startX) / scale}px`;
      card.style.top = `${activeDrag.origTop + (e.clientY - activeDrag.startY) / scale}px`;
    });

    const endDrag = () => {
      activeDrag = null;
    };
    card.addEventListener("pointerup", endDrag);
    card.addEventListener("pointercancel", endDrag);
  });
</script>
