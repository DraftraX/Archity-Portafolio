<Layout
  title="BOTICA SAN PEDRO — Farmacia, Salud & Cuidado Personal | Demo Archity"
  description="Catálogo farmacéutico interactivo con paginación funcional, carga de recetas médicas y despacho express en 45 minutos."
>
  <!-- Barra superior: Demo Mode Archity -->
  <div class="sticky top-0 z-50 flex items-center justify-between border-b border-emerald-950/20 bg-neutral-950 px-4 py-2 text-xs text-neutral-300">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
      <span class="font-medium">Demostración de Botica &amp; Farmacia Digital</span>
      <span class="hidden sm:inline text-neutral-500">· Desarrollada por Archity</span>
    </div>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md bg-neutral-800 px-3 py-1 font-semibold text-white hover:bg-neutral-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al Portafolio
    </a>
  </div>

  <!-- Header Propio de la Botica -->
  <header class="sticky top-8 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur-md shadow-xs">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Logotipo de la Botica -->
      <a href="/demos/botica" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-sm font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </span>
        <div>
          <span class="block font-display text-base font-bold tracking-tight text-neutral-900">BOTICA SAN PEDRO</span>
          <span class="block text-[10px] uppercase tracking-widest text-emerald-700 font-semibold">Farmacia &amp; Cuidado Integral · 24 Horas</span>
        </div>
      </a>

      <!-- Navegación de la Botica -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-600">
        <a href="#catalogo-botica" class="hover:text-emerald-700 transition-colors">Catálogo de Salud</a>
        <a href="#receta-medica" class="hover:text-emerald-700 transition-colors">Enviar Receta Rx</a>
        <a href="#servicios-botica" class="hover:text-emerald-700 transition-colors">Servicios &amp; Sedes</a>
        <a href="#contacto-botica" class="hover:text-emerald-700 transition-colors">Atención 24/7</a>
      </nav>

      <!-- Teléfono & Botiquín (Carrito) -->
      <div class="flex items-center gap-3">
        <a
          href="tel:+51940771896"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-neutral-700 hover:text-emerald-700"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>(01) 450-8800</span>
        </a>

        <a
          href="#carrito-botica"
          class="relative flex items-center gap-2 rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white hover:bg-emerald-700 transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Mi Botiquín</span>
          <span id="header-pharma-count" class="inline-flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-white px-1 text-[10px] font-extrabold text-emerald-700">0</span>
        </a>
      </div>

    </div>
  </header>

  <main>
    <!-- Hero Botica / Farmacia -->
    <section class="border-b border-neutral-200/80 bg-gradient-to-b from-emerald-50/60 via-white to-white py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Atención Farmacéutica 24/7 · Despacho en 45 Minutos</span>
            </div>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
              Medicamentos, Salud y Cuidado <span class="text-emerald-600">en la Puerta de tu Hogar</span>
            </h1>

            <p class="mt-5 text-base leading-relaxed text-neutral-600 sm:text-lg">
              Precios justos en medicamentos genéricos y de marca con registro sanitario DIGEMID. Consulta farmacéutica online, validación inmediata de recetas médicas y entrega express segura.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#catalogo-botica"
                class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-6 py-3.5 text-sm font-bold text-white shadow-xs transition-all hover:bg-emerald-700 active:scale-95"
              >
                Explorar Catálogo Paginado
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <a
                href="#receta-medica"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-neutral-300 bg-white px-5 py-3.5 text-sm font-semibold text-neutral-800 transition-colors hover:bg-neutral-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Subir Receta Médica
              </a>
            </div>

            <!-- Badges de confianza -->
            <div class="mt-8 grid grid-cols-3 gap-3 border-t border-neutral-200 pt-6">
              <div>
                <span class="block font-display text-xl font-bold text-neutral-900">100%</span>
                <span class="text-xs text-neutral-500">Registro DIGEMID</span>
              </div>
              <div>
                <span class="block font-display text-xl font-bold text-emerald-600">&lt; 45 min</span>
                <span class="text-xs text-neutral-500">Entrega Motorizada</span>
              </div>
              <div>
                <span class="block font-display text-xl font-bold text-neutral-900">24 / 7</span>
                <span class="text-xs text-neutral-500">Farmacéutico Regente</span>
              </div>
            </div>
          </div>

          <!-- Hero Image & Receta Express Card -->
          <div class="lg:col-span-5">
            <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white p-6 shadow-xl">
              <div class="relative overflow-hidden rounded-xl bg-emerald-100/50">
                <img
                  src="https://images.unsplash.com/photo-1576602976047-174e57a47881?auto=format&fit=crop&w=800&q=80"
                  alt="Atención Farmacéutica Botica San Pedro"
                  class="h-56 w-full object-cover"
                />
                <div class="absolute top-3 right-3 rounded-full bg-emerald-600 px-3 py-1 text-[11px] font-bold text-white shadow-sm">
                  Atención Directa
                </div>
              </div>

              <div class="mt-5">
                <h3 class="font-display text-base font-bold text-neutral-900">¿Tienes una Receta Médica?</h3>
                <p class="mt-1 text-xs text-neutral-600">
                  Fotografía tu receta o envíala en PDF. Nuestro químico farmacéutico cotiza tus medicamentos y te responde en menos de 5 minutos.
                </p>
                <div class="mt-4 flex items-center justify-between rounded-xl bg-emerald-50 p-3.5 text-xs">
                  <div class="flex items-center gap-2 text-emerald-900 font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Aceptamos todas las aseguradoras (EPS)
                  </div>
                  <span class="font-bold text-emerald-700">Sin recargo</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo de Medicamentos con Paginación Interactiva -->
    <section id="catalogo-botica" class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Vademécum Online</span>
            <h2 class="mt-1 font-display text-2xl font-bold text-neutral-900 sm:text-3xl">
              Catálogo de Farmacia &amp; Bienestar
            </h2>
            <p class="mt-1 text-xs text-neutral-500">
              Paginación en front-end (8 productos por página). Stock verificado en tiempo real.
            </p>
          </div>

          <!-- Búsqueda interactiva -->
          <div class="w-full sm:w-72">
            <div class="relative">
              <input
                type="text"
                id="pharma-search"
                placeholder="Buscar por fármaco o principio activo..."
                class="w-full rounded-xl border border-neutral-300 bg-white py-2.5 pr-4 pl-9 text-xs text-neutral-900 placeholder:text-neutral-400 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
              />
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute top-3 left-3 h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Filtros de categoría -->
        <div class="mt-6 flex flex-wrap items-center gap-2 border-b border-neutral-200 pb-4">
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors"
            data-cat="all"
          >
            Todos los Productos ({medicines.length})
          </button>
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
            data-cat="Medicamentos"
          >
            Medicamentos
          </button>
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
            data-cat="Vitaminas"
          >
            Vitaminas &amp; Suplementos
          </button>
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
            data-cat="Cuidado Piel"
          >
            Dermo-Cosmética
          </button>
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
            data-cat="Botiquín"
          >
            Botiquín &amp; Equipos
          </button>
          <button
            type="button"
            class="pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
            data-cat="Bebés"
          >
            Cuidado del Bebé
          </button>
        </div>

        <!-- Grid de Productos -->
        <div id="pharma-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {medicines.map((m) => (
            <div
              class="pharma-card flex flex-col justify-between overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-xs transition-all hover:border-emerald-300 hover:shadow-md"
              data-category={m.category}
              data-name={m.name.toLowerCase()}
              data-substance={m.activeSubstance.toLowerCase()}
              data-id={m.id}
            >
              <div>
                <!-- Imagen HD del Producto -->
                <div class="relative h-44 w-full overflow-hidden bg-neutral-100">
                  <img
                    src={m.image}
                    alt={m.name}
                    class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute top-2.5 left-2.5">
                    <span class="rounded-md bg-white/90 px-2 py-0.5 text-[10px] font-bold text-neutral-800 backdrop-blur-xs shadow-xs">
                      {m.badge}
                    </span>
                  </div>
                  {m.rx ? (
                    <div class="absolute top-2.5 right-2.5">
                      <span class="rounded-md bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-neutral-950 shadow-xs">
                        Receta Rx
                      </span>
                    </div>
