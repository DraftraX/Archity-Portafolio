<script>
  interface PharmaCartItem {
    id: string;
    name: string;
    price: number;
    qty: number;
  }

  let pharmaCart: PharmaCartItem[] = [];
  const PHARMA_PER_PAGE = 8;
  let currentPharmaPage = 1;
  let activePharmaCat = "all";
  let activePharmaSearch = "";

  const pharmaCards = Array.from(document.querySelectorAll<HTMLElement>(".pharma-card"));
  const catButtons = document.querySelectorAll<HTMLButtonElement>(".pharma-cat-btn");
  const searchInput = document.getElementById("pharma-search") as HTMLInputElement | null;
  const noPharmaMsg = document.getElementById("no-pharma-results");
  const paginationWrapper = document.getElementById("pharma-pagination");
  const btnPrev = document.getElementById("pharma-prev") as HTMLButtonElement | null;
  const btnNext = document.getElementById("pharma-next") as HTMLButtonElement | null;
  const pageButtonsContainer = document.getElementById("pharma-pages");
  const countFrom = document.getElementById("pharma-count-from");
  const countTo = document.getElementById("pharma-count-to");
  const countTotal = document.getElementById("pharma-count-total");

  // Carrito elements
  const cartItemsContainer = document.getElementById("cart-items-container");
  const cartTotalsSection = document.getElementById("cart-totals-section");
  const cartItemBadge = document.getElementById("cart-item-badge");
  const headerPharmaCount = document.getElementById("header-pharma-count");
  const cartSubtotal = document.getElementById("cart-subtotal");
  const cartTotal = document.getElementById("cart-total");
  const btnCheckout = document.getElementById("btn-checkout-pharma");

  function getFilteredPharma() {
    return pharmaCards.filter((card) => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";
      const substance = card.getAttribute("data-substance") || "";

      const matchCat = activePharmaCat === "all" || cat === activePharmaCat;
      const matchSearch =
        !activePharmaSearch ||
        name.includes(activePharmaSearch) ||
        substance.includes(activePharmaSearch);

      return matchCat && matchSearch;
    });
  }

  function renderPharmaPagination() {
    const filtered = getFilteredPharma();
    const total = filtered.length;
    const maxPages = Math.ceil(total / PHARMA_PER_PAGE) || 1;

    if (currentPharmaPage > maxPages) currentPharmaPage = maxPages;
    if (currentPharmaPage < 1) currentPharmaPage = 1;

    const startIdx = (currentPharmaPage - 1) * PHARMA_PER_PAGE;
    const endIdx = startIdx + PHARMA_PER_PAGE;

    // Mostrar u ocultar cartas
    pharmaCards.forEach((card) => card.classList.add("hidden"));
    filtered.slice(startIdx, endIdx).forEach((card) => card.classList.remove("hidden"));

    // Actualizar contadores
    if (countFrom) countFrom.textContent = total === 0 ? "0" : (startIdx + 1).toString();
    if (countTo) countTo.textContent = Math.min(endIdx, total).toString();
    if (countTotal) countTotal.textContent = total.toString();

    // Mensaje de vacio
    if (total === 0) {
      noPharmaMsg?.classList.remove("hidden");
      noPharmaMsg?.classList.add("flex");
      paginationWrapper?.classList.add("hidden");
    } else {
      noPharmaMsg?.classList.add("hidden");
      noPharmaMsg?.classList.remove("flex");
      paginationWrapper?.classList.remove("hidden");
    }

    if (btnPrev) btnPrev.disabled = currentPharmaPage <= 1;
    if (btnNext) btnNext.disabled = currentPharmaPage >= maxPages;

    if (pageButtonsContainer) {
      pageButtonsContainer.innerHTML = "";
      for (let i = 1; i <= maxPages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = i.toString();
        b.className =
          i === currentPharmaPage
            ? "h-8 w-8 rounded-lg bg-emerald-600 text-xs font-bold text-white shadow-xs"
            : "h-8 w-8 rounded-lg border border-neutral-300 bg-white text-xs font-semibold text-neutral-700 hover:bg-neutral-100";
        b.addEventListener("click", () => {
          currentPharmaPage = i;
          renderPharmaPagination();
          document.getElementById("catalogo-botica")?.scrollIntoView({ behavior: "smooth" });
        });
        pageButtonsContainer.appendChild(b);
      }
    }
  }

  function renderPharmaCart() {
    const totalQty = pharmaCart.reduce((sum, item) => sum + item.qty, 0);
    const totalPrice = pharmaCart.reduce((sum, item) => sum + item.price * item.qty, 0);

    if (headerPharmaCount) headerPharmaCount.textContent = totalQty.toString();
    if (cartItemBadge) cartItemBadge.textContent = `${totalQty} medicamento${totalQty === 1 ? "" : "s"}`;

    if (pharmaCart.length === 0) {
      if (cartItemsContainer) {
        cartItemsContainer.innerHTML = `
          <p class="py-8 text-center text-xs text-neutral-500">
            Tu botiquín está vacío. Agrega medicamentos o productos de cuidado desde el catálogo superior.
          </p>
        `;
      }
      cartTotalsSection?.classList.add("hidden");
      return;
    }

    cartTotalsSection?.classList.remove("hidden");
    if (cartSubtotal) cartSubtotal.textContent = `S/ ${totalPrice.toFixed(2)}`;
    if (cartTotal) cartTotal.textContent = `S/ ${totalPrice.toFixed(2)}`;

    if (cartItemsContainer) {
      cartItemsContainer.innerHTML = "";
      pharmaCart.forEach((item) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between py-3 text-xs";
        row.innerHTML = `
          <div class="flex-1 pr-3">
            <h4 class="font-bold text-neutral-900">${item.name}</h4>
            <span class="text-neutral-500">S/ ${item.price.toFixed(2)} c/u</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex items-center rounded-lg border border-neutral-200">
              <button type="button" class="btn-qty-minus px-2 py-1 text-neutral-600 hover:bg-neutral-100" data-id="${item.id}">-</button>
              <span class="px-2 font-bold text-neutral-900">${item.qty}</span>
              <button type="button" class="btn-qty-plus px-2 py-1 text-neutral-600 hover:bg-neutral-100" data-id="${item.id}">+</button>
            </div>
            <span class="w-16 text-right font-bold text-neutral-900">S/ ${(item.price * item.qty).toFixed(2)}</span>
            <button type="button" class="btn-del-item text-neutral-400 hover:text-red-500" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `;
        cartItemsContainer.appendChild(row);
      });

      // Listeners de cantidad
      cartItemsContainer.querySelectorAll(".btn-qty-plus").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          const found = pharmaCart.find((p) => p.id === id);
          if (found) {
            found.qty++;
            renderPharmaCart();
          }
        });
      });

      cartItemsContainer.querySelectorAll(".btn-qty-minus").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          const found = pharmaCart.find((p) => p.id === id);
          if (found) {
            found.qty--;
            if (found.qty <= 0) {
              pharmaCart = pharmaCart.filter((p) => p.id !== id);
            }
            renderPharmaCart();
          }
        });
      });

      cartItemsContainer.querySelectorAll(".btn-del-item").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          pharmaCart = pharmaCart.filter((p) => p.id !== id);
          renderPharmaCart();
        });
      });
    }
  }

  // Agregar al carrito
  document.querySelectorAll(".btn-add-pharma").forEach((b) => {
    b.addEventListener("click", () => {
      const btn = b as HTMLElement;
      const id = btn.getAttribute("data-id") || "";
      const name = btn.getAttribute("data-name") || "";
      const price = parseFloat(btn.getAttribute("data-price") || "0");

      const exists = pharmaCart.find((item) => item.id === id);
      if (exists) {
        exists.qty++;
      } else {
        pharmaCart.push({ id, name, price, qty: 1 });
      }

      renderPharmaCart();

      const origText = btn.innerHTML;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Agregado`;
      btn.classList.add("bg-emerald-600");
      setTimeout(() => {
        btn.innerHTML = origText;
        btn.classList.remove("bg-emerald-600");
      }, 1200);
    });
  });

  catButtons.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const cat = (e.currentTarget as HTMLElement).getAttribute("data-cat") || "all";
      activePharmaCat = cat;
      currentPharmaPage = 1;

      catButtons.forEach((b) => {
        b.className = "pharma-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors";
      });
      (e.currentTarget as HTMLElement).className = "pharma-cat-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors";

      renderPharmaPagination();
    });
  });

  searchInput?.addEventListener("input", () => {
    activePharmaSearch = searchInput.value.trim().toLowerCase();
    currentPharmaPage = 1;
    renderPharmaPagination();
  });

  btnPrev?.addEventListener("click", () => {
    if (currentPharmaPage > 1) {
      currentPharmaPage--;
      renderPharmaPagination();
      document.getElementById("catalogo-botica")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  btnNext?.addEventListener("click", () => {
    const max = Math.ceil(getFilteredPharma().length / PHARMA_PER_PAGE);
    if (currentPharmaPage < max) {
      currentPharmaPage++;
      renderPharmaPagination();
      document.getElementById("catalogo-botica")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  // Formulario de Receta Médica
  const formReceta = document.getElementById("form-receta") as HTMLFormElement | null;
  formReceta?.addEventListener("submit", (e) => {
    e.preventDefault();
    const paciente = (document.getElementById("rec-paciente") as HTMLInputElement)?.value || "";
    const celular = (document.getElementById("rec-celular") as HTMLInputElement)?.value || "";
    const direccion = (document.getElementById("rec-direccion") as HTMLInputElement)?.value || "";
    const detalle = (document.getElementById("rec-detalle") as HTMLTextAreaElement)?.value || "";

    const mensaje = encodeURIComponent(
      `Hola Botica San Pedro, deseo cotizar y validar mi receta médica:\n\n` +
      `Paciente: ${paciente}\n` +
      `Celular: ${celular}\n` +
      `Dirección: ${direccion}\n` +
      `Detalle: ${detalle}\n\n` +
      `Solicito validación y envío express a domicilio.`
    );

    window.open(`https://wa.me/51940771896?text=${mensaje}`, "_blank");
  });

  // Checkout Carrito
  btnCheckout?.addEventListener("click", () => {
    if (pharmaCart.length === 0) return;

    let resumen = "Hola Botica San Pedro, deseo solicitar los siguientes medicamentos a domicilio:\n\n";
    let total = 0;
    pharmaCart.forEach((item) => {
      const sub = item.price * item.qty;
      total += sub;
      resumen += `• ${item.qty}x ${item.name} (S/ ${sub.toFixed(2)})\n`;
    });
    resumen += `\nTotal Estimado: S/ ${total.toFixed(2)}\nEnvío: Express a domicilio\nPor favor confirmar disponibilidad y método de pago (Yape/Plin/POS/Efectivo).`;

    window.open(`https://wa.me/51940771896?text=${encodeURIComponent(resumen)}`, "_blank");
  });

  // Inicialización
  renderPharmaCart();
  renderPharmaPagination();
</script>
