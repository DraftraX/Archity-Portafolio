<script>
  const INM_PER_PAGE = 6;
  let currentInmPage = 1;
  let activeInmOp = "all";
  let activeInmType = "all";
  let activeInmSearch = "";

  const inmCards = Array.from(document.querySelectorAll<HTMLElement>(".inm-card"));
  const inmOpButtons = document.querySelectorAll<HTMLButtonElement>(".inm-op-btn");
  const heroOpFilter = document.getElementById("hero-op-filter") as HTMLSelectElement | null;
  const heroTypeFilter = document.getElementById("hero-type-filter") as HTMLSelectElement | null;
  const heroSearchInput = document.getElementById("hero-search-input") as HTMLInputElement | null;
  const heroSearchBtn = document.getElementById("hero-search-btn");

  const noInmResults = document.getElementById("no-inm-results");
  const inmPaginationWrapper = document.getElementById("inm-pagination");
  const btnInmPrev = document.getElementById("inm-prev") as HTMLButtonElement | null;
  const btnInmNext = document.getElementById("inm-next") as HTMLButtonElement | null;
  const inmPagesContainer = document.getElementById("inm-pages");
  const countFrom = document.getElementById("inm-count-from");
  const countTo = document.getElementById("inm-count-to");
  const countTotal = document.getElementById("inm-count-total");

  function getFilteredInm() {
    return inmCards.filter((card) => {
      const op = card.getAttribute("data-op") || "";
      const type = card.getAttribute("data-type") || "";
      const dist = card.getAttribute("data-district") || "";
      const title = card.getAttribute("data-title") || "";

      const matchOp = activeInmOp === "all" || op === activeInmOp;
      const matchType = activeInmType === "all" || type === activeInmType;
      const matchSearch = !activeInmSearch || dist.includes(activeInmSearch) || title.includes(activeInmSearch);

      return matchOp && matchType && matchSearch;
    });
  }

  function renderInmPagination() {
    const filtered = getFilteredInm();
    const total = filtered.length;
    const maxPages = Math.ceil(total / INM_PER_PAGE) || 1;

    if (currentInmPage > maxPages) currentInmPage = maxPages;
    if (currentInmPage < 1) currentInmPage = 1;

    const startIdx = (currentInmPage - 1) * INM_PER_PAGE;
    const endIdx = startIdx + INM_PER_PAGE;

    inmCards.forEach((c) => c.classList.add("hidden"));
    filtered.slice(startIdx, endIdx).forEach((c) => c.classList.remove("hidden"));

    if (countFrom) countFrom.textContent = total === 0 ? "0" : (startIdx + 1).toString();
    if (countTo) countTo.textContent = Math.min(endIdx, total).toString();
    if (countTotal) countTotal.textContent = total.toString();

    if (total === 0) {
      noInmResults?.classList.remove("hidden");
      noInmResults?.classList.add("flex");
      inmPaginationWrapper?.classList.add("hidden");
    } else {
      noInmResults?.classList.add("hidden");
      noInmResults?.classList.remove("flex");
      inmPaginationWrapper?.classList.remove("hidden");
    }

    if (btnInmPrev) btnInmPrev.disabled = currentInmPage <= 1;
    if (btnInmNext) btnInmNext.disabled = currentInmPage >= maxPages;

    if (inmPagesContainer) {
      inmPagesContainer.innerHTML = "";
      for (let i = 1; i <= maxPages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = i.toString();
        b.className =
          i === currentInmPage
            ? "h-8 w-8 rounded-lg bg-emerald-600 text-xs font-bold text-white shadow-xs"
            : "h-8 w-8 rounded-lg border border-neutral-300 bg-white text-xs font-semibold text-neutral-700 hover:bg-neutral-100";
        b.addEventListener("click", () => {
          currentInmPage = i;
          renderInmPagination();
          document.getElementById("catalogo-propiedades")?.scrollIntoView({ behavior: "smooth" });
        });
        inmPagesContainer.appendChild(b);
      }
    }
  }

  // Eventos de filtros de operación
  inmOpButtons.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const op = (e.currentTarget as HTMLElement).getAttribute("data-op") || "all";
      activeInmOp = op;
      currentInmPage = 1;

      inmOpButtons.forEach((b) => {
        b.className = "inm-op-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors";
      });
      (e.currentTarget as HTMLElement).className = "inm-op-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors";

      renderInmPagination();
    });
  });

  // Filtros desde el Hero
  heroSearchBtn?.addEventListener("click", () => {
    if (heroOpFilter) activeInmOp = heroOpFilter.value;
    if (heroTypeFilter) activeInmType = heroTypeFilter.value;
    if (heroSearchInput) activeInmSearch = heroSearchInput.value.trim().toLowerCase();
    currentInmPage = 1;
    renderInmPagination();
  });

  btnInmPrev?.addEventListener("click", () => {
    if (currentInmPage > 1) {
      currentInmPage--;
      renderInmPagination();
      document.getElementById("catalogo-propiedades")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  btnInmNext?.addEventListener("click", () => {
    const max = Math.ceil(getFilteredInm().length / INM_PER_PAGE);
    if (currentInmPage < max) {
      currentInmPage++;
      renderInmPagination();
      document.getElementById("catalogo-propiedades")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  // Simulador de Crédito Hipotecario
  const rangePrice = document.getElementById("range-sim-price") as HTMLInputElement | null;
  const rangeDown = document.getElementById("range-sim-down") as HTMLInputElement | null;
  const rangeYears = document.getElementById("range-sim-years") as HTMLInputElement | null;
  const rangeRate = document.getElementById("range-sim-rate") as HTMLInputElement | null;

  const lblPrice = document.getElementById("label-sim-price");
  const lblDown = document.getElementById("label-sim-down");
  const lblYears = document.getElementById("label-sim-years");
  const lblRate = document.getElementById("label-sim-rate");

  const calcMonthlyUSD = document.getElementById("calc-monthly-usd");
  const calcMonthlyPEN = document.getElementById("calc-monthly-pen");
  const calcLoanAmount = document.getElementById("calc-loan-amount");
  const calcDownAmount = document.getElementById("calc-down-amount");

  function recalculateMortgage() {
    if (!rangePrice || !rangeDown || !rangeYears || !rangeRate) return;

    const price = parseFloat(rangePrice.value);
    const downPct = parseFloat(rangeDown.value);
    const years = parseFloat(rangeYears.value);
    const rateAnnual = parseFloat(rangeRate.value);

    const downAmount = price * (downPct / 100);
    const loanAmount = price - downAmount;

    // Tasa mensual efectiva
    const monthlyRate = Math.pow(1 + rateAnnual / 100, 1 / 12) - 1;
    const nMonths = years * 12;

    // Cuota fija francesa
    const monthlyPayment = loanAmount * (monthlyRate / (1 - Math.pow(1 + monthlyRate, -nMonths)));
    const paymentPEN = monthlyPayment * 3.75;

    if (lblPrice) lblPrice.textContent = `US$ ${price.toLocaleString("en-US")}`;
    if (lblDown) lblDown.textContent = `${downPct}% (US$ ${downAmount.toLocaleString("en-US")})`;
    if (lblYears) lblYears.textContent = `${years} Años (${nMonths} cuotas)`;
    if (lblRate) lblRate.textContent = `${rateAnnual.toFixed(1)}% Anual`;

    if (calcMonthlyUSD) calcMonthlyUSD.textContent = `US$ ${Math.round(monthlyPayment).toLocaleString("en-US")}`;
    if (calcMonthlyPEN) calcMonthlyPEN.textContent = `Aprox. S/ ${Math.round(paymentPEN).toLocaleString("es-PE")} / mes (T.C. 3.75)`;
    if (calcLoanAmount) calcLoanAmount.textContent = `US$ ${Math.round(loanAmount).toLocaleString("en-US")}`;
    if (calcDownAmount) calcDownAmount.textContent = `US$ ${Math.round(downAmount).toLocaleString("en-US")}`;
  }

  [rangePrice, rangeDown, rangeYears, rangeRate].forEach((elem) => {
    elem?.addEventListener("input", recalculateMortgage);
  });

  // Botón Simular Cuota en cada tarjeta
  document.querySelectorAll(".btn-simular-prop").forEach((btn) => {
    btn.addEventListener("click", () => {
      const p = (btn as HTMLElement).getAttribute("data-price");
      if (p && rangePrice) {
        rangePrice.value = p;
        recalculateMortgage();
        document.getElementById("simulador-hipotecario")?.scrollIntoView({ behavior: "smooth" });
      }
    });
  });

  // Botón Seleccionar Inmueble para Visita
  const inputVisitaInm = document.getElementById("visita-inmueble") as HTMLInputElement | null;
  document.querySelectorAll(".btn-seleccionar-inm").forEach((btn) => {
    btn.addEventListener("click", () => {
      const title = (btn as HTMLElement).getAttribute("data-title");
      if (title && inputVisitaInm) {
        inputVisitaInm.value = title;
      }
    });
  });

  // Formulario de Visita Inmueble
  const formVisita = document.getElementById("form-visita-inm") as HTMLFormElement | null;
  formVisita?.addEventListener("submit", (e) => {
    e.preventDefault();
    const nombre = (document.getElementById("visita-nombre") as HTMLInputElement)?.value || "";
    const telefono = (document.getElementById("visita-telefono") as HTMLInputElement)?.value || "";
    const inmueble = inputVisitaInm?.value || "";
    const modalidad = (document.getElementById("visita-modalidad") as HTMLSelectElement)?.value || "";
    const turno = (document.getElementById("visita-turno") as HTMLSelectElement)?.value || "";
    const notas = (document.getElementById("visita-notas") as HTMLTextAreaElement)?.value || "";

    const mensaje = encodeURIComponent(
      `Hola Habitat Prime, deseo coordinar una visita a un inmueble:\n\n` +
      `Cliente: ${nombre}\n` +
      `Teléfono: ${telefono}\n` +
      `Inmueble: ${inmueble}\n` +
      `Modalidad: ${modalidad}\n` +
      `Turno preferido: ${turno}\n` +
      `Notas: ${notas}\n\n` +
      `Por favor confirmar disponibilidad del broker asignado.`
    );

    window.open(`https://wa.me/51940771896?text=${mensaje}`, "_blank");
  });

  // Inicialización
  renderInmPagination();
  recalculateMortgage();
</script>
