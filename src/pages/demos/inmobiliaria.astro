    operation: "Alquiler",
    district: "San Isidro, Lima",
    priceUSD: 2800,
    pricePEN: 10500,
    area: 140,
    bedrooms: 0,
    bathrooms: 2,
    parking: 3,
    badge: "Certificación LEED",
    rating: 4.9,
    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&q=80",
