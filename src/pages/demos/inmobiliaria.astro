---

<Layout
  title="HABITAT PRIME — Desarrollos Inmobiliarios & Inversiones | Demo Archity"
  description="Portal inmobiliario moderno con catálogo paginado, filtro dinámico por operación y tipo, simulador de crédito hipotecario y agenda de visitas."
>
  <!-- Barra superior permanente: Demo Mode Archity -->
  <div class="sticky top-0 z-50 flex items-center justify-between border-b border-neutral-800 bg-neutral-950 px-4 py-2 text-xs text-neutral-300">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
      <span class="font-medium">Demostración de Portal Inmobiliario &amp; Desarrollos</span>
      <span class="hidden sm:inline text-neutral-500">· Desarrollada por Archity</span>
    </div>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md bg-neutral-800 px-3 py-1 font-semibold text-white hover:bg-neutral-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al Portafolio
    </a>
  </div>

  <!-- Header Propio de Habitat Prime -->
  <header class="sticky top-8 z-40 border-b border-neutral-800 bg-neutral-900/95 backdrop-blur-md text-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Logotipo de la Inmobiliaria -->
      <a href="/demos/inmobiliaria" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 font-display font-extrabold text-white text-base shadow-sm">
          HP
        </span>
        <div>
          <span class="block font-display text-base font-bold tracking-tight text-white">HABITAT PRIME</span>
          <span class="block text-[10px] uppercase tracking-widest text-emerald-400 font-semibold">Desarrollos &amp; Inversiones Inmobiliarias</span>
        </div>
      </a>

      <!-- Navegación Inmobiliaria -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-300">
        <a href="#catalogo-propiedades" class="hover:text-emerald-400 transition-colors">Propiedades</a>
        <a href="#simulador-hipotecario" class="hover:text-emerald-400 transition-colors">Simulador Hipotecario</a>
        <a href="#agenda-visita" class="hover:text-emerald-400 transition-colors">Agendar Visita</a>
        <a href="#contacto-inm" class="hover:text-emerald-400 transition-colors">Brokers &amp; Sedes</a>
      </nav>

      <!-- Central de Ventas & Botón Visita -->
      <div class="flex items-center gap-3">
        <a
          href="tel:+51940771896"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs text-neutral-300 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          <span>(01) 490-3000</span>
        </a>

        <a
          href="#agenda-visita"
          class="flex items-center gap-2 rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white hover:bg-emerald-500 transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Agendar Visita
        </a>
      </div>

    </div>
  </header>

  <main>
    <!-- Hero Inmobiliario con Buscador Rápido -->
    <section class="border-b border-neutral-800 bg-neutral-900 py-16 sm:py-24 text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl text-left">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Asesoría Inmobiliaria Certificada · Perú</span>
          </div>

          <h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Encuentra tu Próximo Hogar o <span class="text-emerald-400">Inversión de Alta Plusvalía</span>
          </h1>

          <p class="mt-5 text-base leading-relaxed text-neutral-400 sm:text-lg">
            Departamentos de estreno en Lima Top, residencias campestres y lotes urbanizados con inscripción en Registros Públicos (SUNARP) y financiamiento con los principales bancos.
          </p>
        </div>

        <!-- Buscador / Filtro Rápido en Hero -->
        <div class="mt-10 rounded-2xl border border-neutral-800 bg-neutral-950/80 p-4 sm:p-6 shadow-2xl backdrop-blur-md">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <label class="block text-xs font-semibold text-neutral-400">Operación</label>
              <select
                id="hero-op-filter"
                class="mt-1.5 w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2.5 text-xs text-white focus:border-emerald-500 focus:outline-none"
              >
                <option value="all">Todas las operaciones</option>
                <option value="Venta">Venta</option>
                <option value="Alquiler">Alquiler</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-400">Tipo de Inmueble</label>
              <select
                id="hero-type-filter"
                class="mt-1.5 w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2.5 text-xs text-white focus:border-emerald-500 focus:outline-none"
              >
                <option value="all">Todos los inmuebles</option>
                <option value="Departamento">Departamentos</option>
                <option value="Casas">Casas &amp; Villas</option>
                <option value="Terrenos">Terrenos &amp; Lotes</option>
                <option value="Oficinas">Oficinas Corporativas</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-400">Ubicación / Distrito</label>
              <input
                type="text"
                id="hero-search-input"
                placeholder="Ej. Miraflores, San Isidro..."
                class="mt-1.5 w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2.5 text-xs text-white placeholder:text-neutral-500 focus:border-emerald-500 focus:outline-none"
              />
            </div>

            <div class="flex items-end">
              <a
                href="#catalogo-propiedades"
                id="hero-search-btn"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 py-2.5 text-xs font-bold text-white transition-all hover:bg-emerald-500 active:scale-95 shadow-xs"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Buscar Inmuebles
              </a>
            </div>
          </div>
        </div>

        <!-- Badges de métricas -->
        <div class="mt-8 grid grid-cols-2 gap-4 border-t border-neutral-800 pt-6 sm:grid-cols-4">
          <div>
            <span class="block font-display text-2xl font-bold text-white">+180 M USD</span>
            <span class="text-xs text-neutral-400">Inmuebles Transaccionados</span>
          </div>
          <div>
            <span class="block font-display text-2xl font-bold text-emerald-400">100%</span>
            <span class="text-xs text-neutral-400">Títulos Registrados SUNARP</span>
          </div>
          <div>
            <span class="block font-display text-2xl font-bold text-white">0% Alcabala</span>
            <span class="text-xs text-neutral-400">En Inmuebles de Primer Uso</span>
          </div>
          <div>
            <span class="block font-display text-2xl font-bold text-emerald-400">5 Bancos</span>
            <span class="text-xs text-neutral-400">Convenios de Crédito Hipotecario</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo de Propiedades con Paginación Interactiva -->
    <section id="catalogo-propiedades" class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Portafolio Inmobiliario</span>
            <h2 class="mt-1 font-display text-2xl font-bold text-neutral-900 sm:text-3xl">
              Inmuebles Disponibles
            </h2>
            <p class="mt-1 text-xs text-neutral-500">
              Paginación en front-end (6 inmuebles por página). Filtros inmediatos por operación y tipología.
            </p>
          </div>

          <!-- Filtros de Operación Venta / Alquiler -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="inm-op-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors"
              data-op="all"
            >
              Todos ({properties.length})
            </button>
            <button
              type="button"
              class="inm-op-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
              data-op="Venta"
            >
              Venta
            </button>
            <button
              type="button"
              class="inm-op-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors"
              data-op="Alquiler"
            >
              Alquiler
            </button>
          </div>
        </div>

        <!-- Grid de Inmuebles -->
        <div id="inm-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {properties.map((p) => (
            <div
              class="inm-card flex flex-col justify-between overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-xs transition-all hover:border-emerald-300 hover:shadow-lg"
              data-op={p.operation}
              data-type={p.type}
              data-district={p.district.toLowerCase()}
              data-title={p.title.toLowerCase()}
              data-price={p.priceUSD}
            >
              <div>
                <!-- Imagen HD del Inmueble -->
                <div class="relative h-56 w-full overflow-hidden bg-neutral-100">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                    <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold text-white shadow-xs ${p.operation === 'Venta' ? 'bg-emerald-600' : 'bg-sky-600'}`}>
                      {p.operation}
                    </span>
                    <span class="rounded-md bg-neutral-900/80 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur-xs">
                      {p.type}
                    </span>
                  </div>
                  <div class="absolute top-3 right-3">
                    <span class="rounded-md bg-white/90 px-2 py-0.5 text-[10px] font-bold text-neutral-800 backdrop-blur-xs shadow-xs">
                      {p.badge}
                    </span>
                  </div>
                  <div class="absolute bottom-3 left-3 flex items-center gap-1 rounded-md bg-neutral-950/70 px-2 py-1 text-xs text-white backdrop-blur-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                    </svg>
                    <span>{p.district}</span>
                  </div>
                </div>

                <div class="p-5">
                  <div class="flex items-baseline justify-between">
                    <div class="font-display text-2xl font-bold text-neutral-900">
                      US$ {p.priceUSD.toLocaleString("en-US")}
                    </div>
                    <div class="text-xs text-neutral-500">
                      S/ {p.pricePEN.toLocaleString("es-PE")}
                    </div>
                  </div>

                  <h3 class="mt-2 font-display text-base font-bold text-neutral-900 line-clamp-2">
                    {p.title}
                  </h3>

                  <p class="mt-2 text-xs text-neutral-600 line-clamp-2">
                    {p.description}
                  </p>

                  <!-- Iconos técnicos (SVG, sin emojis) -->
                  <div class="mt-4 flex items-center justify-between border-t border-neutral-100 pt-3 text-xs text-neutral-600">
                    <div class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                      </svg>
                      <span>{p.area} m²</span>
                    </div>

                    {p.bedrooms > 0 && (
                      <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span>{p.bedrooms} Dorm.</span>
                      </div>
                    )}

                    {p.bathrooms > 0 && (
                      <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>{p.bathrooms} Baños</span>
                      </div>
                    )}

                    {p.parking > 0 && (
                      <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                        <span>{p.parking} Coch.</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              <div class="border-t border-neutral-100 p-5 pt-3">
                <div class="grid grid-cols-2 gap-2">
                  <a
                    href="#agenda-visita"
                    class="btn-seleccionar-inm flex items-center justify-center gap-1.5 rounded-xl bg-neutral-900 py-2.5 text-xs font-bold text-white hover:bg-emerald-600 transition-colors"
                    data-title={p.title}
                    data-id={p.id}
                  >
                    Agendar Visita
                  </a>

                  <button
                    type="button"
                    class="btn-simular-prop flex items-center justify-center gap-1.5 rounded-xl border border-neutral-300 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 transition-colors"
                    data-price={p.priceUSD}
                  >
                    Simular Cuota
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Mensaje cuando no hay resultados -->
        <div id="no-inm-results" class="hidden flex-col items-center justify-center py-16 text-center">
          <p class="font-display text-base font-bold text-neutral-800">No encontramos inmuebles con esos filtros</p>
