  const countTo = document.getElementById("vet-count-to");
  const countTotal = document.getElementById("vet-count-total");

  // Carrito elements
  const vetCartContainer = document.getElementById("vet-cart-container");
  const vetTotalsSection = document.getElementById("vet-totals-section");
  const vetCartBadge = document.getElementById("vet-cart-badge");
  const headerVetCount = document.getElementById("header-vet-count");
  const vetSubtotal = document.getElementById("vet-subtotal");
  const vetTotal = document.getElementById("vet-total");
  const btnCheckoutVet = document.getElementById("btn-checkout-vet");

  function getFilteredVet() {
    return vetCards.filter((card) => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";

      const matchCat = activeVetCat === "all" || cat === activeVetCat;
      const matchSearch = !activeVetSearch || name.includes(activeVetSearch);

      return matchCat && matchSearch;
    });
  }

  function renderVetPagination() {
    const filtered = getFilteredVet();
    const total = filtered.length;
    const maxPages = Math.ceil(total / VET_PER_PAGE) || 1;

    if (currentVetPage > maxPages) currentVetPage = maxPages;
    if (currentVetPage < 1) currentVetPage = 1;

    const startIdx = (currentVetPage - 1) * VET_PER_PAGE;
    const endIdx = startIdx + VET_PER_PAGE;

    vetCards.forEach((c) => c.classList.add("hidden"));
    filtered.slice(startIdx, endIdx).forEach((c) => c.classList.remove("hidden"));

    if (countFrom) countFrom.textContent = total === 0 ? "0" : (startIdx + 1).toString();
    if (countTo) countTo.textContent = Math.min(endIdx, total).toString();
    if (countTotal) countTotal.textContent = total.toString();

    if (total === 0) {
      noVetResults?.classList.remove("hidden");
      noVetResults?.classList.add("flex");
      vetPaginationWrapper?.classList.add("hidden");
    } else {
      noVetResults?.classList.add("hidden");
      noVetResults?.classList.remove("flex");
      vetPaginationWrapper?.classList.remove("hidden");
    }

    if (btnVetPrev) btnVetPrev.disabled = currentVetPage <= 1;
    if (btnVetNext) btnVetNext.disabled = currentVetPage >= maxPages;

    if (vetPagesContainer) {
      vetPagesContainer.innerHTML = "";
      for (let i = 1; i <= maxPages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = i.toString();
        b.className =
          i === currentVetPage
            ? "h-8 w-8 rounded-lg bg-sky-600 text-xs font-bold text-white shadow-xs"
            : "h-8 w-8 rounded-lg border border-neutral-300 bg-white text-xs font-semibold text-neutral-700 hover:bg-neutral-100";
        b.addEventListener("click", () => {
          currentVetPage = i;
          renderVetPagination();
          document.getElementById("pet-shop")?.scrollIntoView({ behavior: "smooth" });
        });
        vetPagesContainer.appendChild(b);
      }
    }
  }

  function renderVetCart() {
    const totalQty = vetCart.reduce((sum, i) => sum + i.qty, 0);
    const totalPrice = vetCart.reduce((sum, i) => sum + i.price * i.qty, 0);

    if (headerVetCount) headerVetCount.textContent = totalQty.toString();
    if (vetCartBadge) vetCartBadge.textContent = `${totalQty} producto${totalQty === 1 ? "" : "s"}`;

    if (vetCart.length === 0) {
      if (vetCartContainer) {
        vetCartContainer.innerHTML = `
          <p class="py-8 text-center text-xs text-neutral-500">
            Tu carrito está vacío. Agrega alimentos, antipulgas o accesorios desde la tienda superior.
          </p>
        `;
      }
      vetTotalsSection?.classList.add("hidden");
      return;
    }

    vetTotalsSection?.classList.remove("hidden");
    if (vetSubtotal) vetSubtotal.textContent = `S/ ${totalPrice.toFixed(2)}`;
    if (vetTotal) vetTotal.textContent = `S/ ${totalPrice.toFixed(2)}`;

    if (vetCartContainer) {
      vetCartContainer.innerHTML = "";
      vetCart.forEach((item) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between py-3 text-xs";
        row.innerHTML = `
          <div class="flex-1 pr-3">
            <h4 class="font-bold text-neutral-900">${item.name}</h4>
            <span class="text-neutral-500">S/ ${item.price.toFixed(2)} c/u</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex items-center rounded-lg border border-neutral-200">
              <button type="button" class="btn-qty-minus-v px-2 py-1 text-neutral-600 hover:bg-neutral-100" data-id="${item.id}">-</button>
              <span class="px-2 font-bold text-neutral-900">${item.qty}</span>
              <button type="button" class="btn-qty-plus-v px-2 py-1 text-neutral-600 hover:bg-neutral-100" data-id="${item.id}">+</button>
            </div>
            <span class="w-16 text-right font-bold text-neutral-900">S/ ${(item.price * item.qty).toFixed(2)}</span>
            <button type="button" class="btn-del-v text-neutral-400 hover:text-red-500" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `;
        vetCartContainer.appendChild(row);
      });

      vetCartContainer.querySelectorAll(".btn-qty-plus-v").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          const found = vetCart.find((p) => p.id === id);
          if (found) {
            found.qty++;
            renderVetCart();
          }
        });
      });

      vetCartContainer.querySelectorAll(".btn-qty-minus-v").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          const found = vetCart.find((p) => p.id === id);
          if (found) {
            found.qty--;
            if (found.qty <= 0) {
              vetCart = vetCart.filter((p) => p.id !== id);
            }
            renderVetCart();
          }
        });
      });

      vetCartContainer.querySelectorAll(".btn-del-v").forEach((b) => {
        b.addEventListener("click", () => {
          const id = (b as HTMLElement).getAttribute("data-id");
          vetCart = vetCart.filter((p) => p.id !== id);
          renderVetCart();
        });
      });
    }
  }

  // Agregar al carrito
  document.querySelectorAll(".btn-add-vet").forEach((b) => {
    b.addEventListener("click", () => {
      const btn = b as HTMLElement;
      const id = btn.getAttribute("data-id") || "";
      const name = btn.getAttribute("data-name") || "";
      const price = parseFloat(btn.getAttribute("data-price") || "0");

      const exists = vetCart.find((item) => item.id === id);
      if (exists) {
        exists.qty++;
      } else {
        vetCart.push({ id, name, price, qty: 1 });
      }

      renderVetCart();

      const orig = btn.innerHTML;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Agregado`;
      btn.classList.add("bg-sky-600");
      setTimeout(() => {
        btn.innerHTML = orig;
        btn.classList.remove("bg-sky-600");
      }, 1200);
    });
  });

  vetCatButtons.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const cat = (e.currentTarget as HTMLElement).getAttribute("data-cat") || "all";
      activeVetCat = cat;
      currentVetPage = 1;

      vetCatButtons.forEach((b) => {
        b.className = "vet-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 transition-colors";
      });
      (e.currentTarget as HTMLElement).className = "vet-cat-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors";

      renderVetPagination();
    });
  });

  vetSearchInput?.addEventListener("input", () => {
    activeVetSearch = vetSearchInput.value.trim().toLowerCase();
    currentVetPage = 1;
    renderVetPagination();
  });

  btnVetPrev?.addEventListener("click", () => {
    if (currentVetPage > 1) {
      currentVetPage--;
      renderVetPagination();
      document.getElementById("pet-shop")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  btnVetNext?.addEventListener("click", () => {
    const max = Math.ceil(getFilteredVet().length / VET_PER_PAGE);
    if (currentVetPage < max) {
      currentVetPage++;
      renderVetPagination();
      document.getElementById("pet-shop")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  // Formulario de Cita Veterinaria
  const formCita = document.getElementById("form-cita-vet") as HTMLFormElement | null;
  formCita?.addEventListener("submit", (e) => {
    e.preventDefault();
    const tutor = (document.getElementById("cita-tutor") as HTMLInputElement)?.value || "";
    const celular = (document.getElementById("cita-telefono") as HTMLInputElement)?.value || "";
    const mascota = (document.getElementById("cita-mascota") as HTMLInputElement)?.value || "";
    const especie = (document.getElementById("cita-especie") as HTMLSelectElement)?.value || "";
    const servicio = (document.getElementById("cita-servicio") as HTMLSelectElement)?.value || "";
    const sede = (document.getElementById("cita-sede") as HTMLSelectElement)?.value || "";
    const motivo = (document.getElementById("cita-motivo") as HTMLTextAreaElement)?.value || "";

    const mensaje = encodeURIComponent(
      `Hola VetCare Hospital, deseo agendar una cita médica:\n\n` +
      `Tutor: ${tutor}\n` +
      `Teléfono: ${celular}\n` +
      `Mascota: ${mascota} (${especie})\n` +
      `Servicio: ${servicio}\n` +
      `Sede: ${sede}\n` +
      `Motivo: ${motivo}\n\n` +
      `Por favor confirmar disponibilidad de horario.`
    );

    window.open(`https://wa.me/51940771896?text=${mensaje}`, "_blank");
  });

  // Checkout Pet Shop
  btnCheckoutVet?.addEventListener("click", () => {
    if (vetCart.length === 0) return;

    let resumen = "Hola VetCare Hospital, deseo hacer un pedido de Pet Shop a domicilio:\n\n";
    let total = 0;
    vetCart.forEach((item) => {
      const sub = item.price * item.qty;
      total += sub;
      resumen += `• ${item.qty}x ${item.name} (S/ ${sub.toFixed(2)})\n`;
    });
    resumen += `\nTotal Estimado: S/ ${total.toFixed(2)}\nEnvío a Domicilio.\nPor favor confirmar costo de envío y método de pago (Yape/Plin/POS/Tarjeta).`;

    window.open(`https://wa.me/51940771896?text=${encodeURIComponent(resumen)}`, "_blank");
  });

  // Inicialización
  renderVetCart();
  renderVetPagination();
</script>
