---
import Layout from "../../layouts/Layout.astro";
import ECCEnterpriseROI from "../../components/ecc/ECCEnterpriseROI.astro";

const sectors = [
  {
    id: "industrial",
    title: "Infraestructura & Minería",
    tagline: "Telemetría de balanzas, control de canteras y dosificación de concreto",
    stat: "780 TM/Día",
    statDesc: "Capacidad monitoreada en tiempo real",
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=600&q=80",
    modules: ["Balanza Electrónica", "Control de Mixer & Flota", "Mermas de Agregados", "Facturación Masiva"],
  },
  {
    id: "tributario",
    title: "SaaS Tributo & Fiscalización",
    tagline: "Liquidación automática de impuesto predial y cobranza municipal/inmobiliaria",
    stat: "100% Digital",
    statDesc: "Cuponeras y cartografía catastral en la nube",
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=600&q=80",
    modules: ["Cálculo UIT & Tramos", "Emisión de Cuponeras PDF", "Portal Contribuyente", "Prorrateo Arbitrios"],
  },
  {
    id: "logistica",
    title: "Logística & Despacho Pesado",
    tagline: "Trazabilidad de combustible, guías de remisión electrónicas y rutas pesadas",
    stat: "-35% Costos",
    statDesc: "Reducción de combustible no justificado",
    image: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=600&q=80",
    modules: ["Control de Cisternas", "Guías GRE SUNAT", "Mantenimiento Preventivo", "Checklist Operadores"],
  },
  {
    id: "retail",
    title: "Comercio Corporativo B2B",
    tagline: "Portales de compras mayoristas, integración Yape/Plin/Pasarelas y pedidos WhatsApp",
    stat: "24 / 7",
    statDesc: "Disponibilidad operativa sin caídas",
    image: "https://images.unsplash.com/photo-1556742049-0a67c5574f73?auto=format&fit=crop&w=600&q=80",
    modules: ["Catálogo Mayorista", "Líneas de Crédito B2B", "Inventario Multi-almacén", "API ERP Contable"],
  },
];

const plans = [
  {
    name: "Business Starter",
    subtitle: "Para medianas empresas digitalizando sus primeros flujos críticos",
    price: "S/ 3,500",
    period: "pago único de implementación",
    features: [
      "Diseño corporativo exclusivo a medida (sin plantillas lentas)",
      "Carga ultrarrápida (Astro + Tailwind CSS v4)",
      "Formularios inteligentes y alertas a WhatsApp",
      "Integración básica con pasarelas de pago o cotizador",
      "Soporte y despliegue cloud en producción",
    ],
    cta: "Cotizar Starter",
    popular: false,
  },
  {
    name: "Enterprise Consorcio",
    subtitle: "Arquitectura robusta para consorcios, plantas y empresas multisector",
    price: "S/ 8,500+",
    period: "según módulos y sedes operativas",
    features: [
      "Todo lo de Business Starter",
      "Integración con balanzas, sensores IoT o ERPs previos",
      "Arquitectura multiempresa (múltiples RUCs bajo un mismo hub)",
      "Generador de reportes ejecutivos y proformas PDF masivas",
      "Módulos para cuadrillas de campo y operarios móviles",
      "SLA garantizado de soporte y respaldo cloud continuo",
    ],
    cta: "Agendar Consultoría Técnica",
    popular: true,
  },
  {
    name: "SaaS Custom Platform",
    subtitle: "Desarrollo completo de plataformas como AltoPlanta desde cero",
    price: "A Medida",
    period: "sprint de desarrollo ágil",
    features: [
      "Plataforma web multi-inquilino (Multi-tenant SaaS)",
      "Modelos de suscripción recurrente y cobranza automática",
      "Motores de cálculo tributario / financiero complejos",
      "Propiedad total del 100% del código fuente",
      "Transferencia tecnológica y capacitación a tu equipo TI",
    ],
    cta: "Diseñar mi SaaS",
    popular: false,
  },
];
---

<Layout
  title="ORION ENTERPRISE SYSTEMS — Software Corporativo & Arquitectura Cloud | Demo Archity"
  description="Soluciones de software de alta gama para empresas y consorcios industriales: arquitectura B2B, calculadora de retorno de inversión (ROI) y agendamiento de demostraciones técnicas."
>
  <!-- Barra superior permanente: Demo Mode Archity -->
  <div class="sticky top-0 z-50 flex items-center justify-between border-b border-neutral-800 bg-neutral-950 px-4 py-2 text-xs text-neutral-300">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-accent"></span>
      <span class="font-medium">Demostración de Landing Corporativa B2B</span>
      <span class="hidden sm:inline text-neutral-500">· Desarrollada por Archity</span>
    </div>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md bg-neutral-800 px-3 py-1 font-semibold text-white hover:bg-neutral-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al Portafolio
    </a>
  </div>

  <!-- Header Propio de Orion Enterprise Systems -->
  <header class="sticky top-8 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur-md shadow-xs">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Logotipo Corporativo -->
      <a href="/demos/landing-empresa" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-neutral-900 text-white shadow-sm font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </span>
        <div>
          <span class="block font-display text-base font-bold tracking-tight text-neutral-900">ORION ENTERPRISE</span>
          <span class="block text-[10px] uppercase tracking-widest text-neutral-500 font-semibold">Sistemas Cloud &amp; ERP Industrial</span>
        </div>
      </a>

      <!-- Navegación B2B -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-600">
        <a href="#soluciones-sectores" class="hover:text-accent transition-colors">Soluciones por Sector</a>
        <a href="#calculadora-roi" class="hover:text-accent transition-colors">Calculadora ROI</a>
        <a href="#planes-enterprise" class="hover:text-accent transition-colors">Planes &amp; Precios</a>
        <a href="#agendar-demo" class="hover:text-accent transition-colors">Contacto Técnico</a>
      </nav>

      <!-- Teléfono & Botón Agendar Demo -->
      <div class="flex items-center gap-3">
        <a
          href="tel:+51940771896"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-neutral-700 hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>(01) 480-9900</span>
        </a>

        <a
          href="#agendar-demo"
          class="flex items-center gap-2 rounded-lg bg-accent px-3.5 py-2 text-xs font-bold text-white hover:bg-accent-dark transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Agendar Sesión
        </a>
      </div>

    </div>
  </header>

  <main>
    <!-- Hero B2B Corporativo -->
    <section class="relative overflow-hidden border-b border-neutral-200/80 bg-gradient-to-b from-neutral-50 via-white to-white py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-accent animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-accent">Arquitectura Enterprise &amp; Nube Privada</span>
            </div>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
              Software de Alta Precisión para <span class="text-accent">Empresas &amp; Consorcios</span>
            </h1>

            <p class="mt-5 text-base leading-relaxed text-neutral-600 sm:text-lg">
              Diseñamos portales corporativos, plataformas SaaS y ERPs industriales que transforman operaciones complejas en flujos eficientes, transparentes y auditables.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#calculadora-roi"
                class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-xs transition-all hover:bg-accent-dark hover:shadow-md hover:shadow-accent/25 active:scale-95"
              >
                Calcular Retorno de Inversión (ROI)
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <a
                href="#agendar-demo"
                class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-5 py-3.5 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-50"
              >
                Agendar Demostración Técnica
              </a>
            </div>

            <!-- Badges de credibilidad corporativa con números limpios -->
            <div class="mt-10 grid grid-cols-3 gap-6 border-t border-neutral-200/80 pt-6 text-left">
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">99.9%</span>
                <span class="text-xs text-neutral-500">Disponibilidad Cloud</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-accent">&lt; 1s</span>
                <span class="text-xs text-neutral-500">Tiempo de Carga Web</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">100%</span>
                <span class="text-xs text-neutral-500">Propiedad del Código</span>
              </div>
            </div>
          </div>

          <!-- Mockup Interactivo de Tablero Corporativo -->
          <div class="lg:col-span-5">
            <div class="overflow-hidden rounded-2xl border border-neutral-200/90 bg-white p-6 shadow-2xl">
              <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                </div>
                <span class="text-[11px] font-mono text-neutral-400">console.orion-enterprise.pe</span>
              </div>

              <div class="mt-4 space-y-4">
                <div class="rounded-xl bg-neutral-50 p-4 border border-neutral-100">
                  <span class="text-[10px] uppercase font-bold text-neutral-400">Sistemas Activos Vinculados</span>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-center justify-between text-xs">
                      <a href="https://altoplanta.com/" target="_blank" rel="noopener" class="font-bold text-neutral-900 hover:text-accent">
                        AltoPlanta SaaS (Tributo Inmobiliario)
                      </a>
                      <span class="text-emerald-600 font-semibold">Producción</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                      <a href="https://grupopineda.pe/" target="_blank" rel="noopener" class="font-bold text-neutral-900 hover:text-accent">
                        Grupo Pineda ERP (Consorcio Minero)
                      </a>
                      <span class="text-emerald-600 font-semibold">Producción</span>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div class="rounded-xl border border-neutral-100 p-3 bg-white">
                    <span class="text-[10px] text-neutral-400">Transacciones Hoy</span>
                    <div class="mt-1 font-display text-lg font-bold text-neutral-900">4,812 ops</div>
                  </div>
                  <div class="rounded-xl border border-neutral-100 p-3 bg-white">
                    <span class="text-[10px] text-neutral-400">Latencia API</span>
                    <div class="mt-1 font-display text-lg font-bold text-emerald-600">38 ms</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Soluciones por Sector -->
    <section id="soluciones-sectores" class="border-b border-neutral-200/80 bg-neutral-50 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Verticales de Especialización</span>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
            Arquitectura diseñada para sectores de alta exigencia operativa
          </h2>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {sectors.map((s) => (
            <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-neutral-200/80 bg-white shadow-xs transition duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl">
              <!-- Foto Real del Sector -->
              <div class="h-36 w-full overflow-hidden bg-neutral-100">
                <img
                  src={s.image}
                  alt={s.title}
                  class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
              </div>

              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-display text-lg font-bold text-accent">{s.stat}</span>
                    <span class="text-[10px] font-semibold text-neutral-400">Vertical B2B</span>
                  </div>

                  <h3 class="mt-2 font-display text-base font-bold text-neutral-900">{s.title}</h3>
                  <p class="mt-1.5 text-xs text-neutral-600 leading-relaxed">{s.tagline}</p>
                </div>

                <div class="mt-4 border-t border-neutral-100 pt-3">
                  <div class="flex flex-wrap gap-1">
                    {s.modules.map((m) => (
                      <span class="rounded bg-neutral-100 px-2 py-0.5 text-[10px] font-medium text-neutral-600">
                        {m}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Componente ECC: Calculadora de Retorno de Inversión (ROI) -->
    <section id="calculadora-roi" class="scroll-mt-20 border-b border-neutral-200/80 py-16 sm:py-24 bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <ECCEnterpriseROI />
      </div>
    </section>

    <!-- Planes y Modelos de Implementación -->
    <section id="planes-enterprise" class="scroll-mt-20 border-b border-neutral-200/80 bg-neutral-50 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto">
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Propuesta Comercial Clara</span>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
            Planes de Implementación para Empresas
          </h2>
          <p class="mt-3 text-sm text-neutral-600">
            Trabajamos por hitos entregables con total transparencia en presupuesto, cronogramas y propiedad intelectual.
          </p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-3 items-stretch">
          {plans.map((p) => (
            <div class={`relative flex flex-col justify-between rounded-2xl border p-8 bg-white transition duration-300 ${p.popular ? "border-accent shadow-xl shadow-accent/10 ring-2 ring-accent/20" : "border-neutral-200/90 shadow-sm"}`}>
              {p.popular && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-xs">
                  Recomendado para Empresas
                </span>
              )}

              <div>
                <h3 class="font-display text-xl font-bold text-neutral-900">{p.name}</h3>
                <p class="mt-2 text-xs text-neutral-600 min-h-[32px]">{p.subtitle}</p>

                <div class="mt-6 border-t border-b border-neutral-100 py-4">
                  <div class="font-display text-3xl font-bold text-neutral-900">{p.price}</div>
                  <span class="text-xs text-neutral-500">{p.period}</span>
                </div>

                <ul class="mt-6 space-y-2.5 text-xs text-neutral-700">
                  {p.features.map((f) => (
                    <li class="flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 pt-4">
                <a
                  href="#agendar-demo"
                  class={`flex w-full items-center justify-center rounded-lg py-3 text-center text-xs font-bold transition-colors ${p.popular ? "bg-accent text-white hover:bg-accent-dark shadow-xs" : "border border-neutral-300 bg-white text-neutral-800 hover:bg-neutral-50"}`}
                >
                  {p.cta}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Agendamiento Interactivo de Demostración Técnica B2B -->
    <section id="agendar-demo" class="scroll-mt-20 border-b border-neutral-200/80 bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-neutral-200 bg-neutral-900 p-8 sm:p-12 text-white shadow-2xl">
          <div class="max-w-2xl">
            <span class="text-xs font-bold uppercase tracking-widest text-accent">Demostración Técnica Personalizada</span>
            <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Agenda una sesión con nuestro equipo de ingeniería
            </h2>
            <p class="mt-3 text-sm text-neutral-300 leading-relaxed">
              Analizaremos tus procesos actuales, balanzas, sistemas contables o plataformas inmobiliarias para diseñar una propuesta con arquitectura definida y cronograma exacto.
            </p>
          </div>

          <form id="demo-schedule-form" class="mt-8 grid gap-4 sm:grid-cols-2 text-xs">
            <div>
              <label class="block font-bold text-neutral-300">Nombre &amp; Apellidos</label>
              <input type="text" id="b2b-nombre" required placeholder="Ej. Ing. Carlos Mendoza" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3.5 py-2.5 text-xs text-white placeholder:text-neutral-500 focus:border-accent focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Empresa o Consorcio</label>
              <input type="text" id="b2b-empresa" required placeholder="Ej. Constructora del Norte SAC" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3.5 py-2.5 text-xs text-white placeholder:text-neutral-500 focus:border-accent focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Teléfono / WhatsApp Corporativo</label>
              <input type="tel" id="b2b-telefono" required placeholder="+51 940 771 896" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3.5 py-2.5 text-xs text-white placeholder:text-neutral-500 focus:border-accent focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Solución de Interés</label>
              <select id="b2b-solucion" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-2.5 text-xs text-white focus:border-accent focus:outline-none">
                <option>ERP de Consorcio Empresarial (Estilo Grupo Pineda)</option>
                <option>SaaS de Tributo Inmobiliario (Estilo AltoPlanta)</option>
                <option>Plataforma E-Commerce B2B / B2C</option>
                <option>Landing Page Corporativa de Alta Conversión</option>
                <option>Automatización de Balanza &amp; Canteras</option>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-neutral-300">Detalles o requerimientos específicos</label>
              <textarea id="b2b-detalles" rows="3" placeholder="Describe brevemente tus operaciones actuales o metas de digitalización..." class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-3 text-xs text-white placeholder:text-neutral-500 focus:border-accent focus:outline-none"></textarea>
            </div>

            <div class="sm:col-span-2 pt-2">
              <button
                type="submit"
                class="w-full rounded-lg bg-accent py-3.5 font-semibold text-white hover:bg-accent-dark transition-all shadow-md hover:shadow-accent/25 active:scale-98"
              >
                Confirmar Solicitud de Demostración por WhatsApp
              </button>
            </div>
          </form>

          <div id="demo-success-msg" class="hidden mt-6 rounded-xl bg-emerald-950/60 border border-emerald-500/40 p-4 text-emerald-300 text-xs">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
