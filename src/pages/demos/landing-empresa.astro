<script>
  const form = document.getElementById("demo-schedule-form") as HTMLFormElement | null;
  const successMsg = document.getElementById("demo-success-msg");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const nombre = (document.getElementById("b2b-nombre") as HTMLInputElement)?.value || "";
    const empresa = (document.getElementById("b2b-empresa") as HTMLInputElement)?.value || "";
    const telefono = (document.getElementById("b2b-telefono") as HTMLInputElement)?.value || "";
    const solucion = (document.getElementById("b2b-solucion") as HTMLSelectElement)?.value || "";
    const detalles = (document.getElementById("b2b-detalles") as HTMLTextAreaElement)?.value || "";

    const mensaje = encodeURIComponent(
      `Hola Orion Enterprise Systems, solicito agendar una demostración técnica:\n\n` +
      `Nombre: ${nombre}\n` +
      `Empresa: ${empresa}\n` +
      `Teléfono: ${telefono}\n` +
      `Solución de Interés: ${solucion}\n` +
      `Detalles: ${detalles}\n\n` +
      `Por favor coordinar horario para la reunión técnica vía Google Meet.`
    );

    window.open(`https://wa.me/51940771896?text=${mensaje}`, "_blank");
    successMsg?.classList.remove("hidden");
    form?.reset();
  });
</script>
