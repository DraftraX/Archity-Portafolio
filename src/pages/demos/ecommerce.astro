---

<Layout
  title="NEXUS TECH STORE — Hardware Industrial & Soluciones SaaS | Demo Archity"
  description="Catálogo e-commerce interactivo con paginación funcional, filtros por categoría, drawer de carrito deslizable, cupones y checkout WhatsApp."
>
  <!-- Barra superior permanente: Demo Mode Archity -->
  <div class="sticky top-0 z-50 flex items-center justify-between border-b border-neutral-800 bg-neutral-950 px-4 py-2 text-xs text-neutral-300">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-accent"></span>
      <span class="font-medium">Demostración de Tienda Virtual E-Commerce</span>
      <span class="hidden sm:inline text-neutral-500">· Desarrollada por Archity</span>
    </div>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md bg-neutral-800 px-3 py-1 font-semibold text-white hover:bg-neutral-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al Portafolio
    </a>
  </div>

  <!-- Header Propio de Nexus Tech Store -->
  <header class="sticky top-8 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur-md shadow-xs">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Logotipo de la Tienda Tecnológica -->
      <a href="/demos/ecommerce" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-neutral-950 text-white shadow-sm font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </span>
        <div>
          <span class="block font-display text-base font-bold tracking-tight text-neutral-900">NEXUS TECH STORE</span>
          <span class="block text-[10px] uppercase tracking-widest text-neutral-500 font-semibold">Hardware Industrial &amp; Licencias Cloud</span>
        </div>
      </a>

      <!-- Navegación de la Tienda -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-600">
        <a href="#catalogo-store" class="hover:text-accent transition-colors">Catálogo de Equipos</a>
        <a href="#cupones-promo" class="hover:text-accent transition-colors">Cupones &amp; Descuentos</a>
        <a href="#garantia-soporte" class="hover:text-accent transition-colors">Garantía &amp; Envíos</a>
        <a href="#contacto-nexus" class="hover:text-accent transition-colors">Soporte Corporativo</a>
      </nav>

      <!-- Central Telefónica & Botón Carrito con Drawer -->
      <div class="flex items-center gap-3">
        <a
          href="tel:+51940771896"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-neutral-700 hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>(01) 480-5500</span>
        </a>

        <button
          type="button"
          class="ecc-open-cart flex items-center gap-2 rounded-lg bg-neutral-900 px-3.5 py-2 text-xs font-bold text-white hover:bg-neutral-800 transition-colors shadow-xs active:scale-95"
          aria-label="Abrir Carrito"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Carrito</span>
          <span class="ecc-cart-badge-count flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-extrabold text-white">
            0
          </span>
        </button>
      </div>

    </div>
  </header>

  <main>
    <!-- Hero E-Commerce -->
    <section class="border-b border-neutral-200/80 bg-neutral-900 py-14 sm:py-20 text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-accent animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-accent">Despacho Inmediato a Nivel Nacional · Perú</span>
            </div>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
              Hardware Industrial, Balanzas IoT y <span class="text-accent">Software Cloud</span>
            </h1>

            <p class="mt-4 text-base leading-relaxed text-neutral-300 sm:text-lg">
              Adquiere tecnología de pesaje, telemetría y licencias de software empresarial. Carrito interactivo, cupones de descuento y facturación con RUC 20.
            </p>

            <div id="cupones-promo" class="mt-6 flex flex-wrap items-center gap-2 text-xs">
              <span class="font-semibold text-neutral-400">Cupones activos:</span>
              <span class="rounded-md border border-neutral-700 bg-neutral-800/80 px-2.5 py-1 font-mono font-bold text-accent">ARCHITY10</span>
              <span class="text-neutral-500">(10% de descuento)</span>
              <span class="rounded-md border border-neutral-700 bg-neutral-800/80 px-2.5 py-1 font-mono font-bold text-emerald-400">EMPRESA20</span>
              <span class="text-neutral-500">(20% de descuento)</span>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#catalogo-store"
                class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3.5 text-sm font-bold text-white shadow-xs transition-all hover:bg-accent-dark active:scale-95"
              >
                Ver Catálogo Paginado
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <button
                type="button"
                class="ecc-open-cart inline-flex items-center justify-center gap-2 rounded-lg border border-neutral-700 bg-neutral-800/60 px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-800"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                Abrir Carrito Deslizable
              </button>
            </div>
          </div>

          <!-- Feature Box E-Commerce -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-neutral-800 bg-neutral-950/80 p-6 shadow-2xl backdrop-blur-md">
              <h3 class="font-display text-base font-bold text-white">Garantías de Compra Corporativa</h3>
              <ul class="mt-4 space-y-3 text-xs text-neutral-300">
                <li class="flex items-start gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <span><strong>Facturación Electrónica Automática:</strong> Emitimos Factura con RUC 20 para crédito fiscal inmediato.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <span><strong>Garantía de Hardware de 12 a 24 Meses:</strong> Reemplazo directo y soporte técnico de ingeniería.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <span><strong>Envío Asegurado a Nivel Nacional:</strong> Despachos diarios a Trujillo, Chiclayo, Arequipa, Cusco y San Martín.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Barra de Controles: Filtros de Categoría y Búsqueda -->
    <section class="sticky top-16 z-30 border-b border-neutral-200 bg-white/95 backdrop-blur-md py-4 shadow-xs">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          
          <!-- Filtro por categoría -->
          <div class="flex flex-wrap items-center gap-1.5" id="category-filter-bar">
            <button
              type="button"
              data-filter="all"
              class="filter-cat-btn rounded-lg bg-neutral-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors"
            >
              Todos ({products.length})
            </button>
            <button
              type="button"
              data-filter="Hardware"
              class="filter-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 transition-colors"
            >
              Hardware IoT
            </button>
            <button
              type="button"
              data-filter="Software"
              class="filter-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 transition-colors"
            >
              Software SaaS
            </button>
            <button
              type="button"
              data-filter="Industrial"
              class="filter-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 transition-colors"
            >
              Industrial &amp; Balanzas
            </button>
            <button
              type="button"
              data-filter="Accesorios"
              class="filter-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 transition-colors"
            >
              Accesorios
            </button>
            <button
              type="button"
              data-filter="Servicios"
              class="filter-cat-btn rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 transition-colors"
            >
              Consultoría
            </button>
          </div>

          <!-- Búsqueda en vivo -->
          <div class="flex items-center gap-3">
            <div class="relative flex-1 sm:w-64">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input
                type="text"
                id="search-products-input"
                placeholder="Buscar solución o equipo..."
                class="w-full rounded-xl border border-neutral-300 bg-white py-2 pl-9 pr-3 text-xs focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Grid de Productos con Paginación Interactiva -->
    <section id="catalogo-store" class="py-12 sm:py-16 bg-white min-h-[60vh]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <!-- Mensaje de conteo y paginación actual -->
        <div class="flex items-center justify-between text-xs text-neutral-500 mb-6">
