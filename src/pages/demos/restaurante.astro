---

<Layout
  title="Demo Restaurante & Brasas — Menú Interactivo con Paginación & Reservas | Archity"
  description="Demostración interactiva de landing page para restaurantes de alta cocina: menú digital con paginación funcional en front-end, reserva de mesas en tiempo real y pedidos a domicilio."
>
  <Header />

  <main>
    <!-- Banner de navegación de demos -->
    <div class="border-b border-accent/20 bg-accent-soft/60 px-4 py-2 text-center text-xs font-medium text-accent">
      <span class="font-bold">Demostración en Front-End:</span> Landing gastronómica para restaurantes con menú paginado y reservas de mesa.
      <a href="/demos/ecommerce" class="ml-2 font-bold underline hover:text-accent-dark">
        Ver Demo E-Commerce &rarr;
      </a>
    </div>

    <!-- Hero Gastronómico -->
    <section class="relative overflow-hidden bg-neutral-900 py-20 sm:py-28 text-white border-b border-neutral-800">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Cocina Criolla, Brasas &amp; Marina</span>
            </div>
            
            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
              Fuego, Tradición y Alta <span class="text-amber-400">Gastronomía Peruana</span>
            </h1>

            <p class="mt-6 text-base leading-relaxed text-neutral-300 sm:text-lg">
              Una experiencia culinaria auténtica: ingredientes de origen, leña de algarrobo y recetas de antaño con técnica contemporánea. Explora nuestro menú interactivo o reserva tu mesa en segundos.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#menu-digital"
                class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3.5 text-sm font-bold text-neutral-950 shadow-md transition-all hover:bg-amber-400 active:scale-95"
              >
                Explorar Menú Paginado
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <a
                href="#reserva-mesa"
                class="inline-flex items-center justify-center rounded-lg border border-neutral-700 bg-neutral-800/80 px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-800"
              >
                Reservar Mesa Online
              </a>
            </div>

            <!-- Datos rápidos del restaurante -->
            <div class="mt-10 grid grid-cols-3 gap-4 border-t border-neutral-800 pt-6 text-left">
              <div>
                <span class="block font-display text-2xl font-bold text-white">4.9 ★</span>
                <span class="text-xs text-neutral-400">+1,400 Reseñas Google</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-amber-400">45 min</span>
                <span class="text-xs text-neutral-400">Delivery Express</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-white">100%</span>
                <span class="text-xs text-neutral-400">Insumos Locales</span>
              </div>
            </div>
          </div>

          <!-- Comanda / Tarjeta de Pedido Rápido -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6 sm:p-8 shadow-2xl">
              <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400">Comanda en Vivo</span>
                  <h3 class="font-display text-lg font-bold text-white">Tu Pedido / Delivery</h3>
                </div>
                <span id="order-count" class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 text-xs font-bold text-neutral-950">
                  0
                </span>
              </div>

              <!-- Lista de platillos seleccionados -->
              <div id="order-items-list" class="mt-4 space-y-3 min-h-[140px] max-h-[220px] overflow-y-auto pr-1">
                <p id="order-empty" class="text-xs text-neutral-500 text-center py-10">
                  Selecciona platos del menú inferior para armar tu orden en tiempo real.
                </p>
              </div>

              <div class="mt-4 border-t border-neutral-800 pt-4 space-y-2 text-xs">
                <div class="flex justify-between text-neutral-400">
                  <span>Subtotal</span>
                  <span class="text-white font-medium">S/ <span id="order-subtotal">0.00</span></span>
                </div>
                <div class="flex justify-between text-neutral-400">
                  <span>Empaque &amp; Despacho</span>
                  <span class="text-white font-medium">S/ <span id="order-shipping">0.00</span></span>
                </div>
                <div class="flex justify-between text-sm font-bold text-white border-t border-neutral-800 pt-2">
                  <span>Total Estimado</span>
                  <span class="text-amber-400">S/ <span id="order-total">0.00</span></span>
                </div>
              </div>

              <button
                type="button"
                id="btn-whatsapp-restaurant"
                disabled
                class="mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 py-3 text-xs font-bold text-white hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z" />
                </svg>
                Enviar Comanda a WhatsApp
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Menú Digital Interactivo con Paginación Funcional -->
    <section id="menu-digital" class="scroll-mt-16 py-16 sm:py-24 bg-neutral-50/60 border-b border-neutral-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="max-w-xl">
            <span class="text-xs font-bold uppercase tracking-wider text-accent">Nuestra Carta Digital</span>
            <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
              Platos Preparados al Momento
            </h2>
            <p class="mt-2 text-sm text-neutral-600">
              Navega por categorías o usa el buscador para encontrar tus especialidades favoritas.
            </p>
          </div>

          <!-- Filtros de categoría -->
          <div class="flex flex-wrap items-center gap-1.5" id="menu-category-bar">
            <button type="button" data-cat="all" class="menu-cat-btn rounded-lg bg-neutral-900 px-3 py-1.5 text-xs font-semibold text-white transition-colors">
              Todos ({dishes.length})
            </button>
            <button type="button" data-cat="Entradas" class="menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors">
              Entradas
            </button>
            <button type="button" data-cat="Fondos" class="menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors">
              Fondos
            </button>
            <button type="button" data-cat="Brasas" class="menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors">
              Brasas &amp; Parrilla
            </button>
            <button type="button" data-cat="Postres" class="menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors">
              Postres
            </button>
            <button type="button" data-cat="Bebidas" class="menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors">
              Bebidas &amp; Pisco
            </button>
          </div>
        </div>

        <!-- Barra de búsqueda en vivo -->
        <div class="mt-8 flex items-center justify-between gap-4">
          <div class="relative w-full max-w-sm">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              id="search-menu-input"
              placeholder="Buscar por nombre o ingrediente..."
              class="w-full rounded-lg border border-neutral-300 bg-white py-2 pl-9 pr-3 text-xs focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
            />
          </div>

          <div class="text-xs text-neutral-500 font-medium">
            Mostrando <span id="menu-current-count">6</span> de <span id="menu-total-count">{dishes.length}</span> platos
          </div>
        </div>

        <!-- Grid de Platos (6 por página) -->
        <div id="dishes-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {dishes.map((d) => (
            <div
              class="dish-card group flex flex-col justify-between rounded-2xl border border-neutral-200/90 bg-white p-6 shadow-sm hover:shadow-md hover:border-neutral-300 transition-all duration-300"
              data-category={d.category}
              data-name={d.name.toLowerCase()}
              data-desc={d.description.toLowerCase()}
              data-id={d.id}
            >
              <div>
                <!-- Top Badge y Categoría -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent">{d.category}</span>
                  <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-[10px] font-bold text-amber-700 border border-amber-200">
                    {d.badge}
                  </span>
                </div>

                <!-- Iniciales y plato visual -->
                <div class="flex h-36 w-full items-center justify-center rounded-xl bg-gradient-to-br from-neutral-50 to-neutral-100 border border-neutral-100 text-3xl font-display font-bold text-neutral-800 shadow-2xs group-hover:text-accent transition-colors">
                  {d.name.substring(0, 2).toUpperCase()}
                </div>

                <h3 class="mt-4 font-display text-lg font-bold text-neutral-900 group-hover:text-accent transition-colors">
                  {d.name}
                </h3>
                <p class="mt-1.5 text-xs text-neutral-600 leading-relaxed line-clamp-2">
                  {d.description}
                </p>

                <div class="mt-4 flex items-center gap-3 text-[11px] text-neutral-500">
                  <span>⏱ {d.prepTime}</span>
                  <span>•</span>
                  <span>🌶️ {d.spicy}</span>
                  <span>•</span>
                  <span class="text-amber-600 font-semibold">★ {d.rating.toFixed(1)}</span>
                </div>
              </div>

              <!-- Precio y botón agregar -->
              <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-neutral-400 uppercase font-bold block">Porción</span>
                  <span class="font-display text-xl font-bold text-neutral-900">S/ {d.price.toFixed(2)}</span>
                </div>
                <button
                  type="button"
                  class="btn-add-dish inline-flex items-center gap-1.5 rounded-lg bg-neutral-900 px-3.5 py-2 text-xs font-bold text-white hover:bg-accent transition-colors active:scale-95"
                  data-id={d.id}
                  data-name={d.name}
                  data-price={d.price}
                >
                  <span>+ Agregar</span>
                </button>
              </div>
            </div>
          ))}
        </div>

        <!-- Sin resultados -->
        <div id="no-dishes-msg" class="hidden flex-col items-center justify-center py-16 text-center">
          <p class="font-display text-base font-bold text-neutral-900">No encontramos ningún plato que coincida</p>
          <p class="mt-1 text-xs text-neutral-500">Prueba con otra palabra o selecciona "Todos".</p>
        </div>

        <!-- Controles de Paginación Funcional (6 ítems por página) -->
        <div id="menu-pagination-wrapper" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-neutral-200 pt-6">
          <span class="text-xs text-neutral-500">
            Página <strong id="menu-page-num" class="text-neutral-900">1</strong> de <strong id="menu-max-pages" class="text-neutral-900">3</strong> (6 platos por página)
          </span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="menu-btn-prev"
              disabled
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              &larr; Anterior
            </button>
            <div id="menu-page-buttons" class="flex items-center gap-1"></div>
            <button
              type="button"
              id="menu-btn-next"
              class="rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Siguiente &rarr;
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Reserva de Mesa Interactiva (ECC Component) -->
    <section id="reserva-mesa" class="scroll-mt-16 py-16 sm:py-24 bg-white border-b border-neutral-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-neutral-200 bg-neutral-900 p-8 sm:p-12 text-white shadow-2xl">
          <div class="text-center max-w-xl mx-auto">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Reserva tu Mesa Online</span>
            <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Vive la Experiencia Gastronómica
            </h2>
            <p class="mt-2 text-xs text-neutral-300">
              Confirmación inmediata en pantalla. Sin esperas ni cargos adelantados.
            </p>
          </div>

          <form id="reservation-form" class="mt-8 grid gap-4 sm:grid-cols-2 text-xs">
            <div>
              <label class="block font-bold text-neutral-300">Nombre del Titular</label>
              <input type="text" required placeholder="Ej. Ana Lucía Morales" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Teléfono / WhatsApp</label>
              <input type="tel" required placeholder="+51 987 654 321" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Fecha de la Reserva</label>
              <input type="date" required class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Turno / Horario</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>Almuerzo: 1:00 PM</option>
                <option>Almuerzo: 2:30 PM</option>
                <option>Cena: 7:30 PM</option>
                <option>Cena: 9:00 PM</option>
              </select>
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Número de Comensales</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>2 Personas (Pareja)</option>
                <option>4 Personas (Mesa estándar)</option>
                <option>6 Personas (Familiar)</option>
                <option>8 a 12 Personas (Celebración / Ejecutivo)</option>
              </select>
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Ambiente Preferido</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>Salón Principal (Música ambiental)</option>
                <option>Terraza al Aire Libre</option>
                <option>Cava Privada (Reuniones)</option>
              </select>
            </div>

            <div class="sm:col-span-2 pt-3">
              <button
                type="submit"
                class="w-full rounded-lg bg-amber-500 py-3 font-bold text-neutral-950 hover:bg-amber-400 transition-colors shadow-md"
              >
                Confirmar Reserva de Mesa
              </button>
            </div>
          </form>

          <!-- Toast de Confirmación de Reserva -->
          <div id="reservation-success-box" class="hidden mt-6 rounded-xl bg-emerald-950/70 border border-emerald-500/50 p-4 text-emerald-300 text-xs">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <strong class="font-bold">¡Mesa reservada con éxito!</strong>
            </div>
            <p class="mt-1 text-neutral-300">
              Te esperamos en nuestro salón. Hemos guardado tu espacio para la fecha y horario seleccionados.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Comanda de delivery en vivo
  interface OrderItem {
    id: string;
    name: string;
    price: number;
    qty: number;
  }

  let order: OrderItem[] = [];

  const orderCountEl = document.getElementById("order-count");
  const orderListEl = document.getElementById("order-items-list");
  const orderEmptyEl = document.getElementById("order-empty");
  const orderSubtotalEl = document.getElementById("order-subtotal");
  const orderShippingEl = document.getElementById("order-shipping");
  const orderTotalEl = document.getElementById("order-total");
  const btnWhatsappRest = document.getElementById("btn-whatsapp-restaurant") as HTMLButtonElement | null;

  function renderOrder() {
    const totalQty = order.reduce((acc, i) => acc + i.qty, 0);
    if (orderCountEl) orderCountEl.textContent = totalQty.toString();

    if (order.length === 0) {
      if (orderEmptyEl) orderEmptyEl.classList.remove("hidden");
      if (orderSubtotalEl) orderSubtotalEl.textContent = "0.00";
      if (orderShippingEl) orderShippingEl.textContent = "0.00";
      if (orderTotalEl) orderTotalEl.textContent = "0.00";
      if (btnWhatsappRest) btnWhatsappRest.disabled = true;
      if (orderListEl) {
        orderListEl.innerHTML = '<p id="order-empty" class="text-xs text-neutral-500 text-center py-10">Selecciona platos del menú inferior para armar tu orden en tiempo real.</p>';
      }
      return;
    }

    if (btnWhatsappRest) btnWhatsappRest.disabled = false;

    const subtotal = order.reduce((acc, i) => acc + (i.price * i.qty), 0);
    const shipping = 8.00;
    const total = subtotal + shipping;

    if (orderSubtotalEl) orderSubtotalEl.textContent = subtotal.toFixed(2);
    if (orderShippingEl) orderShippingEl.textContent = shipping.toFixed(2);
    if (orderTotalEl) orderTotalEl.textContent = total.toFixed(2);

    if (orderListEl) {
      orderListEl.innerHTML = order.map(item => `
        <div class="flex items-center justify-between text-xs py-1.5 border-b border-neutral-800">
          <div class="min-w-0 flex-1 pr-2">
            <span class="block truncate font-bold text-white">${item.name}</span>
            <span class="text-neutral-500 text-[10px]">S/ ${item.price.toFixed(2)} c/u</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-amber-400">x${item.qty}</span>
            <span class="font-mono text-white">S/ ${(item.price * item.qty).toFixed(2)}</span>
            <button type="button" data-del-id="${item.id}" class="btn-del-dish text-neutral-500 hover:text-rose-400 ml-1">✕</button>
          </div>
        </div>
      `).join("");

      orderListEl.querySelectorAll(".btn-del-dish").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute("data-del-id");
          order = order.filter(i => i.id !== id);
          renderOrder();
        });
      });
    }
  }

  // Evento añadir plato
  document.querySelectorAll(".btn-add-dish").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const button = e.currentTarget as HTMLElement;
      const id = button.getAttribute("data-id") || "";
      const name = button.getAttribute("data-name") || "";
      const price = parseFloat(button.getAttribute("data-price") || "0");

      const existing = order.find(i => i.id === id);
      if (existing) {
        existing.qty++;
      } else {
        order.push({ id, name, price, qty: 1 });
      }
      renderOrder();

      const origText = button.innerHTML;
      button.innerHTML = "<span>✓ ¡Listo!</span>";
      setTimeout(() => { button.innerHTML = origText; }, 900);
    });
  });

  // Botón WhatsApp Comanda
  btnWhatsappRest?.addEventListener("click", () => {
    const total = orderTotalEl?.textContent || "0.00";
    const items = order.map(i => `• ${i.qty}x ${i.name} (S/ ${(i.price * i.qty).toFixed(2)})`).join("\n");
    const msg = encodeURIComponent(`Hola, deseo realizar el siguiente pedido a delivery de la Carta:\n\n${items}\n\nTotal con despacho: S/ ${total}\n\n¿Cuánto tiempo demora la entrega?`);
    window.open(`https://wa.me/51940771896?text=${msg}`, "_blank");
  });

  // Paginación Funcional de Menú
  const dishCards = Array.from(document.querySelectorAll("#dishes-grid > .dish-card")) as HTMLElement[];
  const searchInput = document.getElementById("search-menu-input") as HTMLInputElement | null;
  const catButtons = document.querySelectorAll(".menu-cat-btn");
  const countCurrentEl = document.getElementById("menu-current-count");
  const countTotalEl = document.getElementById("menu-total-count");
  const pageNumEl = document.getElementById("menu-page-num");
  const maxPagesEl = document.getElementById("menu-max-pages");
  const noDishesMsg = document.getElementById("no-dishes-msg");
  const paginationWrapper = document.getElementById("menu-pagination-wrapper");
  const pageButtonsContainer = document.getElementById("menu-page-buttons");
  const btnPrev = document.getElementById("menu-btn-prev") as HTMLButtonElement | null;
  const btnNext = document.getElementById("menu-btn-next") as HTMLButtonElement | null;

  const DISHES_PER_PAGE = 6;
  let currentMenuPage = 1;
  let activeMenuCat = "all";
  let activeMenuSearch = "";

  function getFilteredDishes(): HTMLElement[] {
    return dishCards.filter(card => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-desc") || "";

      const matchesCat = activeMenuCat === "all" || cat.toLowerCase() === activeMenuCat.toLowerCase();
      const matchesSearch = !activeMenuSearch || name.includes(activeMenuSearch) || desc.includes(activeMenuSearch);

      return matchesCat && matchesSearch;
    });
  }

  function renderMenuPagination() {
    const filtered = getFilteredDishes();
    const total = filtered.length;
    const maxPages = Math.ceil(total / DISHES_PER_PAGE) || 1;

    if (currentMenuPage > maxPages) currentMenuPage = maxPages;
    if (currentMenuPage < 1) currentMenuPage = 1;

    dishCards.forEach(c => c.classList.add("hidden"));

    const start = (currentMenuPage - 1) * DISHES_PER_PAGE;
    const pageItems = filtered.slice(start, start + DISHES_PER_PAGE);
    pageItems.forEach(c => c.classList.remove("hidden"));

    if (countCurrentEl) countCurrentEl.textContent = pageItems.length.toString();
    if (countTotalEl) countTotalEl.textContent = total.toString();
    if (pageNumEl) pageNumEl.textContent = currentMenuPage.toString();
    if (maxPagesEl) maxPagesEl.textContent = maxPages.toString();

    if (total === 0) {
      noDishesMsg?.classList.remove("hidden");
      noDishesMsg?.classList.add("flex");
      paginationWrapper?.classList.add("hidden");
    } else {
      noDishesMsg?.classList.add("hidden");
      noDishesMsg?.classList.remove("flex");
      paginationWrapper?.classList.remove("hidden");
    }

    if (btnPrev) btnPrev.disabled = currentMenuPage <= 1;
    if (btnNext) btnNext.disabled = currentMenuPage >= maxPages;

    if (pageButtonsContainer) {
      pageButtonsContainer.innerHTML = "";
      for (let i = 1; i <= maxPages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = i.toString();
        b.className = i === currentMenuPage
          ? "h-8 w-8 rounded-lg bg-neutral-900 text-xs font-bold text-white shadow-xs"
          : "h-8 w-8 rounded-lg border border-neutral-300 bg-white text-xs font-semibold text-neutral-700 hover:bg-neutral-100";
        b.addEventListener("click", () => {
          currentMenuPage = i;
          renderMenuPagination();
          document.getElementById("menu-digital")?.scrollIntoView({ behavior: "smooth" });
        });
        pageButtonsContainer.appendChild(b);
      }
    }
  }

  catButtons.forEach(btn => {
    btn.addEventListener("click", (e) => {
      const cat = (e.currentTarget as HTMLElement).getAttribute("data-cat") || "all";
      activeMenuCat = cat;
      currentMenuPage = 1;

      catButtons.forEach(b => {
        b.className = "menu-cat-btn rounded-lg bg-white border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 transition-colors";
      });
      (e.currentTarget as HTMLElement).className = "menu-cat-btn rounded-lg bg-neutral-900 px-3 py-1.5 text-xs font-semibold text-white transition-colors";

      renderMenuPagination();
    });
  });

  searchInput?.addEventListener("input", () => {
    activeMenuSearch = searchInput.value.trim().toLowerCase();
    currentMenuPage = 1;
    renderMenuPagination();
  });

  btnPrev?.addEventListener("click", () => {
    if (currentMenuPage > 1) {
      currentMenuPage--;
      renderMenuPagination();
      document.getElementById("menu-digital")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  btnNext?.addEventListener("click", () => {
    const max = Math.ceil(getFilteredDishes().length / DISHES_PER_PAGE);
    if (currentMenuPage < max) {
      currentMenuPage++;
      renderMenuPagination();
      document.getElementById("menu-digital")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  // Reserva de mesa form
  const resForm = document.getElementById("reservation-form") as HTMLFormElement | null;
  const resSuccessBox = document.getElementById("reservation-success-box");
  resForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    resSuccessBox?.classList.remove("hidden");
    resForm.reset();
  });

  // Inicializar
  renderOrder();
  renderMenuPagination();
</script>
