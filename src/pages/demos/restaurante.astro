---

<Layout
  title="FUEGO & BRASA — Restaurante & Asador Criollo Peruano | Demo Archity"
  description="Carta gastronómica digital con paginación funcional, reserva de mesas online y comanda de delivery a domicilio."
>
  <!-- Barra superior permanente: Demo Mode Archity -->
  <div class="sticky top-0 z-50 flex items-center justify-between border-b border-neutral-800 bg-neutral-950 px-4 py-2 text-xs text-neutral-300">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2 w-2 rounded-full bg-amber-400"></span>
      <span>Demostración de Restaurante en Vivo</span>
      <span class="hidden sm:inline text-neutral-500">· Desarrollada por Archity</span>
    </div>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 rounded-md bg-neutral-800 px-3 py-1 font-semibold text-white hover:bg-neutral-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Volver al Portafolio
    </a>
  </div>

  <!-- Header Propio del Restaurante -->
  <header class="sticky top-8 z-40 border-b border-neutral-800 bg-neutral-900/95 backdrop-blur-md text-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Logotipo del Restaurante -->
      <a href="/demos/restaurante" class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500 text-neutral-950 font-display font-extrabold text-lg shadow-sm">
          FB
        </span>
        <div>
          <span class="block font-display text-sm font-bold tracking-wider text-white">FUEGO &amp; BRASA</span>
          <span class="block text-[10px] uppercase tracking-widest text-amber-400">Asador &amp; Cocina Peruana</span>
        </div>
      </a>

      <!-- Navegación del Restaurante -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-300">
        <a href="#carta" class="hover:text-amber-400 transition-colors">Nuestra Carta</a>
        <a href="#reserva-mesa" class="hover:text-amber-400 transition-colors">Reservar Mesa</a>
        <a href="#comanda-delivery" class="hover:text-amber-400 transition-colors">Delivery Express</a>
        <a href="#contacto-rest" class="hover:text-amber-400 transition-colors">Sedes &amp; Horarios</a>
      </nav>

      <!-- Acciones: Teléfono y Botón de Comanda -->
      <div class="flex items-center gap-3">
        <a
          href="tel:+51940771896"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs text-neutral-300 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          <span>(01) 450-2020</span>
        </a>

        <a
          href="#comanda-delivery"
          class="flex items-center gap-2 rounded-lg bg-amber-500 px-3.5 py-2 text-xs font-bold text-neutral-950 hover:bg-amber-400 transition-colors shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Mi Pedido (<span id="header-order-count">0</span>)</span>
        </a>
      </div>

    </div>
  </header>

  <main>
    <!-- Hero del Restaurante -->
    <section class="relative bg-neutral-950 py-20 sm:py-28 text-white border-b border-neutral-800">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-400">
              Brasas, Criollo &amp; Mar
            </span>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
              Fuego a la Leña, Pasión por la <span class="text-amber-400">Cocina Peruana</span>
            </h1>

            <p class="mt-5 text-sm sm:text-base leading-relaxed text-neutral-300 max-w-xl">
              Carnes maduradas a la brasa, pescados frescos de nuestra costa y recetas criollas con sazón de hogar. Disfruta en nuestro salón o pide a domicilio con empaque térmico sellado.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#carta"
                class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-neutral-950 hover:bg-amber-400 transition-all shadow-md"
              >
                Ver Carta Digital Paginada
              </a>
              <a
                href="#reserva-mesa"
                class="inline-flex items-center justify-center rounded-lg border border-neutral-700 bg-neutral-900 px-5 py-3.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-neutral-800 transition-colors"
              >
                Reservar una Mesa
              </a>
            </div>

            <div class="mt-10 grid grid-cols-3 gap-4 border-t border-neutral-800 pt-6 text-xs text-neutral-400">
              <div>
                <strong class="block text-white font-display text-lg font-bold">45 min</strong>
                Entrega promedio a delivery
              </div>
              <div>
                <strong class="block text-white font-display text-lg font-bold">4.9 / 5.0</strong>
                Calificación en Google Maps
              </div>
              <div>
                <strong class="block text-white font-display text-lg font-bold">100% Leña</strong>
                Algarrobo natural seleccionado
              </div>
            </div>
          </div>

          <!-- Comanda Interactiva Lateral -->
          <div id="comanda-delivery" class="lg:col-span-5 scroll-mt-24">
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-6 shadow-2xl">
              <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400">Delivery &amp; Para Llevar</span>
                  <h3 class="font-display text-lg font-bold text-white">Comanda en Vivo</h3>
                </div>
                <span id="order-count" class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 text-xs font-bold text-neutral-950">
                  0
                </span>
              </div>

              <!-- Lista de ítems en orden -->
              <div id="order-items-list" class="mt-4 space-y-3 min-h-[140px] max-h-[220px] overflow-y-auto pr-1">
                <p id="order-empty" class="text-xs text-neutral-500 text-center py-10">
                  Agrega platos desde la carta inferior para armar tu orden en tiempo real.
                </p>
              </div>

              <div class="mt-4 border-t border-neutral-800 pt-4 space-y-2 text-xs">
                <div class="flex justify-between text-neutral-400">
                  <span>Subtotal</span>
                  <span class="text-white font-medium">S/ <span id="order-subtotal">0.00</span></span>
                </div>
                <div class="flex justify-between text-neutral-400">
                  <span>Empaque térmico &amp; Despacho</span>
                  <span class="text-white font-medium">S/ <span id="order-shipping">0.00</span></span>
                </div>
                <div class="flex justify-between text-sm font-bold text-white border-t border-neutral-800 pt-2">
                  <span>Total Estimado</span>
                  <span class="text-amber-400">S/ <span id="order-total">0.00</span></span>
                </div>
              </div>

              <button
                type="button"
                id="btn-whatsapp-restaurant"
                disabled
                class="mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 py-3 text-xs font-bold text-white hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z" />
                </svg>
                Confirmar y Enviar a WhatsApp
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Carta Digital con Paginación Funcional -->
    <section id="carta" class="scroll-mt-24 py-16 sm:py-24 bg-neutral-900 text-white border-b border-neutral-800">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="max-w-xl">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Nuestra Carta Gastronómica</span>
            <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Platos Preparados al Momento
            </h2>
            <p class="mt-2 text-xs text-neutral-400">
              Navega con paginación funcional en cliente o filtra por categoría culinaria.
            </p>
          </div>

          <!-- Filtros de categoría -->
          <div class="flex flex-wrap items-center gap-1.5" id="menu-category-bar">
            <button type="button" data-cat="all" class="menu-cat-btn rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-bold text-neutral-950 transition-colors">
              Todos ({dishes.length})
            </button>
            <button type="button" data-cat="Entradas" class="menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors">
              Entradas &amp; Ceviches
            </button>
            <button type="button" data-cat="Fondos" class="menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors">
              Platos Criollos
            </button>
            <button type="button" data-cat="Brasas" class="menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors">
              Brasas &amp; Parrilla
            </button>
            <button type="button" data-cat="Postres" class="menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors">
              Postres
            </button>
            <button type="button" data-cat="Bebidas" class="menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors">
              Coctelería &amp; Pisco
            </button>
          </div>
        </div>

        <!-- Buscador de carta -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="relative w-full max-w-sm">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              id="search-menu-input"
              placeholder="Buscar platillo por nombre o ingrediente..."
              class="w-full rounded-lg border border-neutral-700 bg-neutral-800 py-2 pl-9 pr-3 text-xs text-white placeholder:text-neutral-500 focus:border-amber-400 focus:outline-none"
            />
          </div>

          <div class="text-xs text-neutral-400 font-medium">
            Mostrando <span id="menu-current-count">6</span> de <span id="menu-total-count">{dishes.length}</span> platos
          </div>
        </div>

        <!-- Grid de Platos con Imágenes Reales HD (6 por página) -->
        <div id="dishes-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {dishes.map((d) => (
            <div
              class="dish-card group flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-950 overflow-hidden shadow-lg hover:border-amber-500/50 transition-all duration-300"
              data-category={d.category}
              data-name={d.name.toLowerCase()}
              data-desc={d.description.toLowerCase()}
              data-id={d.id}
            >
              <div>
                <!-- Imagen Real HD del Plato -->
                <div class="relative h-48 w-full overflow-hidden bg-neutral-900">
                  <img
                    src={d.image}
                    alt={d.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <span class="absolute top-3 left-3 rounded-full bg-neutral-950/80 backdrop-blur px-2.5 py-1 text-[10px] font-bold text-amber-400 border border-neutral-800">
                    {d.category}
                  </span>
                  <span class="absolute top-3 right-3 rounded-full bg-amber-500 px-2.5 py-1 text-[10px] font-bold text-neutral-950 shadow-xs">
                    {d.badge}
                  </span>
                </div>

                <div class="p-6">
                  <h3 class="font-display text-lg font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-1">
                    {d.name}
                  </h3>
                  <p class="mt-1.5 text-xs text-neutral-400 leading-relaxed line-clamp-2 min-h-[32px]">
                    {d.description}
                  </p>

                  <div class="mt-4 flex items-center justify-between text-[11px] text-neutral-400 border-t border-neutral-800/80 pt-3">
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                      </svg>
                      {d.prepTime}
                    </span>
                    <span>Intensidad: {d.spicy}</span>
                    <span class="flex items-center gap-1 font-bold text-amber-400">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span>{d.rating.toFixed(1)}</span>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Precio y botón agregar -->
              <div class="p-6 pt-0 border-t border-neutral-800/50 mt-2">
                <div class="flex items-center justify-between pt-3">
                  <div>
                    <span class="text-[10px] text-neutral-400 uppercase font-bold block">Precio Carta</span>
                    <span class="font-display text-xl font-bold text-white">S/ {d.price.toFixed(2)}</span>
                  </div>
                  <button
                    type="button"
                    class="btn-add-dish inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3.5 py-2 text-xs font-bold text-neutral-950 hover:bg-amber-400 transition-colors active:scale-95 shadow-xs"
                    data-id={d.id}
                    data-name={d.name}
                    data-price={d.price}
                  >
                    <span>+ Agregar al Pedido</span>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Sin resultados -->
        <div id="no-dishes-msg" class="hidden flex-col items-center justify-center py-16 text-center">
          <p class="font-display text-base font-bold text-white">No encontramos ningún plato que coincida</p>
          <p class="mt-1 text-xs text-neutral-400">Prueba con otra palabra clave o selecciona "Todos".</p>
        </div>

        <!-- Paginación Funcional (6 ítems por página) -->
        <div id="menu-pagination-wrapper" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-neutral-800 pt-6">
          <span class="text-xs text-neutral-400">
            Página <strong id="menu-page-num" class="text-white">1</strong> de <strong id="menu-max-pages" class="text-white">3</strong> (6 platos por página)
          </span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="menu-btn-prev"
              disabled
              class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              &larr; Anterior
            </button>
            <div id="menu-page-buttons" class="flex items-center gap-1"></div>
            <button
              type="button"
              id="menu-btn-next"
              class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Siguiente &rarr;
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Reserva de Mesa Interactiva -->
    <section id="reserva-mesa" class="scroll-mt-24 py-16 sm:py-24 bg-neutral-950 text-white border-b border-neutral-800">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8 sm:p-12 shadow-2xl">
          <div class="text-center max-w-xl mx-auto">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Experiencia en Salón</span>
            <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Reserva tu Mesa Online
            </h2>
            <p class="mt-2 text-xs text-neutral-300">
              Confirmación inmediata garantizada. Sin intermediarios ni cargos adelantados.
            </p>
          </div>

          <form id="reservation-form" class="mt-8 grid gap-4 sm:grid-cols-2 text-xs">
            <div>
              <label class="block font-bold text-neutral-300">Nombre del Titular</label>
              <input type="text" required placeholder="Ej. Carlos Alarcón" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Teléfono / WhatsApp</label>
              <input type="tel" required placeholder="+51 987 654 321" class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Fecha de la Reserva</label>
              <input type="date" required class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Turno / Horario</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>Almuerzo: 1:00 PM</option>
                <option>Almuerzo: 2:30 PM</option>
                <option>Cena: 7:30 PM</option>
                <option>Cena: 9:00 PM</option>
              </select>
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Número de Comensales</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>2 Personas (Pareja)</option>
                <option>4 Personas (Mesa estándar)</option>
                <option>6 Personas (Familiar)</option>
                <option>8 a 12 Personas (Celebración / Ejecutivo)</option>
              </select>
            </div>

            <div>
              <label class="block font-bold text-neutral-300">Zona Preferida</label>
              <select class="mt-1.5 w-full rounded-lg border border-neutral-700 bg-neutral-800 p-2.5 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option>Salón Principal (Música ambiental)</option>
                <option>Terraza al Aire Libre</option>
                <option>Cava Privada (Reuniones)</option>
              </select>
            </div>

            <div class="sm:col-span-2 pt-3">
              <button
                type="submit"
                class="w-full rounded-lg bg-amber-500 py-3 font-bold text-neutral-950 hover:bg-amber-400 transition-colors shadow-md"
              >
                Confirmar Reserva de Mesa
              </button>
            </div>
          </form>

          <div id="reservation-success-box" class="hidden mt-6 rounded-xl bg-emerald-950/70 border border-emerald-500/50 p-4 text-emerald-300 text-xs">
            <strong class="font-bold block text-sm">Reserva confirmada con éxito</strong>
            <p class="mt-1 text-neutral-300">
              Hemos reservado tu mesa para el día y turno seleccionados. Te esperamos en nuestro salón.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer Propio del Restaurante -->
  <footer id="contacto-rest" class="border-t border-neutral-800 bg-neutral-950 text-white py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 text-xs">
        
        <!-- Marca -->
        <div>
          <span class="font-display text-base font-bold text-white tracking-wider">FUEGO &amp; BRASA</span>
          <p class="mt-3 text-neutral-400 leading-relaxed">
            Asador tradicional y cocina marina en Perú. Carnes a la leña de algarrobo y pesca fresca diaria.
          </p>
          <div class="mt-4 text-neutral-400">
            RUC: 20608945123 · Fuego y Brasa SAC
          </div>
        </div>

        <!-- Horarios -->
        <div>
          <h4 class="font-bold text-amber-400 uppercase tracking-wider text-[11px]">Horario de Atención</h4>
          <ul class="mt-3 space-y-1.5 text-neutral-400">
            <li>Lunes a Jueves: 12:00 PM – 10:30 PM</li>
            <li>Viernes y Sábados: 12:00 PM – 11:30 PM</li>
            <li>Domingos: 12:00 PM – 9:00 PM</li>
            <li class="text-amber-400 font-semibold pt-1">Delivery: Todos los días</li>
          </ul>
        </div>

        <!-- Sedes -->
        <div>
          <h4 class="font-bold text-amber-400 uppercase tracking-wider text-[11px]">Nuestras Sedes</h4>
          <ul class="mt-3 space-y-1.5 text-neutral-400">
            <li>Sede Miraflores: Av. La Mar 1280, Lima</li>
            <li>Sede Tarapoto: Jr. San Martín 340, San Martín</li>
            <li>Central Telefónica: (01) 450-2020</li>
            <li>WhatsApp Reservas: +51 940 771 896</li>
          </ul>
        </div>

        <!-- Legal & Libro de reclamaciones -->
        <div>
          <h4 class="font-bold text-amber-400 uppercase tracking-wider text-[11px]">Atención al Cliente</h4>
          <ul class="mt-3 space-y-1.5 text-neutral-400">
            <li>Libro de Reclamaciones Virtual</li>
            <li>Políticas de Envío &amp; Cancelación</li>
            <li>Facturación Electrónica SUNAT</li>
            <li>Medios de Pago: Yape, Plin, Visa, Mastercard</li>
          </ul>
        </div>

      </div>

      <div class="mt-12 border-t border-neutral-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500">
        <p>© 2026 FUEGO &amp; BRASA. Todos los derechos reservados.</p>
        <p class="mt-2 sm:mt-0">Sitio de Demostración Gastronómica creado por <a href="/" class="text-amber-400 underline">Archity</a></p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Comanda de delivery
  interface OrderItem {
    id: string;
    name: string;
    price: number;
    qty: number;
  }

  let order: OrderItem[] = [];

  const orderCountEl = document.getElementById("order-count");
  const headerOrderCountEl = document.getElementById("header-order-count");
  const orderListEl = document.getElementById("order-items-list");
  const orderEmptyEl = document.getElementById("order-empty");
  const orderSubtotalEl = document.getElementById("order-subtotal");
  const orderShippingEl = document.getElementById("order-shipping");
  const orderTotalEl = document.getElementById("order-total");
  const btnWhatsappRest = document.getElementById("btn-whatsapp-restaurant") as HTMLButtonElement | null;

  function renderOrder() {
    const totalQty = order.reduce((acc, i) => acc + i.qty, 0);
    if (orderCountEl) orderCountEl.textContent = totalQty.toString();
    if (headerOrderCountEl) headerOrderCountEl.textContent = totalQty.toString();

    if (order.length === 0) {
      if (orderEmptyEl) orderEmptyEl.classList.remove("hidden");
      if (orderSubtotalEl) orderSubtotalEl.textContent = "0.00";
      if (orderShippingEl) orderShippingEl.textContent = "0.00";
      if (orderTotalEl) orderTotalEl.textContent = "0.00";
      if (btnWhatsappRest) btnWhatsappRest.disabled = true;
      if (orderListEl) {
        orderListEl.innerHTML = '<p id="order-empty" class="text-xs text-neutral-500 text-center py-10">Agrega platos desde la carta inferior para armar tu orden en tiempo real.</p>';
      }
      return;
    }

    if (btnWhatsappRest) btnWhatsappRest.disabled = false;

    const subtotal = order.reduce((acc, i) => acc + (i.price * i.qty), 0);
    const shipping = 8.00;
    const total = subtotal + shipping;

    if (orderSubtotalEl) orderSubtotalEl.textContent = subtotal.toFixed(2);
    if (orderShippingEl) orderShippingEl.textContent = shipping.toFixed(2);
    if (orderTotalEl) orderTotalEl.textContent = total.toFixed(2);

    if (orderListEl) {
      orderListEl.innerHTML = order.map(item => `
        <div class="flex items-center justify-between text-xs py-1.5 border-b border-neutral-800">
          <div class="min-w-0 flex-1 pr-2">
            <span class="block truncate font-bold text-white">${item.name}</span>
            <span class="text-neutral-500 text-[10px]">S/ ${item.price.toFixed(2)} c/u</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-amber-400">x${item.qty}</span>
            <span class="font-mono text-white">S/ ${(item.price * item.qty).toFixed(2)}</span>
            <button type="button" data-del-id="${item.id}" class="btn-del-dish text-neutral-500 hover:text-rose-400 ml-1">✕</button>
          </div>
        </div>
      `).join("");

      orderListEl.querySelectorAll(".btn-del-dish").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute("data-del-id");
          order = order.filter(i => i.id !== id);
          renderOrder();
        });
      });
    }
  }

  document.querySelectorAll(".btn-add-dish").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const button = e.currentTarget as HTMLElement;
      const id = button.getAttribute("data-id") || "";
      const name = button.getAttribute("data-name") || "";
      const price = parseFloat(button.getAttribute("data-price") || "0");

      const existing = order.find(i => i.id === id);
      if (existing) {
        existing.qty++;
      } else {
        order.push({ id, name, price, qty: 1 });
      }
      renderOrder();

      const origText = button.innerHTML;
      button.innerHTML = "<span>✓ Agregado</span>";
      setTimeout(() => { button.innerHTML = origText; }, 900);
    });
  });

  btnWhatsappRest?.addEventListener("click", () => {
    const total = orderTotalEl?.textContent || "0.00";
    const items = order.map(i => `• ${i.qty}x ${i.name} (S/ ${(i.price * i.qty).toFixed(2)})`).join("\n");
    const msg = encodeURIComponent(`Hola Fuego & Brasa, deseo encargar este pedido a delivery:\n\n${items}\n\nTotal estimado: S/ ${total}\n\n¿Cuánto demora la entrega?`);
    window.open(`https://wa.me/51940771896?text=${msg}`, "_blank");
  });

  // Paginación Funcional de Menú
  const dishCards = Array.from(document.querySelectorAll("#dishes-grid > .dish-card")) as HTMLElement[];
  const searchInput = document.getElementById("search-menu-input") as HTMLInputElement | null;
  const catButtons = document.querySelectorAll(".menu-cat-btn");
  const countCurrentEl = document.getElementById("menu-current-count");
  const countTotalEl = document.getElementById("menu-total-count");
  const pageNumEl = document.getElementById("menu-page-num");
  const maxPagesEl = document.getElementById("menu-max-pages");
  const noDishesMsg = document.getElementById("no-dishes-msg");
  const paginationWrapper = document.getElementById("menu-pagination-wrapper");
  const pageButtonsContainer = document.getElementById("menu-page-buttons");
  const btnPrev = document.getElementById("menu-btn-prev") as HTMLButtonElement | null;
  const btnNext = document.getElementById("menu-btn-next") as HTMLButtonElement | null;

  const DISHES_PER_PAGE = 6;
  let currentMenuPage = 1;
  let activeMenuCat = "all";
  let activeMenuSearch = "";

  function getFilteredDishes(): HTMLElement[] {
    return dishCards.filter(card => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-desc") || "";

      const matchesCat = activeMenuCat === "all" || cat.toLowerCase() === activeMenuCat.toLowerCase();
      const matchesSearch = !activeMenuSearch || name.includes(activeMenuSearch) || desc.includes(activeMenuSearch);

      return matchesCat && matchesSearch;
    });
  }

  function renderMenuPagination() {
    const filtered = getFilteredDishes();
    const total = filtered.length;
    const maxPages = Math.ceil(total / DISHES_PER_PAGE) || 1;

    if (currentMenuPage > maxPages) currentMenuPage = maxPages;
    if (currentMenuPage < 1) currentMenuPage = 1;

    dishCards.forEach(c => c.classList.add("hidden"));

    const start = (currentMenuPage - 1) * DISHES_PER_PAGE;
    const pageItems = filtered.slice(start, start + DISHES_PER_PAGE);
    pageItems.forEach(c => c.classList.remove("hidden"));

    if (countCurrentEl) countCurrentEl.textContent = pageItems.length.toString();
    if (countTotalEl) countTotalEl.textContent = total.toString();
    if (pageNumEl) pageNumEl.textContent = currentMenuPage.toString();
    if (maxPagesEl) maxPagesEl.textContent = maxPages.toString();

    if (total === 0) {
      noDishesMsg?.classList.remove("hidden");
      noDishesMsg?.classList.add("flex");
      paginationWrapper?.classList.add("hidden");
    } else {
      noDishesMsg?.classList.add("hidden");
      noDishesMsg?.classList.remove("flex");
      paginationWrapper?.classList.remove("hidden");
    }

    if (btnPrev) btnPrev.disabled = currentMenuPage <= 1;
    if (btnNext) btnNext.disabled = currentMenuPage >= maxPages;

    if (pageButtonsContainer) {
      pageButtonsContainer.innerHTML = "";
      for (let i = 1; i <= maxPages; i++) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = i.toString();
        b.className = i === currentMenuPage
          ? "h-8 w-8 rounded-lg bg-amber-500 text-xs font-bold text-neutral-950 shadow-xs"
          : "h-8 w-8 rounded-lg border border-neutral-700 bg-neutral-800 text-xs font-semibold text-neutral-300 hover:bg-neutral-700";
        b.addEventListener("click", () => {
          currentMenuPage = i;
          renderMenuPagination();
          document.getElementById("carta")?.scrollIntoView({ behavior: "smooth" });
        });
        pageButtonsContainer.appendChild(b);
      }
    }
  }

  catButtons.forEach(btn => {
    btn.addEventListener("click", (e) => {
      const cat = (e.currentTarget as HTMLElement).getAttribute("data-cat") || "all";
      activeMenuCat = cat;
      currentMenuPage = 1;

      catButtons.forEach(b => {
        b.className = "menu-cat-btn rounded-lg bg-neutral-800 border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-700 transition-colors";
      });
      (e.currentTarget as HTMLElement).className = "menu-cat-btn rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-bold text-neutral-950 transition-colors";

      renderMenuPagination();
    });
  });

  searchInput?.addEventListener("input", () => {
    activeMenuSearch = searchInput.value.trim().toLowerCase();
    currentMenuPage = 1;
    renderMenuPagination();
  });

  btnPrev?.addEventListener("click", () => {
    if (currentMenuPage > 1) {
      currentMenuPage--;
      renderMenuPagination();
      document.getElementById("carta")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  btnNext?.addEventListener("click", () => {
    const max = Math.ceil(getFilteredDishes().length / DISHES_PER_PAGE);
    if (currentMenuPage < max) {
      currentMenuPage++;
      renderMenuPagination();
      document.getElementById("carta")?.scrollIntoView({ behavior: "smooth" });
    }
  });

  // Reserva de mesa
  const resForm = document.getElementById("reservation-form") as HTMLFormElement | null;
  const resSuccessBox = document.getElementById("reservation-success-box");
  resForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    resSuccessBox?.classList.remove("hidden");
    resForm.reset();
  });

  renderOrder();
  renderMenuPagination();
</script>
