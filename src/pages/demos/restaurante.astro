    badge: "Tradición",
    rating: 4.9,
    description: "Cocción lenta de 6 horas en chicha de jora y reducción de culantro norteño. Servido con arroz blanco graneado.",
    spicy: "Suave",
    prepTime: "20 min",
  },
  {
