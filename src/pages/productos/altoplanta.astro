<script>
  const buttons = document.querySelectorAll(".ap-lot-btn");
  const idEl = document.getElementById("ap-detail-id");
  const titleEl = document.getElementById("ap-detail-title");
  const statusEl = document.getElementById("ap-detail-status");
  const areaEl = document.getElementById("ap-detail-area");
  const frontEl = document.getElementById("ap-detail-front");
  const priceEl = document.getElementById("ap-detail-price");
  const initialEl = document.getElementById("ap-detail-initial");
  const monthsInput = document.getElementById("ap-months") as HTMLInputElement | null;
  const monthsLabel = document.getElementById("ap-months-label");
  const monthlyPayment = document.getElementById("ap-monthly-payment");

  let currentLot = {
    id: "MZ-A-01",
    block: "Manzana A",
    lot: "Lote 01 (Esquina)",
    area: 160,
    front: "10.00m x 16.00m",
    price: 68800,
    initial: 6880,
    status: "Disponible",
  };

  function updateCalculation() {
    const months = Number(monthsInput?.value || 36);
    if (monthsLabel) monthsLabel.textContent = `${months} cuotas mensuales`;
    const financed = currentLot.price - currentLot.initial;
    const quota = financed / months;
    if (monthlyPayment) {
      monthlyPayment.textContent = `S/ ${quota.toLocaleString("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} / mes`;
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => {
        b.classList.remove("border-accent", "bg-accent-soft/40", "shadow-2xs");
        b.classList.add("border-neutral-200", "bg-white");
      });
      btn.classList.remove("border-neutral-200", "bg-white");
      btn.classList.add("border-accent", "bg-accent-soft/40", "shadow-2xs");

      const data = btn.getAttribute("data-lot");
      if (data) {
        currentLot = JSON.parse(data);
        if (idEl) idEl.textContent = currentLot.id;
        if (titleEl) titleEl.textContent = `${currentLot.block} · ${currentLot.lot}`;
        if (areaEl) areaEl.textContent = `${currentLot.area} m²`;
        if (frontEl) frontEl.textContent = currentLot.front;
        if (priceEl) priceEl.textContent = `S/ ${currentLot.price.toLocaleString("es-PE")}`;
        if (initialEl) initialEl.textContent = `S/ ${currentLot.initial.toLocaleString("es-PE")}`;
        if (statusEl) {
          statusEl.textContent = currentLot.status;
          statusEl.className = `rounded-full px-3 py-1 text-xs font-bold ${
            currentLot.status === "Disponible"
              ? "bg-emerald-100 text-emerald-800"
              : currentLot.status === "Separado"
              ? "bg-amber-100 text-amber-800"
              : "bg-red-100 text-red-800"
          }`;
        }
        updateCalculation();
      }
    });
  });

  monthsInput?.addEventListener("input", updateCalculation);
</script>
