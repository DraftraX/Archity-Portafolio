---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ECCTaxSimulator from "../../components/ecc/ECCTaxSimulator.astro";
---

<Layout
  title="AltoPlanta — SaaS de Tributo Inmobiliario & Fiscalización Catastral en Perú | Archity"
  description="Plataforma SaaS líder para la determinación, liquidación y gestión del tributo inmobiliario: impuesto predial, arbitrios municipales, alcabala, emisión de cuponeras PDF y fiscalización catastral."
>
  <Header />

  <main>
    <!-- Hero del Producto SaaS Tributario -->
    <section class="border-b border-neutral-200/70 bg-gradient-to-b from-neutral-50/70 via-white to-white py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs font-medium text-neutral-500 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-neutral-900 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/#productos" class="hover:text-neutral-900 transition-colors">Productos</a>
          <span>/</span>
          <span class="text-neutral-900">AltoPlanta</span>
        </nav>

        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft border border-accent/20 px-3 py-1 text-xs font-semibold text-accent">
                <span class="h-2 w-2 rounded-full bg-accent animate-pulse" />
                SaaS Operativo en Vivo
              </span>
              <span class="rounded-full bg-neutral-100 border border-neutral-200 px-3 py-1 text-xs font-semibold text-neutral-800">
                Tributo Inmobiliario &amp; Catastro
              </span>
            </div>

            <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
              AltoPlanta
            </h1>
            <p class="text-lg font-medium text-accent mt-1">
              SaaS para la Gestión y Fiscalización del Tributo Inmobiliario en Perú
            </p>

            <p class="mt-4 text-base leading-relaxed text-neutral-600 sm:text-lg">
              Diseñada y construida por <strong>Archity</strong>, <strong>AltoPlanta</strong> (<a href="https://altoplanta.com/" target="_blank" rel="noopener" class="text-accent underline font-semibold">altoplanta.com</a>) es la plataforma tecnológica especializada en automatizar la determinación, liquidación, emisión de cuponeras y fiscalización del tributo inmobiliario: <strong>Impuesto Predial (D. Leg. 776)</strong>, <strong>Arbitrios Municipales</strong>, <strong>Impuesto de Alcabala</strong> y cartografía catastral para municipalidades, consorcios y gestores inmobiliarios.
            </p>

            <!-- Acciones -->
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="https://altoplanta.com/"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-xs transition-all hover:bg-accent-dark hover:shadow-md hover:shadow-accent/20"
              >
                Abrir altoplanta.com
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>

              <a
                href="#simulador-tributario"
                class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-50"
              >
                Probar Simulador de Impuestos
              </a>
            </div>

            <!-- Stats reales del sistema tributario -->
            <div class="mt-10 grid grid-cols-3 gap-4 border-t border-neutral-200/80 pt-6 text-left">
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">D.L. 776</span>
                <span class="text-xs text-neutral-500">Normativa Tributaria Perú</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-accent">100%</span>
                <span class="text-xs text-neutral-500">Liquidación Automatizada</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">PDF</span>
                <span class="text-xs text-neutral-500">Cuponeras &amp; Cartas Masivas</span>
              </div>
            </div>
          </div>

          <!-- Mockup visual representativo de AltoPlanta Tributario -->
          <div class="relative">
            <div class="overflow-hidden rounded-2xl border border-neutral-200/90 bg-white shadow-xl shadow-neutral-900/5">
              <!-- Barra superior simulada -->
              <div class="flex items-center justify-between border-b border-neutral-100 bg-neutral-50/80 px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
                </div>
                <div class="flex items-center gap-1.5 rounded-md bg-white border border-neutral-200/80 px-3 py-1 text-xs text-neutral-600 font-mono">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                  </svg>
                  https://altoplanta.com
                </div>
                <span class="text-[10px] font-semibold text-accent bg-accent-soft px-2 py-0.5 rounded border border-accent/20">En vivo</span>
              </div>

              <!-- Interfaz simulada del SaaS -->
              <div class="p-6 space-y-6">
                <!-- Tarjeta de Determinación Tributaria -->
                <div class="rounded-xl border border-neutral-200 bg-neutral-50/70 p-4">
                  <div class="flex items-center justify-between mb-2 text-xs">
                    <span class="font-bold text-neutral-900">Módulo de Fiscalización Predial</span>
                    <span class="text-accent font-semibold">UIT 2026: S/ 5,350</span>
                  </div>
                  <div class="grid grid-cols-3 gap-2 text-xs">
                    <div class="rounded-lg bg-white border border-neutral-200 p-2 text-neutral-700">
                      <span class="block text-[10px] text-neutral-400">Predios Fiscalizados</span>
                      <strong class="font-bold text-neutral-900">4,280</strong>
                    </div>
                    <div class="rounded-lg bg-white border border-neutral-200 p-2 text-neutral-700">
                      <span class="block text-[10px] text-neutral-400">Autovalúo Total</span>
                      <strong class="font-bold text-accent">S/ 482.4M</strong>
                    </div>
                    <div class="rounded-lg bg-white border border-neutral-200 p-2 text-neutral-700">
                      <span class="block text-[10px] text-neutral-400">Recaudación Estimada</span>
                      <strong class="font-bold text-emerald-600">S/ 3.84M</strong>
                    </div>
                  </div>
                </div>

                <!-- Preview de Cuponera Digital -->
                <div class="rounded-xl border border-neutral-200 overflow-hidden bg-white">
                  <div class="bg-neutral-900 px-4 py-2.5 text-white flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                      <span class="font-mono font-bold">HOJA RESUMEN (HR) &amp; PREDIO URBANO (PU)</span>
                    </div>
                    <span class="text-[10px] text-neutral-400">Cálculo Escalonado Ley 776</span>
                  </div>
                  <div class="p-4 flex items-center justify-between text-xs">
                    <div>
                      <strong class="block text-neutral-900 font-semibold text-sm">Predio Urbano: Av. San Martín 450</strong>
                      <span class="text-neutral-500">Uso: Comercial | Área de Terreno: 480.00 m²</span>
                    </div>
                    <a
                      href="#simulador-tributario"
                      class="rounded-md bg-accent-soft text-accent px-2.5 py-1.5 font-bold border border-accent/20 hover:bg-accent hover:text-white transition-colors"
                    >
                      Calcular S/
                    </a>
                  </div>
                </div>

                <!-- Mini estatus catastral -->
                <div class="flex items-center justify-between rounded-lg border border-neutral-200 bg-neutral-50/80 p-3 text-xs">
                  <div class="flex items-center gap-2.5">
                    <span class="h-2 w-2 rounded-full bg-accent"></span>
                    <span class="font-medium text-neutral-700">Detección de Omisos Catastrales: 184 predios regularizados</span>
                  </div>
                  <span class="text-neutral-400 text-[11px]">Cruce con SUNARP &amp; Satélite</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Componente ECC: Simulador Interactivo de Impuesto Predial y Arbitrios -->
    <section id="simulador-tributario" class="scroll-mt-20 py-16 sm:py-24 bg-neutral-50/50 border-b border-neutral-200/80">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Demostración Interactiva en Vivo</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
            Prueba el Algoritmo Tributario de AltoPlanta
          </h2>
          <p class="mt-3 text-neutral-600 text-sm">
            Ingresa un valor de autovalúo y selecciona el destino del inmueble. El simulador computa tramo por tramo la escala progresiva acumulativa del Impuesto Predial peruano y estima los arbitrios municipales.
          </p>
        </div>

        <ECCTaxSimulator />
      </div>
    </section>

    <!-- Funcionalidades Principales del SaaS -->
    <section id="caracteristicas" class="py-20 bg-white border-b border-neutral-200/80">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-2xl text-center mx-auto">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Arquitectura &amp; Funcionalidades</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
            Módulos Clave del SaaS AltoPlanta
          </h2>
          <p class="mt-3 text-neutral-600">
            Diseñado para cumplir rigurosamente con la Ley de Tributación Municipal y modernizar la gestión catastral en el Perú.
          </p>
        </div>

        <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <!-- 1. Motor de Impuesto Predial -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-accent text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              01
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Motor de Impuesto Predial (D.L. 776)</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Aplica automáticamente la escala progresiva acumulativa legal: hasta 15 UIT (0.2%), de 15 a 60 UIT (0.6%) y más de 60 UIT (1.0%), con actualización anual de la UIT nacional.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Cálculo de autovalúo arancelario de terreno y construcción</li>
              <li>• Regla de mínimo legal de 0.6% de 1 UIT</li>
              <li>• Desglose en 4 cuotas trimestrales de vencimiento</li>
            </ul>
          </div>

          <!-- 2. Arbitrios Municipales -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-neutral-900 text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              02
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Prorrateo &amp; Liquidación de Arbitrios</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Parametrización por ordenanzas distritales de los servicios esenciales: Barrido de Calles, Recolección de Residuos Sólidos, Parques y Jardines Públicos y Serenazgo Municipal.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Diferenciación por uso (casa habitación, comercio, industria)</li>
              <li>• Tasas por frontis lineal y metraje techado</li>
              <li>• Incentivos por pronto pago y beneficios al adulto mayor</li>
            </ul>
          </div>

          <!-- 3. Impuesto de Alcabala -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-accent text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              03
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Impuesto de Alcabala &amp; Tasaciones</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Cálculo instantáneo para transferencias notariales de propiedad. Aplica la inafectación legal de las primeras 10 UIT y liquida la tasa del 3% sobre el mayor valor entre venta y autovalúo.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Validación de constancia de no adeudo previa</li>
              <li>• Generación de proformas para minutas notariales</li>
              <li>• Trazabilidad histórica de compraventas de predios</li>
            </ul>
          </div>

          <!-- 4. Cartografía y Catastro -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-neutral-900 text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              04
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Catastro Urbano &amp; Fiscalización</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Mapeo georreferenciado de predios, identificación de ampliaciones no declaradas mediante imágenes satelitales y regularización catastral de contribuyentes omisos y subvaluadores.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Georreferenciación de manzanas y lotizaciones</li>
              <li>• Detección de cambios de uso (residencial a comercial)</li>
              <li>• Sincronización con fichas catastrales municipales</li>
            </ul>
          </div>

          <!-- 5. Emisión Masiva de Cuponeras PDF -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-accent text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              05
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Cuponeras Digitales &amp; Estados de Cuenta</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Generación de miles de cuponeras mecanizadas en PDF en cuestión de segundos: Hoja Resumen (HR), Predio Urbano (PU) y recibos de pago con códigos QR y barras para recaudación bancaria.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Formato oficial estándar homologado por MEF</li>
              <li>• Código QR para pago exprés desde celular</li>
              <li>• Envío masivo por correo electrónico y WhatsApp</li>
            </ul>
          </div>

          <!-- 6. Arquitectura Cloud Archity -->
          <div class="rounded-2xl border border-neutral-200/80 p-8 bg-neutral-50/50 hover:bg-white hover:shadow-lg transition duration-300">
            <div class="h-10 w-10 rounded-xl bg-neutral-900 text-white flex items-center justify-center font-bold mb-5 shadow-xs">
              06
            </div>
            <h3 class="font-display text-xl font-bold text-neutral-900">Infraestructura Segura &amp; PostgreSQL</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">
              Arquitectura multi-inquilino en la nube desarrollada con Astro y base de datos relacional PostgreSQL con soporte GIS (PostGIS) para geometrías de predios y consultas de alta concurrencia.
            </p>
            <ul class="mt-4 space-y-1.5 text-xs text-neutral-500">
              <li>• Soporte GIS para geometrías de parcelas</li>
              <li>• Encriptación SSL y copias de seguridad continuas</li>
              <li>• API REST para integración con tesorería y bancos</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- Banner CTA final -->
    <section class="border-t border-neutral-200/70 bg-neutral-900 text-white py-16">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-xs font-bold uppercase tracking-widest text-accent">Plataforma Operativa en Línea</span>
        <h2 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Conoce AltoPlanta en Producción Real
        </h2>
        <p class="mt-4 text-neutral-400 max-w-xl mx-auto text-sm sm:text-base">
          Accede directamente al dominio oficial de AltoPlanta o contáctanos en Archity si necesitas implementar un motor tributario, catastral o SaaS a medida.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="https://altoplanta.com/"
            target="_blank"
            rel="noopener"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-dark transition-colors shadow-xs"
          >
            Visitar altoplanta.com
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href="/demos/landing-empresa"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-neutral-700 bg-neutral-800 px-6 py-3 text-sm font-semibold text-white hover:bg-neutral-700 transition-colors"
          >
            Ver Demo de Landing Corporativa B2B
          </a>
          <a
            href="/#contacto"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-neutral-700 bg-neutral-800 px-6 py-3 text-sm font-semibold text-white hover:bg-neutral-700 transition-colors"
          >
            Cotizar Sistema con Archity
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
