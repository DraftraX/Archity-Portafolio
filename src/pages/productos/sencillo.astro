---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Sencillo — Plataforma FinTech de Cobranza, Letras & Contratos | Archity"
  description="Microservicio FinTech desarrollado por Archity (sencillo.altoplanta.com): generación de contratos inmobiliarios, cronogramas de amortización (Francés / 0% TEA), cálculo diario de mora y recaudación con Mercado Pago Webhooks."
>
  <Header />

  <main class="ca-grid">
    <!-- Hero de Sencillo con su logo oficial -->
    <section class="border-b border-[var(--ca-ink)]/15 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs font-medium text-neutral-500 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-neutral-900 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/#productos" class="hover:text-neutral-900 transition-colors">Productos</a>
          <span>/</span>
          <span class="text-neutral-900">Sencillo FinTech</span>
        </nav>

        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <!-- Logo oficial de Sencillo -->
            <div class="mb-6 inline-flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white px-4 py-2.5 shadow-2xs">
              <img src="/logos/sencillo-logo.svg" alt="Sencillo Logo Oficial" class="h-8 w-auto object-contain" />
              <span class="h-4 w-px bg-neutral-200"></span>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" />
                FinTech &amp; Cobranza en Vivo
              </span>
            </div>

            <h1 class="font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
              Sencillo
            </h1>
            <p class="text-lg font-medium text-accent mt-1">
              Gestión Automatizada de Contratos, Letras, Cronogramas &amp; Recaudación Online
            </p>

            <p class="mt-4 text-base leading-relaxed text-neutral-600 sm:text-lg">
              Construido por <strong>Archity</strong> (<a href="https://sencillo.altoplanta.com/" target="_blank" rel="noopener" class="text-accent underline font-semibold">sencillo.altoplanta.com</a>), <strong>Sencillo</strong> es el motor financiero para desarrolladoras inmobiliarias y empresas de crédito directo: genera contratos en PDF con variables dinámicas, estructura <strong>cronogramas de pagos (Sistema Francés o Crédito Directo 0% TEA)</strong>, liquida intereses moratorios por día de atraso, concilia cobros en tiempo real vía <strong>Webhooks de Mercado Pago</strong> y mantiene un <strong>Kardex digital auditable</strong>.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="https://sencillo.altoplanta.com/"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-xs transition-all hover:bg-accent-dark hover:shadow-md hover:shadow-accent/20"
              >
                Abrir sencillo.altoplanta.com
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
              <a
                href="#simulador-sencillo"
                class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-50"
              >
                Simular Cronograma y Mora
              </a>
            </div>

            <div class="mt-10 grid grid-cols-3 gap-4 border-t border-neutral-200/80 pt-6 text-left">
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">Francés / 0%</span>
                <span class="text-xs text-neutral-500">Motor de Amortización</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-accent">Webhooks</span>
                <span class="text-xs text-neutral-500">Conciliación Mercado Pago</span>
              </div>
              <div>
                <span class="block font-display text-2xl font-bold text-neutral-900">Kardex PDF</span>
                <span class="text-xs text-neutral-500">Constancias de No Adeudo</span>
              </div>
            </div>
          </div>

          <!-- Kardex Digital Simulado -->
          <div class="relative">
            <div class="overflow-hidden rounded-2xl border border-neutral-200/90 bg-white shadow-xl shadow-neutral-900/5">
              <div class="flex items-center justify-between border-b border-neutral-100 bg-neutral-900 px-4 py-3 text-white">
                <div class="flex items-center gap-2.5">
                  <img src="/logos/sencillo-mark.svg" alt="Sencillo" class="h-5 w-5" />
                  <span class="text-xs font-mono font-semibold">sencillo.altoplanta.com · Kardex #EXP-2026-089</span>
                </div>
                <span class="rounded bg-emerald-500/20 border border-emerald-400/30 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">
                  Conciliación Automática
                </span>
              </div>

              <div class="p-6 space-y-4 bg-neutral-50/50 text-xs">
                <div class="rounded-xl border border-neutral-200 bg-white p-4">
                  <div class="flex items-center justify-between mb-2">
                    <strong class="text-neutral-900 text-sm">Contrato: Mz A Lote 01 — Residencial Los Pinos</strong>
                    <span class="font-mono text-emerald-700 font-bold">AL DÍA</span>
                  </div>
                  <div class="grid grid-cols-3 gap-2 pt-2 border-t border-neutral-100">
                    <div>
                      <span class="text-[10px] text-neutral-400 block">Saldo Financiado</span>
                      <strong class="font-bold text-neutral-900">S/ 61,920.00</strong>
                    </div>
                    <div>
                      <span class="text-[10px] text-neutral-400 block">Cuotas Pagadas</span>
                      <strong class="font-bold text-emerald-600">12 / 36</strong>
                    </div>
                    <div>
                      <span class="text-[10px] text-neutral-400 block">Próximo Vencimiento</span>
                      <strong class="font-bold text-neutral-900">15 Nov 2026</strong>
                    </div>
                  </div>
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between rounded-lg border border-neutral-200 bg-white p-3">
                    <div>
                      <strong class="text-neutral-900">Letra #011 · Recibo PDF #REC-8841</strong>
                      <span class="block text-[11px] text-neutral-500">Pagado vía Mercado Pago Webhook (Yape / Tarjeta)</span>
                    </div>
                    <span class="rounded bg-emerald-100 px-2 py-0.5 font-mono font-bold text-emerald-800">S/ 1,720.00</span>
                  </div>
                  <div class="flex items-center justify-between rounded-lg border border-neutral-200 bg-white p-3">
                    <div>
                      <strong class="text-neutral-900">Letra #012 · Recibo PDF #REC-9104</strong>
                      <span class="block text-[11px] text-neutral-500">Pagado vía Transferencia Conciliada</span>
                    </div>
                    <span class="rounded bg-emerald-100 px-2 py-0.5 font-mono font-bold text-emerald-800">S/ 1,720.00</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Simulador Interactivo de Amortización y Mora Sencillo -->
    <section id="simulador-sencillo" class="scroll-mt-20 py-16 sm:py-24 bg-neutral-50/60 border-b border-neutral-200/80">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Motor Financiero Interactivo</p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
            Calculadora de Cronogramas (Francés / 0% TEA) &amp; Mora Diaria
          </h2>
          <p class="mt-3 text-neutral-600 text-sm">
            Experimenta el motor matemático de <strong>Sencillo</strong>: configura el saldo a financiar, la tasa efectiva anual (TEA) y simula días de atraso para calcular el interés moratorio diario.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-[1fr_1.3fr]">
          <!-- Parámetros del Crédito -->
          <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs space-y-4 text-xs">
            <div>
              <label for="sc-capital" class="block font-semibold text-neutral-700 mb-1">Saldo a Financiar (S/)</label>
              <input id="sc-capital" type="number" value="54000" min="5000" step="1000" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm font-bold text-neutral-900" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="sc-months" class="block font-semibold text-neutral-700 mb-1">Número de Letras</label>
                <select id="sc-months" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-900 bg-white">
                  <option value="12">12 meses (1 año)</option>
                  <option value="24">24 meses (2 años)</option>
                  <option value="36" selected>36 meses (3 años)</option>
                  <option value="48">48 meses (4 años)</option>
                  <option value="60">60 meses (5 años)</option>
                </select>
              </div>
              <div>
                <label for="sc-tea" class="block font-semibold text-neutral-700 mb-1">Modalidad / TEA (%)</label>
                <select id="sc-tea" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm font-semibold text-neutral-900 bg-white">
                  <option value="0" selected>0% (Crédito Directo)</option>
                  <option value="12">12% TEA (Francés)</option>
                  <option value="15">15% TEA (Francés)</option>
                  <option value="18">18% TEA (Francés)</option>
                </select>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="sc-late-days" class="font-semibold text-neutral-700">Simular Días de Atraso (Mora 0.15% diario):</label>
                <span id="sc-late-label" class="font-mono font-bold text-amber-700">0 días</span>
              </div>
              <input id="sc-late-days" type="range" min="0" max="30" value="0" class="w-full accent-accent cursor-pointer" />
            </div>

            <div class="rounded-xl bg-neutral-900 text-white p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-neutral-400">Cuota Base Mensual:</span>
                <strong id="sc-base-quota" class="font-display text-lg font-bold text-white">S/ 1,500.00</strong>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-neutral-400">Penalidad por Mora:</span>
                <strong id="sc-late-fee" class="font-mono font-bold text-amber-400">S/ 0.00</strong>
              </div>
              <div class="flex items-center justify-between border-t border-neutral-800 pt-2">
                <span class="text-neutral-300 font-semibold">Total a Liquidar en Pasarela:</span>
                <strong id="sc-total-pay" class="font-display text-xl font-bold text-emerald-400">S/ 1,500.00</strong>
              </div>
            </div>
          </div>

          <!-- Vista Previa de las primeras 5 Letras del Cronograma -->
          <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs overflow-hidden">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-neutral-100">
              <h3 class="font-display text-base font-bold text-neutral-900">Vista Previa del Cronograma de Letras</h3>
              <span class="text-[11px] font-mono text-neutral-400">Kardex Auditable</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-neutral-200 bg-neutral-50 text-[10px] font-bold uppercase text-neutral-500">
                    <th class="py-2.5 px-3">N° Letra</th>
                    <th class="py-2.5 px-3">Amortización</th>
                    <th class="py-2.5 px-3">Interés</th>
                    <th class="py-2.5 px-3">Cuota</th>
                    <th class="py-2.5 px-3 text-right">Saldo Capital</th>
                  </tr>
                </thead>
                <tbody id="sc-schedule-body" class="divide-y divide-neutral-100 font-mono text-xs">
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const capInput = document.getElementById("sc-capital") as HTMLInputElement | null;
  const monthsSel = document.getElementById("sc-months") as HTMLSelectElement | null;
  const teaSel = document.getElementById("sc-tea") as HTMLSelectElement | null;
  const lateRange = document.getElementById("sc-late-days") as HTMLInputElement | null;
  const lateLabel = document.getElementById("sc-late-label");
  const baseQuotaEl = document.getElementById("sc-base-quota");
  const lateFeeEl = document.getElementById("sc-late-fee");
  const totalPayEl = document.getElementById("sc-total-pay");
  const tbody = document.getElementById("sc-schedule-body");

  function fmt(n: number) {
    return "S/ " + n.toLocaleString("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function renderSchedule() {
    const capital = Math.max(1000, Number(capInput?.value || 54000));
    const n = Number(monthsSel?.value || 36);
    const tea = Number(teaSel?.value || 0) / 100;
    const lateDays = Number(lateRange?.value || 0);

    if (lateLabel) lateLabel.textContent = `${lateDays} días`;

    // Tasa efectiva mensual (TEM) a partir de TEA
    const tem = tea > 0 ? Math.pow(1 + tea, 1 / 12) - 1 : 0;
    const quota = tem > 0
      ? (capital * tem * Math.pow(1 + tem, n)) / (Math.pow(1 + tem, n) - 1)
      : capital / n;

    const mora = quota * 0.0015 * lateDays;
    const total = quota + mora;

    if (baseQuotaEl) baseQuotaEl.textContent = fmt(quota);
    if (lateFeeEl) lateFeeEl.textContent = fmt(mora);
    if (totalPayEl) totalPayEl.textContent = fmt(total);

    if (tbody) {
      let balance = capital;
      let rows = "";
      const previewCount = Math.min(6, n);
      for (let i = 1; i <= previewCount; i++) {
        const interest = balance * tem;
        const amort = quota - interest;
        balance = Math.max(0, balance - amort);
        rows += `
          <tr class="hover:bg-neutral-50">
            <td class="py-2.5 px-3 font-bold text-neutral-900">LETRA-${String(i).padStart(3, "0")}</td>
            <td class="py-2.5 px-3 text-neutral-700">${fmt(amort)}</td>
            <td class="py-2.5 px-3 text-neutral-500">${fmt(interest)}</td>
            <td class="py-2.5 px-3 font-bold text-accent">${fmt(quota)}</td>
            <td class="py-2.5 px-3 text-right text-neutral-800">${fmt(balance)}</td>
          </tr>
        `;
      }
      tbody.innerHTML = rows;
    }
  }

  [capInput, monthsSel, teaSel, lateRange].forEach((el) => {
    el?.addEventListener("input", renderSchedule);
    el?.addEventListener("change", renderSchedule);
  });

  renderSchedule();
</script>
