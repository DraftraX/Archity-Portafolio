    externalLabel: "Probar Consola Emisora SUNAT ↗",
    tags: ["SUNAT UBL 2.1", "XMLDSig RSA-SHA256", "Consola Front-End", "SDK Python/TS/PHP"],
    screenTitle: "Consola Emisora Electrónica · Facturas, Boletas & CDR",
    screenTheme: "dark-sky",
    metrics: [
      { k: "Estándar", v: "OASIS UBL 2.1" },
