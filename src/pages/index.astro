    screenTitle: "Circuito Clínico de Hemoterapia & Donación",
    screenTheme: "dark-red",
    metrics: [
      { k: "Cobertura", v: "15 Áreas Clínicas" },
      { k: "Nivel", v: "Banco Tipo II" },
      { k: "Red Regional", v: "Hemored Loreto" },
    ],
  },
  {
    num: "07",
    slug: "restorant-system",
    date: "GITHUB · RESTORANT_SYSTEM",
    title: "RestoManager 3D",
    subtitle: "Sistema de Restobar con Plano de Salón 3D Three.js",
    description:
      "Sistema operativo gastronómico full-stack (Astro 5 SSR + React 18 + Three.js / React Three Fiber + Express + SQLite3): diseñador de salón interactivo en 3D (12m × 10m), rutas de evacuación animadas CatmullRom, carta digital con video HD bilingüe (PEN/USD), descuento atómico de insumos por receta y panel Kanban JWT.",
    logo: "/logos/restory-logo.png",
    mark: "/logos/restory-logo.png",
    bgColor: "var(--ca-ink)",
    darkText: false,
    tabMargin: "min(calc(40% - 32px), calc(100% - 280px))",
    firstTab: false,
    internalUrl: "/productos/restorant-system",
    externalUrl: "https://github.com/DraftraX/restorant_system",
    repoUrl: "https://github.com/DraftraX/restorant_system",
