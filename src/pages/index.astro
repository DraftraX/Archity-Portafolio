      <div class="px-4 pb-20 pt-10 sm:px-8 lg:px-20">
        <div class="relative mx-auto max-w-4xl">
          <!-- Tarjeta de comentario azul claro pegada con cintas en la esquina superior izquierda -->
          <div class="relative z-20 mb-6 flex justify-center lg:absolute lg:-left-16 lg:-top-12 lg:mb-0 lg:block lg:w-80">
            <div class="relative w-full max-w-sm -rotate-2 bg-[var(--ca-cyan)] p-5 pt-6 shadow-[2px_6px_18px_rgba(17,18,18,0.22)]">
              <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-pink-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <div class="flex items-start gap-3">
                <span class="h-10 w-10 shrink-0 overflow-hidden rounded-full bg-white p-1.5 border border-[var(--ca-ink)]">
                  <img src="/logos/altoplanta-symbol.svg" alt="Archity" loading="lazy" class="h-full w-full object-contain" />
                </span>
                <div>
                  <p class="font-semibold text-[var(--ca-ink)]">Archity Software Studio</p>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--ca-ink)]/80">
