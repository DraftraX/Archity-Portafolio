const tapeLogos = [
  { name: "AltoPlanta", src: "/logos/altoplanta-logo.svg", bg: "var(--ca-yellow-soft)", rot: "-rotate-2", href: "/productos/altoplanta" },
  { name: "Grupo Pineda", src: "/logos/grupo-pineda-logo.svg", bg: "var(--ca-mint)", rot: "rotate-1", href: "/productos/grupo-pineda" },
  { name: "Inmobiliaria Flamingo", src: "/logos/flamingo-logo.png", bg: "var(--ca-pink-soft)", rot: "rotate-2", href: "/productos/proyect-flamingo" },
  { name: "Vinkula CRM", src: "/logos/vinkula-logo.svg", bg: "var(--ca-cyan)", rot: "-rotate-1", href: "/productos/vinkula" },
  { name: "Sencillo FinTech", src: "/logos/sencillo-logo.svg", bg: "var(--ca-yellow-soft)", rot: "-rotate-2", href: "/productos/sencillo" },
  { name: "Banco de Sangre Loreto", src: "/logos/bankblood-logo.png", bg: "var(--ca-mint)", rot: "rotate-1", href: "/productos/bank-blood" },
  { name: "RestoManager 3D", src: "/logos/restory-logo.png", bg: "var(--ca-cyan)", rot: "-rotate-1", href: "/productos/restorant-system" },
  { name: "Archity Billing SUNAT", src: "/logos/billing-logo.svg", bg: "var(--ca-pink-soft)", rot: "rotate-2", href: "/productos/billing-service" },
];
---

<Layout>
  <!-- Splash introductorio estilo Crayon -->
  <div class="ca-splash ca-grid pointer-events-none fixed inset-0 z-[80] grid place-items-center" aria-hidden="true">
    <span class="ca-splash-b1 col-start-1 row-start-1 rounded-2xl rounded-tl-none border-2 border-[var(--ca-ink)] bg-[var(--ca-yellow)] px-5 py-3 text-3xl font-medium leading-[1.1] text-[var(--ca-ink)] sm:text-[2.5rem]">
      Oh, hello!
    </span>
    <span class="ca-splash-b2 col-start-1 row-start-1 rounded-2xl rounded-tl-none border-2 border-[var(--ca-ink)] bg-[var(--ca-yellow)] px-5 py-3 text-3xl font-medium leading-[1.1] text-[var(--ca-ink)] sm:text-[2.5rem]">
      Welcome to Archity!
    </span>
  </div>

  <Header />

  <main>
    <!-- ==================== HERO SECTION (Idéntico a Crayon diciendo ARCHITY) ==================== -->
    <section class="ca-grid relative flex flex-col justify-center overflow-hidden px-4 min-h-[88svh] pb-14 pt-6 sm:pb-20">
      <!-- Medallones circulares flotantes con borde naranja como en el diseño original -->
      <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
        <div class="absolute left-[11%] top-[50%]">
          <span class="flex items-center justify-center rounded-full bg-[var(--ca-orange)] p-1.5 h-20 w-20 -rotate-6 shadow-md">
            <span class="relative overflow-hidden h-full w-full rounded-full bg-white flex items-center justify-center p-2.5">
              <img src="/logos/altoplanta-symbol.svg" alt="" loading="lazy" class="h-full w-full object-contain" />
            </span>
          </span>
        </div>
        <div class="absolute right-[11%] top-[54%]">
          <span class="flex items-center justify-center rounded-full bg-[var(--ca-orange)] p-1.5 h-20 w-20 rotate-6 shadow-md">
            <span class="relative overflow-hidden h-full w-full rounded-full bg-white flex items-center justify-center p-2">
              <img src="/logos/flamingo-logo.png" alt="" loading="lazy" class="h-full w-full object-contain" />
            </span>
          </span>
        </div>
      </div>

      <div class="relative mx-auto flex max-w-5xl flex-col items-center pt-2 text-center sm:pt-4">
        <div class="group/name relative flex w-full flex-col items-center">
          <!-- "my name is" con doble subrayado dibujado a mano -->
          <div class="flex flex-col items-center text-[var(--ca-ink)]">
            <p class="ca-hand text-2xl sm:text-3xl">my name is</p>
            <svg viewBox="0 0 64 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="mt-1 h-3 w-20" aria-hidden="true">
              <path d="M3 4c18-3 40-3 58 0"></path>
              <path d="M9 9c14-2.5 32-2.5 46 0"></path>
            </svg>
          </div>

          <!-- Píldoras superiores en móvil -->
          <div class="mt-4 flex flex-wrap justify-center gap-2 lg:hidden">
            <div class="-rotate-6">
              <span class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]" style="background-color:var(--ca-purple)">
                Made things
              </span>
            </div>
            <div class="rotate-6">
              <span class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]" style="background-color:var(--ca-yellow-soft)">
                Sweat the details
              </span>
            </div>
          </div>

          <!-- Caja central naranja dibujada a mano con ARCHITY en fuente Handjet -->
          <div class="relative mt-5">
            <div class="ca-doodle-box relative inline-block border-[3px] px-6 py-1.5 sm:px-11 sm:py-2.5" style="border-color:var(--ca-orange)">
              <span class="ca-display text-[20vw] leading-[0.92] tracking-tight text-[var(--ca-ink)] sm:text-9xl lg:text-[10.8rem] select-none" style="display:inline-block">
                ARCHITY
              </span>
            </div>

            <!-- Etiquetas flotantes y flechas dibujadas a mano en escritorio -->
            <div class="pointer-events-none absolute -inset-x-24 -inset-y-6 hidden lg:block">
              <div class="absolute inset-0">
                <div class="pointer-events-auto absolute left-0 top-0 -translate-x-1/3 -translate-y-1/2 -rotate-12">
                  <span class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]" style="background-color:var(--ca-purple)">
                    Made things
                  </span>
                </div>
                <div class="pointer-events-auto absolute right-0 top-0 -translate-y-1/2 translate-x-1/3 rotate-12">
                  <span class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]" style="background-color:var(--ca-yellow-soft)">
                    Sweat the details
                  </span>
                </div>
              </div>

              <!-- Nota amarilla inferior izquierda con flecha curva -->
              <div class="pointer-events-auto absolute bottom-0 left-0 -translate-x-1/3 translate-y-1/2 -rotate-6">
                <span class="relative inline-block">
                  <span class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-2xl" style="background-color:var(--ca-yellow)">
                    Software Studio &amp; SaaS
                  </span>
                  <svg viewBox="0 0 40 40" fill="none" stroke="var(--ca-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="absolute -right-7 -top-4 h-8 w-8 -scale-x-100" aria-hidden="true">
                    <path d="M34 33 C 25 24, 15 21, 9 9"></path>
                    <path d="M8 21 L 7 7 L 21 11"></path>
                  </svg>
                </span>
              </div>

              <!-- Nota menta inferior derecha con flecha curva -->
              <div class="pointer-events-auto absolute bottom-0 right-0 translate-x-1/3 translate-y-1/2 rotate-3">
                <span class="relative inline-block">
                  <svg viewBox="0 0 40 40" fill="none" stroke="var(--ca-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="absolute -left-6 -top-6 h-8 w-8" aria-hidden="true">
                    <path d="M34 33 C 25 24, 15 21, 9 9"></path>
                    <path d="M8 21 L 7 7 L 21 11"></path>
                  </svg>
                  <span class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-2xl" style="background-color:var(--ca-mint)">
                    Perú · Cloud &amp; IA
                  </span>
                </span>
              </div>
            </div>
          </div>

          <p class="ca-mono mt-6 inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--ca-ink)] sm:text-sm">
            <span class="h-3 w-3 rounded-full bg-[var(--ca-blue)]"></span>
            Open to new work and good problems
          </p>

          <!-- Efecto de selección estilo Figma al pasar el cursor sobre ARCHITY -->
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 z-30 hidden h-64 w-64 -translate-x-1/2 -translate-y-1/2 scale-[0.35] opacity-0 transition-[opacity,scale] duration-300 ease-out [backdrop-filter:invert(1)] group-hover/name:scale-100 group-hover/name:opacity-100 lg:block">
            <span class="absolute -left-2 -top-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -right-2 -top-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -bottom-2 -left-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -bottom-2 -right-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
          </span>
        </div>

        <!-- Notas inferiores en móvil -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 lg:hidden">
          <span class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-xl -rotate-3" style="background-color:var(--ca-yellow)">
            Software Studio &amp; SaaS
          </span>
          <span class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-xl rotate-3" style="background-color:var(--ca-mint)">
            Perú · Cloud &amp; IA
          </span>
        </div>

        <!-- Titular principal con el icono verde giratorio y la flor magenta giratoria -->
        <h1 class="mt-10 max-w-3xl text-4xl font-semibold leading-[1.15] tracking-tight text-[var(--ca-ink)] sm:mt-14 sm:text-6xl">
          <span>
            I design software that{" "}
            <svg viewBox="0 0 40 40" class="inline-block align-[-0.08em] ca-spin-slow h-[0.85em] w-[0.85em]" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="var(--ca-green)" stroke="var(--ca-ink)" stroke-width="2"></circle>
              <circle cx="20" cy="20" r="11" fill="var(--ca-surface)"></circle>
              <circle cx="20" cy="20" r="5" fill="var(--ca-green)"></circle>
              <circle cx="14" cy="9" r="2.4" fill="var(--ca-ink)"></circle>
            </svg>{" "}
            gets out of your way.{" "}
            <svg viewBox="0 0 40 40" class="inline-block align-[-0.08em] ca-spin-slow h-[0.85em] w-[0.85em]" aria-hidden="true">
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(0 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(45 20 20)"></ellipse>
