---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Las 8 carpetas = los 8 proyectos reales trabajados por el usuario, cada uno con su logo oficial, enlaces reales y diseño de carpeta Crayon
const projects = [
  {
    num: "01",
    slug: "altoplanta",
    date: "PROD · ALTOPLANTA.COM",
    title: "AltoPlanta",
    subtitle: "SaaS PropTech, Cartografía CAD (.DXF) & Tours 360°",
    description:
      "Plataforma SaaS inmobiliaria líder en Perú: transforma planos de ingeniería AutoCAD (.DXF) en mapas interactivos georreferenciados sobre Google Maps JS API, con vuelos de cámara van Wijk, recorridos virtuales 360°, 8 temas de portales White-Label, pagos divididos con Mercado Pago Marketplace y app Android GPS.",
    logo: "/logos/altoplanta-logo.svg",
    mark: "/logos/altoplanta-symbol.svg",
    bgColor: "var(--ca-blue)",
    darkText: false,
    tabMargin: "0%",
    firstTab: true,
    internalUrl: "/productos/altoplanta",
    externalUrl: "https://altoplanta.com/",
    externalLabel: "altoplanta.com ↗",
    tags: ["SaaS PropTech", "Google Maps + CAD", "Tours 360°", "Mercado Pago"],
    screenTitle: "GIS & CAD Engine · altoplanta.com",
    screenTheme: "dark-emerald",
    metrics: [
      { k: "Motor GIS", v: "Google Maps + DXF" },
      { k: "Portales", v: "8 Temas White-Label" },
      { k: "Campo", v: "App Android GPS" },
