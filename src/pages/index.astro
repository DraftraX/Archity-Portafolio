      { k: "Inventario", v: "Recetas con Rollback" },
      { k: "Seguridad", v: "Rutas CatmullRom" },
    ],
  },
  {
    num: "08",
    slug: "billing-service",
    date: "SUNAT · UBL 2.1 + FRONT-END",
    title: "Archity Billing SUNAT",
    subtitle: "Microservicio Multi-Tenant & Consola Emisora UBL 2.1",
    description:
      "Motor de Facturación Electrónica SUNAT (Perú) en Django 5 + DRF + Celery + Redis con Consola Front-End Interactiva: emite Facturas (01), Boletas (03), Notas de Crédito (07) y Débito (08), firma XMLDSig (RSA-SHA256) con certificados .pfx cifrados en AES-256 Fernet, envía por SOAP a SUNAT/OSE, genera PDF QR y ofrece SDKs en Python, Node y PHP.",
    logo: "/logos/billing-logo.svg",
    mark: "/logos/billing-mark.svg",
