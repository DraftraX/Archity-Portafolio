---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LetsTalkSection from "../components/LetsTalkSection.astro";
import Footer from "../components/Footer.astro";
import {
  heroData,
  bioData,
  projectsData,
  trustedClients,
} from "../data/portfolioData";

const splashBubble1 = Array.from("Oh, hello!").map((ch, i) => ({
  ch: ch === " " ? "\u00A0" : ch,
  d: `${(0.15 + 0.045 * i).toFixed(3)}s`,
}));

const splashBubble2 = Array.from("You found me!").map((ch, i) => ({
  ch: ch === " " ? "\u00A0" : ch,
  d: `${(0.95 + 0.045 * i).toFixed(3)}s`,
}));

const rippedClips = [
  "polygon(2% 6%, 12% 0%, 25% 4%, 40% 1%, 55% 5%, 70% 0%, 85% 4%, 98% 1%, 96% 15%, 100% 30%, 97% 45%, 100% 60%, 96% 75%, 99% 90%, 97% 98%, 85% 96%, 70% 100%, 55% 96%, 40% 100%, 25% 95%, 12% 100%, 3% 97%, 1% 85%, 4% 70%, 0% 55%, 3% 40%, 0% 25%, 2% 12%)",
  "polygon(1% 8%, 10% 2%, 22% 6%, 35% 0%, 48% 5%, 62% 1%, 76% 6%, 90% 1%, 99% 6%, 97% 20%, 100% 35%, 98% 50%, 100% 66%, 97% 80%, 99% 94%, 88% 98%, 74% 94%, 60% 99%, 46% 95%, 32% 100%, 18% 96%, 6% 99%, 2% 88%, 5% 74%, 1% 60%, 4% 46%, 0% 32%, 3% 18%)",
  "polygon(3% 3%, 16% 1%, 28% 5%, 44% 0%, 58% 4%, 72% 1%, 84% 5%, 97% 2%, 100% 18%, 96% 32%, 100% 48%, 97% 64%, 100% 80%, 96% 94%, 98% 99%, 84% 95%, 68% 100%, 52% 96%, 38% 100%, 22% 95%, 8% 99%, 1% 92%, 4% 78%, 0% 62%, 3% 48%, 0% 34%, 4% 20%, 1% 8%)",
];
---

<Layout title="Archity — Home">
  <!-- Splash introductorio letra por letra idéntico a creative-artsy -->
  <div
    class="ca-splash ca-grid pointer-events-none fixed inset-0 z-[80] grid place-items-center"
    aria-hidden="true"
  >
    <span class="ca-splash-b1 col-start-1 row-start-1 rounded-2xl rounded-tl-none border-2 border-[var(--ca-ink)] bg-[var(--ca-yellow)] px-4 py-3 text-3xl font-medium leading-[1.1] text-[var(--ca-ink)] sm:text-[2.5rem]">
      {
        splashBubble1.map((item) => (
          <span class="ca-splash-char inline-block" style={`animation-delay:${item.d}`}>
            {item.ch}
          </span>
        ))
      }
    </span>
    <span class="ca-splash-b2 col-start-1 row-start-1 rounded-2xl rounded-tl-none border-2 border-[var(--ca-ink)] bg-[var(--ca-yellow)] px-4 py-3 text-3xl font-medium leading-[1.1] text-[var(--ca-ink)] sm:text-[2.5rem]">
      {
        splashBubble2.map((item) => (
          <span class="ca-splash-char inline-block" style={`animation-delay:${item.d}`}>
            {item.ch}
          </span>
        ))
      }
    </span>
  </div>

  <Header />

  <main>
    <!-- ==================== 1. HERO SECTION ==================== -->
    <section class="ca-grid relative flex flex-col justify-center overflow-hidden px-4 min-h-[100svh] pb-12 pt-4 sm:pb-16">
      <!-- Medallones flotantes con fotos simples y limpias -->
      <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
        <div class="ca-float-left absolute left-[12%] top-[52%]">
          <span class="flex items-center justify-center rounded-full bg-[var(--ca-orange)] p-1.5 h-20 w-20">
            <span class="relative overflow-hidden h-full w-full rounded-full">
              <img src={heroData.media0} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            </span>
          </span>
        </div>
        <div class="ca-float-right absolute right-[12%] top-[56%]">
          <span class="flex items-center justify-center rounded-full bg-[var(--ca-orange)] p-1.5 h-20 w-20">
            <span class="relative overflow-hidden h-full w-full rounded-full">
              <img src={heroData.media1} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            </span>
          </span>
        </div>
      </div>

      <div class="relative mx-auto flex max-w-5xl flex-col items-center pt-1 text-center sm:pt-2">
        <!-- Zona con el Cuadro que Invierte los Colores ([backdrop-filter:invert(1)]) -->
        <div
          data-invert-zone
          class="ca-invert-zone group/name relative flex w-full flex-col items-center"
        >
          <div class="flex flex-col items-center text-[var(--ca-ink)]">
            <p class="ca-hand text-2xl sm:text-3xl" data-es={heroData.labelEs} data-en={heroData.labelEn}>
              {heroData.labelEs}
            </p>
            <svg viewBox="0 0 64 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="mt-1 h-3 w-20" aria-hidden="true">
              <path d="M3 4c18-3 40-3 58 0"></path>
              <path d="M9 9c14-2.5 32-2.5 46 0"></path>
            </svg>
          </div>

          <!-- Píldoras en móvil que caen desde arriba -->
          <div class="mt-4 flex flex-wrap justify-center gap-2 lg:hidden">
            <div class="ca-drop-note -rotate-6" style="animation-delay: 2.10s">
              <span
                class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]"
                style="background-color:var(--ca-purple)"
                data-es={heroData.pill1Es}
                data-en={heroData.pill1En}
              >
                {heroData.pill1Es}
              </span>
            </div>
            <div class="ca-drop-note rotate-6" style="animation-delay: 2.22s">
              <span
                class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]"
                style="background-color:var(--ca-yellow-soft)"
                data-es={heroData.pill2Es}
                data-en={heroData.pill2En}
              >
                {heroData.pill2Es}
              </span>
            </div>
          </div>

          <!-- Caja central con borde SVG que se dibuja en vivo y letras de ARCHITY que caen -->
          <div class="relative mt-5">
            <div class="ca-doodle-box relative inline-block px-5 py-1 sm:px-10 sm:py-2">
              <!-- Borde naranja que se dibuja en vivo con trazo tipo dibujo -->
              <svg
                class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M 4 4 C 25 1, 75 1, 96 4 C 99 20, 99 80, 96 96 C 75 99, 25 99, 4 96 C 1 80, 1 20, 4 4 Z"
                  fill="none"
                  stroke="var(--ca-orange)"
                  stroke-width="3"
                  vector-effect="non-scaling-stroke"
                  class="ca-draw-border"
                />
              </svg>

              <!-- Letras de ARCHITY que caen una por una para verse -->
              <span class="ca-display text-[22vw] leading-[0.95] tracking-tight text-[var(--ca-ink)] sm:text-9xl lg:text-[12rem] inline-block select-none">
                {
                  Array.from("ARCHITY").map((letter, i) => (
                    <span
                      class="ca-drop-letter inline-block"
                      style={`animation-delay:${(1.75 + i * 0.08).toFixed(2)}s`}
                    >
                      {letter}
                    </span>
                  ))
                }
              </span>
            </div>

            <!-- Etiquetas flotantes y notas adhesivas en escritorio que caen desde arriba -->
            <div class="pointer-events-none absolute -inset-x-24 -inset-y-6 hidden lg:block">
              <div class="absolute inset-0">
                <div class="ca-drop-note pointer-events-auto absolute left-0 top-0 -translate-x-1/2 -translate-y-1/2 -rotate-8" style="animation-delay: 2.20s">
                  <span
                    class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]"
                    style="background-color:var(--ca-purple)"
                    data-es={heroData.pill1Es}
                    data-en={heroData.pill1En}
                  >
                    {heroData.pill1Es}
                  </span>
                </div>
                <div class="ca-drop-note pointer-events-auto absolute right-0 top-0 -translate-y-1/2 translate-x-1/2 rotate-6" style="animation-delay: 2.32s">
                  <span
                    class="ca-mono inline-block rounded-full border-[3px] border-white px-4 py-1.5 text-sm font-bold uppercase tracking-widest text-[var(--ca-ink)] shadow-[0_4px_10px_rgba(25,21,16,0.25)]"
                    style="background-color:var(--ca-yellow-soft)"
                    data-es={heroData.pill2Es}
                    data-en={heroData.pill2En}
                  >
                    {heroData.pill2Es}
                  </span>
                </div>
              </div>

              <div class="ca-drop-note pointer-events-auto absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 -rotate-4" style="animation-delay: 2.45s">
                <span class="relative inline-block">
                  <span
                    class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-2xl"
                    style="background-color:var(--ca-yellow)"
                    data-es={heroData.roleEs}
                    data-en={heroData.roleEn}
                  >
                    {heroData.roleEs}
                  </span>
                  <svg viewBox="0 0 40 40" fill="none" stroke="var(--ca-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="absolute -right-7 -top-4 h-8 w-8 -scale-x-100" aria-hidden="true">
                    <path d="M34 33 C 25 24, 15 21, 9 9"></path>
                    <path d="M8 21 L 7 7 L 21 11"></path>
                  </svg>
                </span>
              </div>

              <div class="ca-drop-note pointer-events-auto absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 rotate-2" style="animation-delay: 2.58s">
                <span class="relative inline-block">
                  <svg viewBox="0 0 40 40" fill="none" stroke="var(--ca-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="absolute -left-6 -top-6 h-8 w-8" aria-hidden="true">
                    <path d="M34 33 C 25 24, 15 21, 9 9"></path>
                    <path d="M8 21 L 7 7 L 21 11"></path>
                  </svg>
                  <span
                    class="ca-hand inline-block px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-2xl"
                    style="background-color:var(--ca-mint)"
                    data-es={heroData.locationEs}
                    data-en={heroData.locationEn}
                  >
                    {heroData.locationEs}
                  </span>
                </span>
              </div>
            </div>
          </div>

          <p class="ca-mono mt-6 inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--ca-ink)] sm:text-sm">
            <span class="h-3 w-3 rounded-full bg-[var(--ca-blue)]"></span>
            <span data-es={heroData.statusEs} data-en={heroData.statusEn}>
              {heroData.statusEs}
            </span>
          </p>

          <!-- Cuadro inversor de colores interactivo con las 4 esquinas negras -->
          <span
            aria-hidden="true"
            data-cursor-lens
            class="ca-cursor-lens pointer-events-none absolute left-1/2 top-1/2 z-30 hidden h-72 w-72 -translate-x-1/2 -translate-y-1/2 scale-[0.35] opacity-0 transition-[opacity,scale] duration-300 ease-out group-hover/name:scale-100 group-hover/name:opacity-100 lg:block"
            style="backdrop-filter: invert(1); -webkit-backdrop-filter: invert(1);"
          >
            <!-- Inversión garantizada en todos los navegadores mediante mix-blend-difference -->
            <span class="absolute inset-0 bg-white mix-blend-difference"></span>
            <span class="absolute -left-2 -top-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -right-2 -top-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -bottom-2 -left-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
            <span class="absolute -bottom-2 -right-2 h-4 w-4 bg-[var(--ca-ink)]"></span>
          </span>
        </div>

        <!-- Notas de rol y ubicación en móvil -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-5 lg:hidden">
          <span
            class="ca-hand inline-block -rotate-3 px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-xl sm:text-2xl"
            style="background-color:var(--ca-yellow)"
            data-es={heroData.roleEs}
            data-en={heroData.roleEn}
          >
            {heroData.roleEs}
          </span>
          <span
            class="ca-hand inline-block rotate-2 px-4 py-2 leading-snug text-[var(--ca-ink)] shadow-[2px_3px_8px_rgba(17,18,18,0.18)] text-xl sm:text-2xl"
            style="background-color:var(--ca-mint)"
            data-es={heroData.locationEs}
            data-en={heroData.locationEn}
          >
            {heroData.locationEs}
          </span>
        </div>

        <h1 class="mt-10 max-w-3xl text-4xl font-semibold leading-[1.15] tracking-tight text-[var(--ca-ink)] sm:mt-14 sm:text-6xl">
          <span>
            <span data-es={heroData.titlePart1Es} data-en={heroData.titlePart1En}>{heroData.titlePart1Es}</span>
            <svg viewBox="0 0 40 40" class="inline-block align-[-0.08em] ca-spin-slow h-[0.85em] w-[0.85em]" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="var(--ca-green)" stroke="var(--ca-ink)" stroke-width="2"></circle>
              <circle cx="20" cy="20" r="11" fill="var(--ca-surface)"></circle>
              <circle cx="20" cy="20" r="5" fill="var(--ca-green)"></circle>
              <circle cx="14" cy="9" r="2.4" fill="var(--ca-ink)"></circle>
            </svg>{" "}
            <span data-es={heroData.titlePart2Es} data-en={heroData.titlePart2En}>{heroData.titlePart2Es}</span>{" "}
            <svg viewBox="0 0 40 40" class="inline-block align-[-0.08em] ca-spin-slow h-[0.85em] w-[0.85em]" aria-hidden="true">
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(0 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(45 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(90 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(135 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(180 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(225 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(270 20 20)"></ellipse>
              <ellipse cx="20" cy="8" rx="4.6" ry="8" fill="var(--ca-magenta)" transform="rotate(315 20 20)"></ellipse>
              <circle cx="20" cy="20" r="4" fill="var(--ca-ink)"></circle>
            </svg>
          </span>
        </h1>

        <a
          class="group/cta ca-mono relative mt-9 inline-flex items-center gap-3 border-2 border-[var(--ca-ink)] bg-[var(--ca-ink)] py-2.5 pl-2.5 pr-6 text-sm font-bold uppercase tracking-[0.2em] text-white transition-colors duration-200 hover:bg-transparent hover:text-[var(--ca-ink)]"
          href="/contact"
        >
          <span class="flex h-9 w-9 items-center justify-center bg-[var(--ca-blue)] text-[var(--ca-ink)] transition-colors duration-200 group-hover/cta:bg-[var(--ca-magenta)] group-hover/cta:text-[var(--ca-blue)]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="h-4 w-4" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </span>
          <span data-es={heroData.ctaEs} data-en={heroData.ctaEn}>{heroData.ctaEs}</span>
        </a>
      </div>
    </section>

    <!-- ==================== 2. HOME ABOUT TEASER ("about me!" + "what's up" + 4 Skill Chips) ==================== -->
    <section id="about" class="ca-grid relative scroll-mt-24 px-4 pb-20 sm:pb-28">
      <svg viewBox="0 0 1440 130" fill="none" preserveAspectRatio="none" class="h-16 sm:h-24 -mx-4 w-[calc(100%+2rem)]" aria-hidden="true">
        <path d="M-10 120C420 10 1030 4 1450 80" stroke="var(--ca-tick)" stroke-width="1.5"></path>
      </svg>

      <p
        class="ca-hand pl-[8%] text-2xl text-[var(--ca-ink)] sm:text-3xl"
        data-es={bioData.labelEs}
        data-en={bioData.labelEn}
      >
        {bioData.labelEs}
      </p>

      <!-- Polaroids laterales en escritorio -->
      <div class="pointer-events-none absolute inset-0 z-0 hidden lg:block">
        <div class="absolute left-[3%] top-[36%] w-56 xl:left-[5%] xl:w-64 -rotate-6">
          <figure class="pointer-events-auto relative inline-block w-full bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)]">
            <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
            <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
            <div class="aspect-[4/5] w-full overflow-hidden">
              <img src={bioData.photo0.src} alt={bioData.photo0.captionEn} loading="lazy" class="h-full w-full object-cover" />
            </div>
            <figcaption class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70">
              {bioData.photo0.captionEs}
            </figcaption>
          </figure>
        </div>

        <div class="absolute right-[3%] top-[20%] w-56 xl:right-[5%] xl:w-64 rotate-6">
          <figure class="pointer-events-auto relative inline-block w-full bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)]">
            <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
            <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
            <div class="aspect-[4/5] w-full overflow-hidden">
              <img src={bioData.photo1.src} alt={bioData.photo1.captionEn} loading="lazy" class="h-full w-full object-cover" />
            </div>
            <figcaption
              class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70"
              data-es={bioData.photo1.captionEs}
              data-en={bioData.photo1.captionEn}
            >
              {bioData.photo1.captionEs}
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="relative z-10 mx-auto mt-10 max-w-5xl sm:mt-16">
        <div class="flex flex-col items-center text-center">
          <div class="ca-doodle-box relative inline-block border-2 px-5 py-2" style="border-color:var(--ca-ink)">
            <span
              class="text-3xl font-medium text-[var(--ca-ink)] sm:text-4xl"
              data-es={bioData.badgeEs}
              data-en={bioData.badgeEn}
            >
              {bioData.badgeEs}
            </span>
          </div>

          <div class="mt-10">
            <p class="ca-hand mx-auto max-w-3xl text-3xl font-medium leading-[1.2] text-[var(--ca-ink)] sm:text-4xl lg:text-5xl">
              <span data-es={bioData.bodyPart1Es} data-en={bioData.bodyPart1En}>{bioData.bodyPart1Es}</span>{" "}
              <span aria-hidden="true">✨</span>{" "}
              <span data-es={bioData.bodyPart2Es} data-en={bioData.bodyPart2En}>{bioData.bodyPart2Es}</span>{" "}
              <span aria-hidden="true">🎨</span>
            </p>
          </div>

          <!-- Polaroids en móvil -->
          <div class="mt-10 flex justify-center gap-6 lg:hidden">
            <figure class="relative inline-block bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)] -rotate-3 w-40">
              <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <div class="aspect-[4/5] w-full overflow-hidden">
                <img src={bioData.photo0.src} alt="2026" loading="lazy" class="h-full w-full object-cover" />
              </div>
              <figcaption class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70">2026</figcaption>
            </figure>

            <figure class="relative inline-block bg-white p-2 pb-1 shadow-[0_6px_18px_rgba(17,18,18,0.22)] rotate-3 w-40">
              <span aria-hidden="true" class="absolute -left-4 -top-2 z-10 h-5 w-16 -rotate-[38deg] bg-[var(--ca-cyan)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <span aria-hidden="true" class="absolute -right-4 -top-2 z-10 h-5 w-16 rotate-[38deg] bg-[var(--ca-yellow-soft)]/70 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
              <div class="aspect-[4/5] w-full overflow-hidden">
                <img src={bioData.photo1.src} alt="my workspace" loading="lazy" class="h-full w-full object-cover" />
              </div>
              <figcaption
                class="ca-hand mt-1 text-center text-lg leading-tight text-[var(--ca-ink)]/70"
                data-es={bioData.photo1.captionEs}
                data-en={bioData.photo1.captionEn}
              >
                {bioData.photo1.captionEs}
              </figcaption>
            </figure>
          </div>

          <!-- Las 4 etiquetas rasgadas con emojis intercambiables (Interaction Design ✨🎨, Prototyping 🎨🧩, User Research 🧩👀, Motion Design 👀💡) -->
          <div class="mt-12 flex max-w-3xl flex-wrap items-center justify-center gap-3 sm:mt-14">
            {
              bioData.skills.map((skill, idx) => (
                <div class="flex items-center gap-3">
                  <span
                    class={`inline-flex h-14 items-center px-6 text-2xl font-semibold tracking-tight sm:h-[4.5rem] sm:px-8 sm:text-3xl ${
