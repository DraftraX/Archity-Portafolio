  },
  {
    num: "02",
    slug: "grupo-pineda",
    date: "PROD · GRUPOPINEDA.PE",
    title: "ERP Grupo Pineda",
    subtitle: "ERP Multi-Empresa: Concreto MATEPCO & Cantera ROCAFER",
    description:
      "Sistema ERP industrial para el consorcio líder del nororiente peruano: automatización de plantas dosificadoras de concreto premezclado MATEPCO (Tarapoto, Moyobamba y Chachapoyas), telemetría de balanza en cantera chancadora ROCAFER (780 TM/día), maquinaria pesada SERVIPIPA y distribuidora PRINCOR.",
    logo: "/logos/grupo-pineda-logo.svg",
    mark: "/logos/grupo-pineda-mark.svg",
    extraLogos: ["/logos/matepco-logo.svg", "/logos/rocafer-logo.svg"],
    bgColor: "var(--ca-ink)",
    darkText: false,
    tabMargin: "min(calc(16% - 32px), calc(100% - 280px))",
    firstTab: false,
