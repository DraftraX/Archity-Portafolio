<script>
  // 1. Seguimiento suave del cursor para el cuadrado negro de inversión ([data-invert-zone])
  const setupLensTracking = (zoneSelector: string, lensSelector: string) => {
    const zones = document.querySelectorAll<HTMLElement>(zoneSelector);
    zones.forEach((zone) => {
      const lens = zone.querySelector<HTMLElement>(lensSelector);
      if (!lens) return;

      let targetX = zone.clientWidth / 2;
      let targetY = zone.clientHeight / 2;
      let currentX = targetX;
      let currentY = targetY;
      let rafId: number | null = null;

      const updatePosition = () => {
        currentX += (targetX - currentX) * 0.24;
        currentY += (targetY - currentY) * 0.24;
        lens.style.left = `${currentX}px`;
        lens.style.top = `${currentY}px`;

        if (Math.abs(targetX - currentX) > 0.4 || Math.abs(targetY - currentY) > 0.4) {
          rafId = requestAnimationFrame(updatePosition);
        } else {
          rafId = null;
        }
      };

      zone.addEventListener("mouseenter", (e) => {
        const rect = zone.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        currentX = targetX;
        currentY = targetY;
        lens.style.left = `${currentX}px`;
        lens.style.top = `${currentY}px`;
        zone.classList.add("is-hovered");
      });

      zone.addEventListener("mousemove", (e) => {
        const rect = zone.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!rafId) {
          rafId = requestAnimationFrame(updatePosition);
        }
      });

      zone.addEventListener("mouseleave", () => {
        zone.classList.remove("is-hovered");
      });
    });
  };

  // Inicializar cuadrado negro de inversión en textos/carita y círculo de inversión "VER/SEE" en proyectos
  setupLensTracking("[data-invert-zone]", "[data-cursor-lens]");
  setupLensTracking("[data-see-zone]", "[data-see-lens]");

  // 2. Mural de Servicios (Playground): arrastrar tarjetas (drag & drop) y zoom (+ / -)
  const muralCards = document.querySelectorAll<HTMLElement>("[data-mural-card]");
  let highestZ = 30;

  muralCards.forEach((card) => {
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let tx = 0;
    let ty = 0;

    card.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      isDragging = true;
      highestZ++;
      card.style.zIndex = String(highestZ);
      startX = e.clientX - tx;
      startY = e.clientY - ty;
      card.setPointerCapture(e.pointerId);
    });

    card.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      tx = e.clientX - startX;
      ty = e.clientY - startY;
      card.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
    });

    card.addEventListener("pointerup", () => {
      isDragging = false;
    });
  });

  const muralStage = document.getElementById("ca-mural-stage");
  const zoomInBtn = document.getElementById("ca-zoom-in");
  const zoomOutBtn = document.getElementById("ca-zoom-out");
  let muralScale = 1;

  zoomInBtn?.addEventListener("click", () => {
    muralScale = Math.min(1.35, +(muralScale + 0.1).toFixed(2));
    if (muralStage) muralStage.style.transform = `scale(${muralScale})`;
  });

  zoomOutBtn?.addEventListener("click", () => {
    muralScale = Math.max(0.75, +(muralScale - 0.1).toFixed(2));
    if (muralStage) muralStage.style.transform = `scale(${muralScale})`;
  });

  // 3. Formulario de Contacto de 2 Pasos (1/2 -> 2/2) como en creative-artsy/contact
  const step1 = document.getElementById("ca-step-1");
  const step2 = document.getElementById("ca-step-2");
  const btnNext = document.getElementById("ca-btn-next");
  const btnBack = document.getElementById("ca-btn-back");
  const contactForm = document.getElementById("ca-contact-form") as HTMLFormElement | null;
  const msgInput = document.getElementById("ca-contact-message") as HTMLTextAreaElement | null;
  const nameInput = document.getElementById("ca-contact-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("ca-contact-email") as HTMLInputElement | null;

  btnNext?.addEventListener("click", () => {
    if (msgInput && !msgInput.value.trim()) {
      msgInput.focus();
      return;
    }
    step1?.classList.add("invisible", "pointer-events-none");
    step2?.classList.remove("invisible", "pointer-events-none");
    nameInput?.focus();
  });

  btnBack?.addEventListener("click", () => {
    step2?.classList.add("invisible", "pointer-events-none");
    step1?.classList.remove("invisible", "pointer-events-none");
    msgInput?.focus();
  });

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const message = msgInput?.value.trim() || "Hola Archity, me gustaría cotizar un proyecto.";
    const name = nameInput?.value.trim() || "Cliente";
    const contact = emailInput?.value.trim() || "";
    const text = `Hola Archity, soy *${name}*${contact ? ` (${contact})` : ""}.\n\n${message}`;
    const waUrl = `https://wa.me/51940771896?text=${encodeURIComponent(text)}`;
    window.open(waUrl, "_blank", "noopener");
  });

  // 4. Botón para repetir la animación de entrada (Splash + Hero)
  const replayBtn = document.getElementById("ca-replay-splash");
  const splashOverlay = document.getElementById("ca-splash-overlay");

  replayBtn?.addEventListener("click", () => {
    if (!splashOverlay) return;
    const parent = splashOverlay.parentElement;
    const clone = splashOverlay.cloneNode(true) as HTMLElement;
    splashOverlay.remove();
    parent?.prepend(clone);

    document.querySelectorAll<HTMLElement>(".ca-hero-char, .ca-hero-item").forEach((el) => {
      const anim = el.style.animationDelay;
      el.style.animation = "none";
      void el.offsetHeight;
      el.style.animation = "";
      el.style.animationDelay = anim;
    });
  });
</script>
