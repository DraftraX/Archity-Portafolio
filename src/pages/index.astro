          >
            <span aria-hidden="true" class="absolute -left-5 -top-3 z-10 h-6 w-28 -rotate-[8deg] bg-white/65 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>
            <span aria-hidden="true" class="absolute -right-5 -top-3 z-10 h-6 w-28 rotate-[8deg] bg-white/65 shadow-[0_1px_3px_rgba(17,18,18,0.15)]"></span>

