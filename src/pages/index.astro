    <span class="ca-splash-b2 col-start-1 row-start-1 rounded-2xl rounded-tl-none border-2 border-[var(--ca-ink)] bg-[var(--ca-yellow)] px-6 py-3.5 text-3xl font-medium leading-[1.1] text-[var(--ca-ink)] shadow-[4px_6px_0_var(--ca-ink)] sm:text-[2.65rem]">
