    screenTheme: "dark-amber",
    metrics: [
      { k: "Cantera Picota", v: "780 TM / Día" },
      { k: "Concreto", v: "3 Plantas MATEPCO" },
      { k: "Seguridad", v: "Device Owner APK" },
    ],
  },
  {
    num: "03",
    slug: "proyect-flamingo",
    date: "VERCEL · PROYECT-FLAMINGO",
    title: "Inmobiliaria Flamingo",
    subtitle: "Showroom Aéreo con Dron, 133 Lotes SVG & Casas 360°",
    description:
      "Showroom web inmersivo para Proyecto Residencial Flamingo: transiciones de vuelo de dron multicapa (0ms crossfade), masterplan vectorial interactivo de 133 lotes en 8 manzanas (Mz K a Mz R), conmutador Día/Noche, 4 modelos de casa (Coral, Brisa, Arena, Flamingo Imperial) con tour 360° y calibrador OpenCV.",
    logo: "/logos/flamingo-logo.png",
    mark: "/logos/flamingo-logo.png",
    bgColor: "var(--ca-yellow)",
