                            <div class="rounded-xl border border-white/15 bg-white/5 p-3">
                              <span class="ca-mono block text-[10px] uppercase tracking-wider text-white/60">{m.k}</span>
                              <strong class="mt-1 block text-xs sm:text-sm font-bold text-white">{m.v}</strong>
                            </div>
                          ))}
                        </div>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- ==================== ECOSISTEMA DE LOGOS EN CINTAS ADHESIVAS (TRUSTED BY) ==================== -->
    <section id="playground" class="ca-grid scroll-mt-24 px-4 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <p class="ca-hand text-center text-3xl text-[var(--ca-ink)] sm:text-4xl">
