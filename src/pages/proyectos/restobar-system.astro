---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const categories = ["Entradas", "Parrillas", "Bebidas", "Postres"];
---

<Layout
  title="Restobar System | Frontend Astro + TypeScript"
  description="Restobar System en modo frontend: catálogo, buscador, carrito/comanda, tipo de pedido y confirmación simulada con persistencia local."
>
  <Header />
  <main>
    <section class="border-b border-neutral-200/70 bg-gradient-to-b from-neutral-50 to-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Restobar System</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">Frontend Astro + TypeScript</h1>
        <p class="mt-4 max-w-2xl text-sm text-neutral-600 sm:text-base">
          Demo temporal sin backend real. Carrito, preferencias y comanda se guardan localmente en el navegador.
        </p>
      </div>
    </section>

    <section class="py-10 sm:py-14">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1.5fr_1fr] lg:px-8">
        <div>
          <div class="flex flex-col gap-3 rounded-2xl border border-neutral-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between">
            <input id="search" type="search" placeholder="Buscar plato..." class="w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm sm:max-w-xs" />
            <div class="flex flex-wrap gap-2">
              <button data-cat="all" class="cat-btn rounded-lg bg-neutral-900 px-3 py-2 text-xs font-semibold text-white">Todo</button>
              {categories.map((cat) => (
                <button data-cat={cat} class="cat-btn rounded-lg border border-neutral-300 px-3 py-2 text-xs font-semibold text-neutral-700">{cat}</button>
              ))}
            </div>
          </div>

          <div id="menu-grid" class="mt-5 grid gap-4 sm:grid-cols-2"></div>
        </div>

        <aside class="space-y-4 rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
          <div class="rounded-xl border border-neutral-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Tipo de pedido</p>
            <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
              <button data-mode="mesa" class="mode-btn rounded-lg bg-neutral-900 px-3 py-2 font-semibold text-white">Mesa</button>
              <button data-mode="delivery" class="mode-btn rounded-lg border border-neutral-300 px-3 py-2 font-semibold text-neutral-700">Delivery</button>
            </div>
            <input id="mode-detail" type="text" placeholder="Mesa #12 o dirección" class="mt-3 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
          </div>

          <div class="rounded-xl border border-neutral-200 bg-white p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Comanda</p>
            <ul id="cart-list" class="mt-3 space-y-2 text-sm"></ul>
            <p id="cart-empty" class="mt-3 text-xs text-neutral-500">Sin productos en carrito.</p>
            <div class="mt-4 border-t border-neutral-200 pt-3 text-sm">
              <p class="flex justify-between"><span>Subtotal</span><strong id="subtotal">S/ 0.00</strong></p>
              <p class="mt-1 flex justify-between"><span>Total</span><strong id="total">S/ 0.00</strong></p>
            </div>
            <button id="confirm" class="mt-4 w-full rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">Confirmar pedido (simulado)</button>
          </div>

          <div id="confirmation" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-xs text-emerald-800"></div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  type MenuItem = { id: string; name: string; category: string; price: number };
  type CartItem = MenuItem & { qty: number };
  type OrderState = { mode: "mesa" | "delivery"; detail: string; cart: CartItem[] };

  const MENU_ITEMS: MenuItem[] = [
    { id: "e1", name: "Tequeños de queso", category: "Entradas", price: 18 },
    { id: "e2", name: "Causa acevichada", category: "Entradas", price: 24 },
    { id: "p1", name: "Parrilla mixta", category: "Parrillas", price: 48 },
    { id: "p2", name: "Anticuchos clásicos", category: "Parrillas", price: 32 },
    { id: "b1", name: "Chicha morada", category: "Bebidas", price: 9 },
    { id: "b2", name: "Limonada frozen", category: "Bebidas", price: 11 },
    { id: "d1", name: "Tres leches", category: "Postres", price: 14 },
    { id: "d2", name: "Volcán de chocolate", category: "Postres", price: 16 },
  ];

  const STORAGE_KEY = "restobar:order-state:v1";
  const CACHE_KEY = "restobar:last-confirmation:v1";

  const menuGrid = document.getElementById("menu-grid");
  const searchInput = document.getElementById("search") as HTMLInputElement | null;
  const categoryButtons = document.querySelectorAll(".cat-btn");
  const modeButtons = document.querySelectorAll(".mode-btn");
  const modeDetailInput = document.getElementById("mode-detail") as HTMLInputElement | null;
  const cartList = document.getElementById("cart-list");
  const cartEmpty = document.getElementById("cart-empty");
  const subtotal = document.getElementById("subtotal");
  const total = document.getElementById("total");
  const confirmButton = document.getElementById("confirm") as HTMLButtonElement | null;
  const confirmation = document.getElementById("confirmation");

  let activeCategory = "all";
  let activeSearch = "";

  function loadState(): OrderState {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { mode: "mesa", detail: "", cart: [] };
      const parsed = JSON.parse(raw) as OrderState;
      return {
        mode: parsed.mode === "delivery" ? "delivery" : "mesa",
        detail: parsed.detail ?? "",
        cart: Array.isArray(parsed.cart) ? parsed.cart : [],
      };
    } catch {
      return { mode: "mesa", detail: "", cart: [] };
    }
  }

  let state: OrderState = loadState();

  function persistState() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function filteredItems(): MenuItem[] {
    return MENU_ITEMS.filter((item) => {
      const byCategory = activeCategory === "all" || item.category === activeCategory;
      const needle = activeSearch.trim().toLowerCase();
      const bySearch = !needle || item.name.toLowerCase().includes(needle);
      return byCategory && bySearch;
    });
  }

  function addToCart(item: MenuItem) {
    const exists = state.cart.find((entry) => entry.id === item.id);
    if (exists) {
      exists.qty += 1;
    } else {
      state.cart.push({ ...item, qty: 1 });
    }
    persistState();
    renderCart();
  }

  function removeFromCart(id: string) {
    state.cart = state.cart.filter((item) => item.id !== id);
    persistState();
    renderCart();
  }

  function renderMenu() {
    if (!menuGrid) return;

    const rows = filteredItems();
    menuGrid.innerHTML = rows
      .map(
        (item) => `
      <article class="rounded-xl border border-neutral-200 bg-white p-4">
        <p class="text-[11px] uppercase tracking-wide text-neutral-500">${item.category}</p>
        <h3 class="mt-1 font-display text-lg font-semibold text-neutral-900">${item.name}</h3>
        <div class="mt-3 flex items-center justify-between">
          <span class="text-sm font-semibold text-accent">S/ ${item.price.toFixed(2)}</span>
          <button data-add="${item.id}" class="rounded-lg bg-neutral-900 px-3 py-2 text-xs font-semibold text-white">Agregar</button>
        </div>
      </article>`
      )
      .join("");

    menuGrid.querySelectorAll("[data-add]").forEach((button) => {
      button.addEventListener("click", (event) => {
        const id = (event.currentTarget as HTMLElement).getAttribute("data-add");
        const item = MENU_ITEMS.find((entry) => entry.id === id);
        if (item) addToCart(item);
      });
    });
  }

  function renderCart() {
    if (!cartList || !subtotal || !total || !cartEmpty || !confirmButton) return;

    if (state.cart.length === 0) {
      cartList.innerHTML = "";
      cartEmpty.classList.remove("hidden");
      subtotal.textContent = "S/ 0.00";
      total.textContent = "S/ 0.00";
      confirmButton.disabled = true;
      return;
    }

    cartEmpty.classList.add("hidden");
    const subtotalAmount = state.cart.reduce((acc, item) => acc + item.price * item.qty, 0);

    cartList.innerHTML = state.cart
      .map(
        (item) => `
      <li class="flex items-center justify-between gap-2 rounded-lg border border-neutral-200 p-2">
        <div>
          <p class="font-medium text-neutral-800">${item.qty}x ${item.name}</p>
          <p class="text-xs text-neutral-500">S/ ${(item.price * item.qty).toFixed(2)}</p>
        </div>
        <button data-remove="${item.id}" class="text-xs font-semibold text-rose-600">Quitar</button>
      </li>`
      )
      .join("");

    cartList.querySelectorAll("[data-remove]").forEach((button) => {
      button.addEventListener("click", (event) => {
        const id = (event.currentTarget as HTMLElement).getAttribute("data-remove");
        if (id) removeFromCart(id);
      });
    });

    subtotal.textContent = `S/ ${subtotalAmount.toFixed(2)}`;
    total.textContent = `S/ ${subtotalAmount.toFixed(2)}`;
    confirmButton.disabled = false;
  }

  async function cacheConfirmation(message: string) {
    if (!("caches" in window)) return;
    const cache = await caches.open(CACHE_KEY);
    await cache.put("/last-confirmation", new Response(message, { headers: { "Content-Type": "text/plain" } }));
  }

  function updateModeUI() {
    modeButtons.forEach((button) => {
      const mode = button.getAttribute("data-mode");
      const active = mode === state.mode;
      button.className = active
        ? "mode-btn rounded-lg bg-neutral-900 px-3 py-2 font-semibold text-white"
        : "mode-btn rounded-lg border border-neutral-300 px-3 py-2 font-semibold text-neutral-700";
    });
    if (modeDetailInput) modeDetailInput.value = state.detail;
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.getAttribute("data-mode");
      state.mode = mode === "delivery" ? "delivery" : "mesa";
      persistState();
      updateModeUI();
    });
  });

  modeDetailInput?.addEventListener("input", () => {
    state.detail = modeDetailInput.value;
    persistState();
  });

  searchInput?.addEventListener("input", () => {
    activeSearch = searchInput.value;
    renderMenu();
  });

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.getAttribute("data-cat") || "all";
      categoryButtons.forEach((entry) => {
        const selected = entry.getAttribute("data-cat") === activeCategory;
        entry.className = selected
          ? "cat-btn rounded-lg bg-neutral-900 px-3 py-2 text-xs font-semibold text-white"
          : "cat-btn rounded-lg border border-neutral-300 px-3 py-2 text-xs font-semibold text-neutral-700";
      });
      renderMenu();
    });
  });

  confirmButton?.addEventListener("click", async () => {
    const count = state.cart.reduce((acc, item) => acc + item.qty, 0);
    const totalAmount = state.cart.reduce((acc, item) => acc + item.price * item.qty, 0);
    const detail = state.detail || (state.mode === "delivery" ? "Dirección pendiente" : "Mesa pendiente");
    const message = `Pedido simulado confirmado: ${count} ítems | ${state.mode} | ${detail} | Total S/ ${totalAmount.toFixed(2)}.`;

    if (confirmation) {
      confirmation.textContent = `${message} No se procesa pago real ni despacho real.`;
      confirmation.classList.remove("hidden");
    }

    await cacheConfirmation(message);
    state.cart = [];
    persistState();
    renderCart();
  });

  updateModeUI();
  renderMenu();
  renderCart();
</script>
