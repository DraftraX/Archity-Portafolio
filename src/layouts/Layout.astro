---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Archity — Estudio de Ingeniería de Software & Sistemas en Producción",
  description = "Portafolio oficial de Archity: AltoPlanta SaaS, Vinkula CRM, Sencillo FinTech, ERP Grupo Pineda, Inmobiliaria Flamingo, Banco de Sangre Loreto, RestoManager 3D y Facturación Electrónica SUNAT UBL 2.1.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fuentes oficiales del diseño Crayon / creative-artsy: Handjet, Just Me Again Down Here, DM Mono e Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Handjet:wght,ELGR,ELSH@700..900,1,7&family=Inter:wght@400;500;600;700&family=Just+Me+Again+Down+Here&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="t-creative-artsy ca-grid min-h-screen w-full overflow-x-clip bg-[var(--ca-surface)] text-[var(--ca-ink)] antialiased m-0 p-0">
    <!-- Hoja real de cuaderno cubriendo el 100% del ancho y alto de la pantalla -->
    <div class="relative w-full min-h-screen overflow-x-clip bg-[var(--ca-surface)] ca-grid text-[var(--ca-ink)]">
      <div aria-hidden="true" class="ca-grain pointer-events-none fixed inset-0 z-[1] mix-blend-multiply"></div>
      <slot />
    </div>
  </body>
</html>
