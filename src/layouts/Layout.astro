---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  flexBody?: boolean;
}

const {
  title = "Archity — Product Design & Software Engineering Studio",
  description = "Portafolio oficial de Archity: diseño de software, plataformas SaaS inmobiliarias, ERPs industriales y experiencias digitales.",
  flexBody = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fuentes oficiales del diseño Crayon / creative-artsy: Handjet, Just Me Again Down Here, DM Mono e Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Handjet:wght,ELGR,ELSH@700..900,1,7&family=Inter:wght@400;500;600;700&family=Just+Me+Again+Down+Here&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="t-creative-artsy min-h-screen w-full overflow-x-clip bg-[var(--ca-surface)] text-[var(--ca-ink)] antialiased m-0 p-0">
    <div
      class={`t-creative-artsy min-h-screen w-full overflow-x-clip bg-[var(--ca-surface)] text-[var(--ca-ink)] antialiased ${
        flexBody ? "flex flex-col" : ""
      }`}
    >
      <div aria-hidden="true" class="ca-grain pointer-events-none fixed inset-0 z-[1] mix-blend-multiply"></div>
      <slot />
    </div>

    <script>
      // Seguimiento global en tiempo real para el cuadro inversor de colores ([data-invert-zone]) y el círculo VER/SEE ([data-see-zone])
      const setupLenses = (zoneSel: string, lensSel: string) => {
        document.querySelectorAll<HTMLElement>(zoneSel).forEach((zone) => {
          const lens = zone.querySelector<HTMLElement>(lensSel);
          if (!lens) return;
          let raf = 0;

          const moveLens = (clientX: number, clientY: number) => {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              const rect = zone.getBoundingClientRect();
              if (!rect.width || !rect.height) return;
              const x = clientX - rect.left;
              const y = clientY - rect.top;
              lens.style.left = `${x}px`;
              lens.style.top = `${y}px`;
              lens.style.transform = "scale(1)";
            });
          };

          zone.addEventListener("mouseenter", (e) => {
            zone.classList.add("is-hovered");
            moveLens(e.clientX, e.clientY);
          });

          zone.addEventListener("mousemove", (e) => {
            if (!zone.classList.contains("is-hovered")) {
              zone.classList.add("is-hovered");
            }
            moveLens(e.clientX, e.clientY);
          });

          zone.addEventListener("mouseleave", () => {
            zone.classList.remove("is-hovered");
            lens.style.transform = "scale(0.35)";
          });
        });
      };

      setupLenses("[data-invert-zone]", "[data-cursor-lens]");
      setupLenses("[data-see-zone]", "[data-see-lens]");
    </script>
  </body>
</html>
