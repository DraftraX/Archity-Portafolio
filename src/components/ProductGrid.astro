---
// Contenedor del grid de productos reales de Archity y Demos Interactivas
import ProductCard from "./ProductCard.astro";

const products = [
  {
    name: "AltoPlanta",
    category: "SaaS de Tributo Inmobiliario & Catastro",
    badge: "SaaS Propio Archity",
    description: "Plataforma digital en Perú para la determinación, emisión, fiscalización y liquidación del Impuesto Predial (D. Leg. 776), Arbitrios Municipales y Alcabala a nivel nacional.",
    features: [
      "Liquidación automática de Impuesto Predial por tramos acumulativos de UIT",
      "Prorrateo y cálculo de Arbitrios Municipales por ordenanzas distritales",
      "Emisión masiva de Cuponeras Digitales (HR y PU) y estados de cuenta en PDF",
      "Mapeo catastral urbano para fiscalización y detección de predios subvaluados",
    ],
    tags: ["Tributo Inmobiliario", "Predial & Arbitrios", "Alcabala", "Cuponeras PDF", "PostGIS / Cloud"],
    image: "",
    status: "En producción",
    demoUrl: "https://altoplanta.com/",
    landingUrl: "/productos/altoplanta",
  },
  {
    name: "ERP Grupo Pineda",
    category: "ERP Consorcio Empresarial",
    badge: "Consorcio Empresarial",
    description: "Sistema ERP integral multiempresa a medida para el consorcio líder de infraestructura, minería no metálica y plantas automatizadas de concreto en la Amazonía peruana.",
    features: [
      "Gestión multiempresa: Plantas MATEPCO, Minería ROCAFER y Obras Civiles",
      "Telemetría en tiempo real de Balanza Electrónica camionera y pesaje en canteras",
      "Monitoreo de Plantas de Concreto en Tarapoto, Moyobamba y Chachapoyas",
      "Control de flota pesada, abastecimiento de combustible y guías electrónicas",
    ],
    tags: ["ERP Industrial", "Consorcio Empresarial", "Minería & Concreto", "Telemetría Balanzas", "SQL"],
    image: "",
    status: "En producción",
    demoUrl: "https://grupopineda.pe/",
    landingUrl: "/productos/grupo-pineda",
  },
];

const interactiveDemos = [
  {
    title: "Empresas B2B & ROI",
    category: "Corporativo B2B",
    badge: "Calculadora ROI",
    icon: "💼",
    description: "Captación de clientes corporativos con calculadora interactiva de retorno de inversión, agenda de demos y planes a medida.",
    url: "/demos/landing-empresa",
    tags: ["Calculadora ROI", "Agendador B2B", "Enterprise"],
  },
  {
    title: "Tienda E-Commerce",
    category: "Comercio Digital",
    badge: "Paginación & Carrito",
    icon: "🛍️",
    description: "Catálogo con paginación funcional, drawer de carrito deslizable, cupones de descuento y checkout simulado con Yape.",
    url: "/demos/ecommerce",
    tags: ["Paginación Front", "Drawer Carrito", "Cupones"],
  },
  {
    title: "Restaurante & Brasas",
    category: "Gastronomía",
    badge: "Carta Paginada",
    icon: "🍽️",
    description: "Menú digital con paginación por categorías, comanda de delivery en tiempo real y reserva de mesas interactiva.",
    url: "/demos/restaurante",
    tags: ["Menú Paginado", "Reserva Mesas", "Delivery WhatsApp"],
  },
  {
    title: "Botica & Farmacia",
    category: "Salud & Botica",
    badge: "Buscador Paginado",
    icon: "💊",
    description: "Catálogo farmacéutico con paginación funcional, búsqueda por principio activo, control de recetas y pedido express.",
    url: "/demos/botica",
    tags: ["Paginación", "Receta Médica", "Despacho 45min"],
  },
  {
    title: "Clínica Veterinaria",
    category: "Pet Care & Salud",
    badge: "Citas & Pet Shop",
    icon: "🐾",
    description: "Agendador interactivo de consultas médicas/grooming para mascotas y tienda pet shop con paginación funcional.",
    url: "/demos/veterinaria",
    tags: ["Citas Mascotas", "Pet Shop Paginado", "Urgencias"],
  },
  {
    title: "Portal Inmobiliario",
    category: "PropTech & Vivienda",
    badge: "Simulador Cuotas",
    icon: "🏛️",
    description: "Búsqueda avanzada de inmuebles con paginación funcional, filtros por distrito/precio y simulador de crédito hipotecario.",
    url: "/demos/inmobiliaria",
    tags: ["Inmuebles Paginados", "Crédito Hipotecario", "Visitas"],
  },
];
---

<section id="productos" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
          Sistemas en Producción Real
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
          Nuestros Productos &amp; Desarrollos Insignia
        </h2>
        <p class="mt-3 leading-relaxed text-neutral-600">
          En Archity construimos software que opera en industrias reales: desde plataformas SaaS de tributo inmobiliario hasta ERPs de consorcios a gran escala.
        </p>
      </div>

      <!-- Banner rápido de contacto para nuevos proyectos -->
      <div class="rounded-xl border border-neutral-200/80 bg-neutral-50/80 p-4 text-xs text-neutral-600 max-w-xs">
        <strong class="block text-neutral-900 font-semibold mb-1">¿Tienes un proyecto en mente?</strong>
        Podemos construir tu próximo SaaS o digitalizar las operaciones de tu consorcio.
        <a href="#contacto" class="text-accent font-semibold hover:underline block mt-1">Iniciar conversación &rarr;</a>
      </div>
    </div>

    <!-- Grid de productos insignia -->
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {products.map((p) => <ProductCard product={p} />)}
    </div>

    <!-- Demos Interactivas en Front-End -->
    <div class="mt-16 rounded-2xl border border-neutral-200/90 bg-gradient-to-br from-neutral-50 via-white to-neutral-50/80 p-8 sm:p-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-neutral-200/80 pb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent">Laboratorio de Interfaces</span>
          <h3 class="mt-1 font-display text-2xl font-bold text-neutral-900">
            6 Demos Completas en Front-End con Paginación Funcional
          </h3>
          <p class="text-xs text-neutral-600 mt-1">
            Explora ejemplos interactivos reales listos para probar la fluidez, reactividad y experiencia de usuario que entregamos.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent border border-accent/20">
            Arquitectura ECC
          </span>
        </div>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {interactiveDemos.map((d) => (
          <div class="group relative flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-6 transition duration-300 hover:border-accent hover:shadow-lg hover:shadow-accent/5">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent">{d.category}</span>
                <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-[10px] font-semibold text-neutral-700">
                  {d.badge}
                </span>
              </div>
              <h4 class="font-display text-lg font-bold text-neutral-900 group-hover:text-accent transition-colors flex items-center gap-2">
                <span>{d.icon}</span>
                <span>{d.title}</span>
              </h4>
              <p class="mt-2 text-xs text-neutral-600 leading-relaxed line-clamp-3">
                {d.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {d.tags.map((t) => (
                  <span class="rounded bg-neutral-50 px-2 py-0.5 text-[10px] font-medium text-neutral-600 border border-neutral-200/60">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between">
              <span class="text-[11px] font-semibold text-neutral-400">100% Front-End</span>
              <a
                href={d.url}
                class="inline-flex items-center gap-1 text-xs font-bold text-accent group-hover:text-accent-dark transition-colors"
              >
                Abrir Demo &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
