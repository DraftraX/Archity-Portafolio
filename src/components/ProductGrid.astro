---
// Contenedor del grid de productos reales de Archity
import ProductCard from "./ProductCard.astro";

const products = [
  {
    name: "AltoPlanta",
    category: "PropTech SaaS Inmobiliario",
    badge: "SaaS Propio Archity",
    description: "Plataforma digital inmobiliaria líder en Perú para buscar, comprar, vender y alquilar viviendas, terrenos y lotes a nivel nacional.",
    features: [
      "Búsqueda geolocalizada por distritos y regiones en Perú",
      "Tours Virtuales 360° interactivos en cada inmueble",
      "Generación instantánea de proformas y cotizaciones en PDF",
      "CRM integrado para agentes inmobiliarios y control de leads",
    ],
    tags: ["PropTech", "Astro / React", "Tours 360°", "CRM Leads", "PostgreSQL"],
    image: "",
    status: "En producción",
    demoUrl: "https://altoplanta.com/",
    landingUrl: "/productos/altoplanta",
  },
  {
    name: "ERP Grupo Pineda",
    category: "ERP Industrial & Concreto",
    badge: "Consorcio Empresarial",
    description: "Sistema ERP integral a medida para el consorcio líder de infraestructura, minería no metálica y concreto premezclado en el nororiente peruano.",
    features: [
      "Monitoreo de Plantas de Concreto MATEPCO (Tarapoto, Moyobamba, Chachapoyas)",
      "Control de Planta Chancadora ROCAFER (780 TM/Día en Picota)",
      "Balanza electrónica de pesaje y control de canteras",
      "Gestión de logística pesada, combustible y obras públicas",
    ],
    tags: ["ERP Industrial", "Minería & Canteras", "Plantas Concreto", "Telemetría", "SQL"],
    image: "",
    status: "En producción",
    demoUrl: "https://grupopineda.pe/",
    landingUrl: "/productos/grupo-pineda",
  },
];
---

<section id="productos" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
          Sistemas en Producción Real
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
          Nuestros Productos & Desarrollos Insignia
        </h2>
        <p class="mt-3 leading-relaxed text-neutral-600">
          En Archity construimos software que opera en industrias reales: desde plataformas PropTech a nivel nacional hasta ERPs de infraestructura a gran escala.
        </p>
      </div>

      <!-- Banner rápido de contacto para nuevos proyectos -->
      <div class="rounded-xl border border-neutral-200/80 bg-neutral-50/80 p-4 text-xs text-neutral-600 max-w-xs">
        <strong class="block text-neutral-900 font-semibold mb-1">¿Tienes un proyecto en mente?</strong>
        Podemos construir tu próximo SaaS o digitalizar las operaciones de tu empresa.
        <a href="#contacto" class="text-accent font-semibold hover:underline block mt-1">Iniciar conversación &rarr;</a>
      </div>
    </div>

    <!-- Grid de productos -->
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {products.map((p) => <ProductCard product={p} />)}
    </div>

  </div>
</section>
