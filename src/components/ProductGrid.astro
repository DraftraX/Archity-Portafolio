---

<section id="productos" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
          Portafolio Oficial · 100% Proyectos Reales
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
          Nuestros Productos, Microservicios &amp; Desarrollos Reales
        </h2>
        <p class="mt-3 leading-relaxed text-neutral-600">
          Ecosistemas SaaS propios y sistemas empresariales desarrollados por <strong>Archity</strong>: desde plataformas PropTech con cartografía CAD/360°, CRM con IA y motores FinTech hasta ERPs industriales, portales de salud, sistemas restobar 3D y facturación electrónica SUNAT.
        </p>
      </div>

      <!-- Cinta de logotipos oficiales -->
      <div class="rounded-xl border border-neutral-200/80 bg-neutral-50/80 p-4 text-xs text-neutral-600 max-w-xs">
        <strong class="block text-neutral-900 font-semibold mb-1">8 Sistemas con Identidad Propia</strong>
        Cada proyecto cuenta con arquitectura dedicada, repositorio verificable y despliegue real.
        <a href="#contacto" class="text-accent font-semibold hover:underline block mt-1">Cotizar un sistema a medida &rarr;</a>
      </div>
    </div>

    <!-- Barra rápida de acceso por logo -->
    <div class="mt-8 flex flex-wrap items-center gap-2.5 rounded-2xl border border-neutral-200/80 bg-neutral-50/60 p-3">
      {products.map((p) => (
        <a
          href={p.landingUrl}
          class="inline-flex items-center gap-2 rounded-xl border border-neutral-200/90 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-800 shadow-2xs transition hover:border-accent hover:text-accent"
        >
          <img src={p.logoMark ?? p.logo} alt="" class="h-4 w-4 object-contain rounded-xs" />
          <span>{p.name}</span>
        </a>
      ))}
    </div>

    <!-- Grid de los 8 proyectos reales -->
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {products.map((p) => <ProductCard product={p} />)}
    </div>

  </div>
</section>
