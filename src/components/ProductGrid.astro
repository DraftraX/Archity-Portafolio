---
// Contenedor del grid de productos
import ProductCard from "./ProductCard.astro";

// EDITA AQUÍ: tus productos SaaS. image: "" muestra el placeholder; pon "/images/tu-captura.webp" para usar imagen real.
const products = [
  {
    name: "Inventra",
    description: "Control de inventario multi-almacén en tiempo real, con alertas de stock, órdenes de compra y reportes descargables.",
    tags: ["React", "Node.js", "PostgreSQL"],
    image: "",
    status: "En producción",
    demoUrl: "#",
    moreUrl: "#",
  },
  {
    name: "Turnia",
    description: "Reservas y gestión de citas para clínicas y estudios: agenda inteligente, recordatorios automáticos y pagos en línea.",
    tags: ["Vue", "Laravel", "MySQL"],
    image: "",
    status: "En producción",
    demoUrl: "#",
    moreUrl: "#",
  },
  {
    name: "FacturaFlow",
    description: "Emisión de comprobantes electrónicos, conciliación automática y panel de indicadores de ventas para pymes.",
    tags: ["Next.js", "TypeScript", "Prisma"],
    image: "",
    status: "Beta",
    demoUrl: "#",
    moreUrl: "#",
  },
  {
    name: "RastreoGo",
    description: "Seguimiento de entregas en tiempo real con rutas optimizadas, notificaciones al cliente y prueba de entrega digital.",
    tags: ["Nuxt", "Express", "Redis"],
    image: "",
    status: "En desarrollo",
    demoUrl: "#",
    moreUrl: "#",
  },
];
---

<section id="productos" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">

    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Productos
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Sistemas SaaS listos para usar
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Productos propios en operación real. Pruébalos con una demo guiada
        o escríbeme para una implementación a tu medida.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:gap-8">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </div>
</section>
