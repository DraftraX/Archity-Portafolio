---
import { EXTERNAL_URLS } from "../constants/site";

const projects = [
  {
    name: "AltoPlanta",
    category: "SaaS",
    summary: "Plataforma de tributo inmobiliario en operación real.",
    preview: "Cálculo tributario · gestión predial · emisión digital",
    detailUrl: "/productos/altoplanta",
    liveUrl: EXTERNAL_URLS.altoplanta,
  },
  {
    name: "ERP Grupo Pineda",
    category: "ERP",
    summary: "Sistema industrial multiempresa con control operativo.",
    preview: "Operación de plantas · logística · trazabilidad",
    detailUrl: "/productos/grupo-pineda",
    liveUrl: EXTERNAL_URLS.grupoPineda,
  },
  {
    name: "Restobar System",
    category: "Frontend Astro/TS",
    summary: "Demo temporal sin backend con carrito/comanda en localStorage.",
    preview: "Menú · categorías · buscador · delivery/mesa",
    detailUrl: "/proyectos/restobar-system",
    liveUrl: EXTERNAL_URLS.restobarVercel,
  },
];
---

<section id="productos" class="scroll-mt-20 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Proyectos</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Casos activos y listos para enlazar</h2>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="group flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-accent">{project.category}</p>
          <h3 class="mt-2 font-display text-2xl font-bold text-neutral-900">{project.name}</h3>
          <p class="mt-2 text-sm text-neutral-600">{project.summary}</p>
          <div class="mt-4 rounded-lg border border-neutral-200 bg-neutral-50 p-3 text-xs text-neutral-600">{project.preview}</div>
          <div class="mt-auto flex items-center justify-between gap-3 pt-5">
            <a href={project.detailUrl} class="text-sm font-semibold text-neutral-900 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Ver detalle</a>
            <a href={project.liveUrl} target="_blank" rel="noopener" class="text-sm font-semibold text-accent hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Live ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
