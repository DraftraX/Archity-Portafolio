---
const stats = [
  { value: "02", label: "productos en operación" },
  { value: "01", label: "frontend Restobar migrado" },
  { value: "100%", label: "enfoque visual y responsive" },
];
---

<section class="border-b border-neutral-200/70 bg-gradient-to-b from-neutral-50 via-white to-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:px-8 lg:py-24">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Portafolio de productos reales</p>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
        Software visual, limpio y listo para producción.
      </h1>
      <p class="mt-4 max-w-xl text-base text-neutral-600 sm:text-lg">
        Proyectos reales desplegables en Vercel, enlaces editables y una experiencia enfocada en resultados.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#productos" class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-6 py-3 text-sm font-semibold text-white hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Ver proyectos</a>
        <a href="#contacto" class="inline-flex items-center justify-center rounded-lg border border-neutral-300 px-6 py-3 text-sm font-semibold text-neutral-800 hover:bg-neutral-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Contactar</a>
      </div>
    </div>

    <div class="grid gap-3 rounded-2xl border border-neutral-200/80 bg-white p-6 shadow-sm">
      {stats.map((item) => (
        <div class="rounded-xl border border-neutral-200/70 bg-neutral-50/70 p-4">
          <p class="font-display text-3xl font-bold text-neutral-900">{item.value}</p>
          <p class="text-xs uppercase tracking-wide text-neutral-500">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
