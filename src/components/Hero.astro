---
// Sección principal con acceso directo a los 8 proyectos reales y sus logos oficiales (sin emojis)
const badge = "Software Studio & Incubadora SaaS · Perú";
const stats = [
  "Ecosistema PropTech & FinTech (AltoPlanta, Vinkula, Sencillo)",
  "ERP de Consorcio Industrial (Grupo Pineda)",
  "Showrooms 360° & Plataformas 3D WebGL",
  "Microservicio Facturación SUNAT UBL 2.1",
];

const quickPills = [
  { label: "AltoPlanta SaaS", href: "/productos/altoplanta", logo: "/logos/altoplanta-symbol.svg" },
  { label: "Vinkula CRM + IA", href: "/productos/vinkula", logo: "/logos/vinkula-mark.svg" },
  { label: "Sencillo FinTech", href: "/productos/sencillo", logo: "/logos/sencillo-mark.svg" },
  { label: "ERP Grupo Pineda", href: "/productos/grupo-pineda", logo: "/logos/grupo-pineda-mark.svg" },
  { label: "Inmobiliaria Flamingo", href: "/productos/proyect-flamingo", logo: "/logos/flamingo-logo.png" },
  { label: "Banco de Sangre Loreto", href: "/productos/bank-blood", logo: "/logos/bankblood-logo.png" },
  { label: "RestoManager 3D", href: "/productos/restorant-system", logo: "/logos/restory-logo.png" },
  { label: "Archity Billing SUNAT", href: "/productos/billing-service", logo: "/logos/billing-mark.svg" },
];
---

<section class="border-b border-neutral-200/70 bg-gradient-to-b from-neutral-50/60 via-white to-white">
  <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-28 lg:px-8">

    <span class="inline-flex items-center gap-2 rounded-full border border-neutral-200/90 bg-white px-4 py-1.5 text-xs font-medium text-neutral-700 shadow-xs backdrop-blur">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      {badge}
    </span>

    <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl font-bold leading-[1.12] tracking-tight text-neutral-900 sm:text-5xl md:text-6xl">
      Ingeniería de software real para plataformas <span class="text-accent">SaaS</span>, <span class="text-accent">ERPs</span> y sistemas críticos
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-neutral-600 sm:text-lg">
      En <strong>Archity</strong> construimos y operamos sistemas en producción real: desde nuestra suite PropTech <strong class="text-neutral-900">AltoPlanta</strong> (<a href="https://altoplanta.com/" target="_blank" rel="noopener" class="text-accent underline font-semibold">altoplanta.com</a>), <strong class="text-neutral-900">Vinkula CRM</strong> y <strong class="text-neutral-900">Sencillo</strong>, hasta el <strong class="text-neutral-900">ERP del Consorcio Grupo Pineda</strong> (<a href="https://grupopineda.pe/" target="_blank" rel="noopener" class="text-accent underline font-semibold">grupopineda.pe</a>), el showroom 360° de <strong class="text-neutral-900">Inmobiliaria Flamingo</strong>, el portal del <strong class="text-neutral-900">Banco de Sangre Loreto</strong>, <strong class="text-neutral-900">RestoManager 3D</strong> y nuestro motor de <strong class="text-neutral-900">Facturación Electrónica SUNAT UBL 2.1</strong>.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="#productos"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-neutral-900 px-6 py-3 text-sm font-semibold text-white shadow-xs transition-all hover:bg-neutral-800 sm:w-auto"
      >
        Explorar los 8 proyectos reales
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a
        href="/productos/billing-service"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-xs transition-all hover:bg-accent-dark hover:shadow-md hover:shadow-accent/20 sm:w-auto"
      >
        Probar Consola Facturador SUNAT UBL 2.1 &rarr;
      </a>
      <a
        href="#contacto"
        class="inline-flex w-full items-center justify-center rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-neutral-800 shadow-xs transition-colors hover:border-neutral-400 hover:bg-neutral-50 sm:w-auto"
      >
        Cotizar proyecto a medida
      </a>
    </div>

    <!-- Píldoras de acceso rápido a los 8 sistemas reales con sus logos oficiales -->
    <div class="mt-9 flex flex-wrap items-center justify-center gap-2 text-xs">
      {quickPills.map((pill) => (
        <a
          href={pill.href}
          class="inline-flex items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3.5 py-2 font-semibold text-neutral-700 hover:border-accent hover:text-accent transition-all shadow-2xs hover:-translate-y-0.5"
        >
          <img src={pill.logo} alt={pill.label} class="h-4 w-4 object-contain shrink-0" />
          <span>{pill.label}</span>
        </a>
      ))}
    </div>

    <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-neutral-500">
      {
        stats.map((s) => (
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
            {s}
          </li>
        ))
      }
    </ul>
  </div>
</section>
