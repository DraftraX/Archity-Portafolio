---
// Barra de navegación minimalista, sticky con blur y enlaces a productos y las 5 demos completas
const demos = [
  { label: "Empresas B2B (ROI)", href: "/demos/landing-empresa", icon: "💼" },
  { label: "Tienda E-Commerce", href: "/demos/ecommerce", icon: "🛍️" },
  { label: "Restaurante & Brasas", href: "/demos/restaurante", icon: "🍽️" },
  { label: "Botica & Farmacia", href: "/demos/botica", icon: "💊" },
  { label: "Veterinaria & Pets", href: "/demos/veterinaria", icon: "🐾" },
  { label: "Portal Inmobiliario", href: "/demos/inmobiliaria", icon: "🏛️" },
];

const links = [
  { label: "Productos", href: "/#productos" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Casos de éxito", href: "/#casos" },
  { label: "Contacto", href: "/#contacto" },
];

const cta = { label: "Cotizar proyecto", href: "/#contacto" };
---

<header class="sticky top-0 z-50 border-b border-neutral-200/70 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo: Isotipo A en caja oscura + ARCHITY -->
    <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-90" aria-label="Archity — inicio">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white shadow-xs">
        <svg viewBox="0 0 150 140" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <polygon points="74.5,0 88.5,26 35.5,126 0,140" />
          <polygon points="97,43.5 86,63.5 100.5,90.5 70,90.5 62.5,104.5 108,104.5 126.5,138.5 149,138.5" />
        </svg>
      </span>
      <span class="font-display text-sm font-bold tracking-[0.25em] text-neutral-900">ARCHITY</span>
    </a>

    <!-- Nav escritorio -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      <a
        href="/#productos"
        class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
      >
        Productos
      </a>

      <!-- Dropdown Demos en Vivo -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
        >
          <span>Demos en Vivo</span>
          <span class="rounded bg-accent-soft px-1.5 py-0.2 text-[10px] font-bold text-accent border border-accent/20">6</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 absolute top-full left-0 mt-1 w-64 rounded-xl border border-neutral-200 bg-white p-2 shadow-xl shadow-neutral-900/10">
          <div class="px-2 py-1.5 text-[10px] font-bold uppercase tracking-wider text-neutral-400">
            Laboratorio de Demos Front-End
          </div>
          <div class="space-y-0.5">
            {demos.map((d) => (
              <a
                href={d.href}
                class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-accent transition-colors"
              >
                <span>{d.icon}</span>
                <span>{d.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/#servicios"
        class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
      >
        Servicios
      </a>
      <a
        href="/#casos"
        class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
      >
        Casos de éxito
      </a>
      <a
        href="/#contacto"
        class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
      >
        Contacto
      </a>

      <a
        href={cta.href}
        class="ml-3 rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-neutral-800"
      >
        {cta.label}
      </a>
    </nav>

    <!-- Botón menú móvil -->
    <button
      id="menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-neutral-700 transition-colors hover:bg-neutral-100 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir o cerrar menú"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-neutral-200/70 bg-white md:hidden max-h-[85vh] overflow-y-auto">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-3 text-xs" aria-label="Navegación móvil">
      <a href="/#productos" class="block rounded-lg px-3 py-2 text-sm font-semibold text-neutral-800 hover:bg-neutral-100">
        🏛️ Productos &amp; SaaS Insignia
      </a>

      <div class="pt-2 pb-1 px-3 text-[10px] font-bold uppercase tracking-wider text-neutral-400">
        Demos Interactivas en Front-End
      </div>
      <div class="grid grid-cols-2 gap-1 px-1">
        {demos.map((d) => (
          <a href={d.href} class="flex items-center gap-1.5 rounded-lg p-2 text-xs font-medium text-neutral-700 hover:bg-neutral-100 hover:text-accent">
            <span>{d.icon}</span>
            <span class="truncate">{d.label}</span>
          </a>
        ))}
      </div>

      <div class="pt-2 border-t border-neutral-100 space-y-1">
        <a href="/#servicios" class="block rounded-lg px-3 py-2 font-medium text-neutral-700 hover:bg-neutral-100">
          Servicios de Software
        </a>
        <a href="/#casos" class="block rounded-lg px-3 py-2 font-medium text-neutral-700 hover:bg-neutral-100">
          Casos de Éxito
        </a>
        <a href="/#contacto" class="block rounded-lg px-3 py-2 font-medium text-neutral-700 hover:bg-neutral-100">
          Contacto &amp; Cotización
        </a>
      </div>

      <a href={cta.href} class="mt-3 block rounded-lg bg-neutral-900 px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-neutral-800 transition-colors">
        {cta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  let isOpen = false;

  function setMenu(open: boolean) {
    isOpen = open;
    menu?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
  }

  btn?.addEventListener("click", () => {
    setMenu(!isOpen);
  });

  const mobileLinks = menu?.querySelectorAll("a");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>
