---
// Barra de navegación minimalista, sticky con blur
const links = [
  { label: "Productos", href: "#productos" },
  { label: "Casos de éxito", href: "#casos" },
  { label: "Contacto", href: "#contacto" },
];

// EDITA AQUÍ: destino del botón azul
const cta = { label: "Iniciar proyecto", href: "#contacto" };
---

<header class="sticky top-0 z-50 border-b border-neutral-200/70 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo: Isotipo A en caja oscura + ARCHITY -->
    <a href="#" class="flex items-center gap-2.5 transition-opacity hover:opacity-90" aria-label="Archity — inicio">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white shadow-sm">
        <svg viewBox="0 0 150 140" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <polygon points="74.5,0 88.5,26 35.5,126 0,140" />
          <polygon points="97,43.5 86,63.5 100.5,90.5 70,90.5 62.5,104.5 108,104.5 126.5,138.5 149,138.5" />
        </svg>
      </span>
      <span class="font-display text-sm font-bold tracking-[0.25em] text-neutral-900">ARCHITY</span>
    </a>

    <!-- Nav escritorio -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={cta.href}
        class="ml-3 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-dark hover:shadow"
      >
        {cta.label}
      </a>
    </nav>

    <!-- Botón menú móvil -->
    <button
      id="menu-btn"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-neutral-700 transition-colors hover:bg-neutral-100 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir o cerrar menú"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-neutral-200/70 bg-white md:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-3" aria-label="Navegación móvil">
      {
        links.map((l) => (
          <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-neutral-700 hover:bg-neutral-100">
            {l.label}
          </a>
        ))
      }
      <a href={cta.href} class="mt-2 block rounded-lg bg-accent px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-accent-dark">
        {cta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  let isOpen = false;

  function setMenu(open: boolean) {
    isOpen = open;
    menu?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
  }

  btn?.addEventListener("click", () => {
    setMenu(!isOpen);
  });

  const mobileLinks = menu?.querySelectorAll("a");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>
