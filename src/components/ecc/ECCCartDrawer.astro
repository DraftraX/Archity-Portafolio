---
// Componente ECC: Drawer de Carrito Deslizable 100% Interactivo en Front-End
// E-Commerce Core Component con soporte de cupones, IGV y Checkout Simulado
---

<!-- Backdrop -->
<div
  id="cart-backdrop"
  class="fixed inset-0 z-50 bg-neutral-900/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Drawer Panel -->
<div
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-white shadow-2xl transition-transform duration-300 translate-x-full"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
>
  <!-- Cabecera del Carrito -->
  <div class="flex items-center justify-between border-b border-neutral-200 px-6 py-4">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-100 text-neutral-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </span>
      <div>
        <h2 id="cart-title" class="font-display text-base font-bold text-neutral-900">Carrito de Compras</h2>
        <span class="text-xs text-neutral-500"><span id="cart-item-count">0</span> productos seleccionados</span>
      </div>
    </div>
    <button
      id="cart-close-btn"
      type="button"
      class="rounded-lg p-2 text-neutral-400 hover:bg-neutral-100 hover:text-neutral-900 transition-colors"
      aria-label="Cerrar carrito"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Barra de Envío Gratis -->
  <div class="border-b border-neutral-100 bg-neutral-50 px-6 py-2.5">
    <div class="flex items-center justify-between text-xs">
      <span class="text-neutral-600 font-medium" id="free-shipping-text">¡Envío gratis a todo el Perú desde S/ 250!</span>
      <span class="font-bold text-accent" id="free-shipping-percent">0%</span>
    </div>
    <div class="mt-1.5 h-1.5 w-full rounded-full bg-neutral-200 overflow-hidden">
      <div id="free-shipping-bar" class="h-full bg-accent transition-all duration-300 w-0"></div>
    </div>
  </div>

  <!-- Lista de Ítems -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto px-6 py-4 space-y-4">
    <!-- Estado vacío por defecto -->
    <div id="cart-empty-state" class="flex flex-col items-center justify-center py-16 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100 text-neutral-400 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <p class="font-display font-semibold text-neutral-900">Tu carrito está vacío</p>
      <p class="mt-1 text-xs text-neutral-500 max-w-xs">
        Explora los productos de demostración y añade soluciones de software o hardware para probar el flujo.
      </p>
    </div>

    <!-- Los ítems renderizados dinámicamente aparecerán aquí -->
    <div id="cart-items-list" class="space-y-4"></div>
  </div>

  <!-- Cupón de Descuento -->
  <div class="border-t border-neutral-200 px-6 pt-3 pb-2 bg-neutral-50/60">
    <div class="flex gap-2">
      <input
        type="text"
        id="coupon-input"
        placeholder="Cupón: ARCHITY10"
        class="flex-1 rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs uppercase font-medium placeholder:normal-case focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
      />
      <button
        type="button"
        id="apply-coupon-btn"
        class="rounded-lg bg-neutral-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-neutral-800 transition-colors"
      >
        Aplicar
      </button>
    </div>
    <p id="coupon-message" class="hidden mt-1 text-[11px]"></p>
  </div>

  <!-- Resumen de Costos y Acciones -->
  <div class="border-t border-neutral-200 px-6 py-4 bg-white space-y-3">
    <div class="space-y-1.5 text-xs text-neutral-600">
      <div class="flex justify-between">
        <span>Subtotal</span>
        <span class="font-medium text-neutral-900">S/ <span id="cart-subtotal">0.00</span></span>
      </div>
      <div id="discount-row" class="hidden flex justify-between text-emerald-600 font-medium">
        <span>Descuento Cupón (<span id="discount-rate">10%</span>)</span>
        <span>- S/ <span id="cart-discount">0.00</span></span>
      </div>
      <div class="flex justify-between">
        <span>IGV (18% incluido)</span>
        <span class="text-neutral-500">S/ <span id="cart-igv">0.00</span></span>
      </div>
      <div class="flex justify-between">
        <span>Envío estimado</span>
        <span id="cart-shipping" class="font-medium text-neutral-900">S/ 15.00</span>
      </div>
      <div class="flex justify-between border-t border-neutral-200 pt-2 text-base font-bold text-neutral-900">
        <span>Total a Pagar</span>
        <span class="text-accent">S/ <span id="cart-total">0.00</span></span>
      </div>
    </div>

    <!-- Botones de Acción -->
    <div class="grid gap-2 pt-2">
      <button
        type="button"
        id="btn-open-checkout"
        disabled
        class="flex w-full items-center justify-center gap-2 rounded-lg bg-accent py-3 text-sm font-semibold text-white transition-all hover:bg-accent-dark disabled:opacity-50 disabled:cursor-not-allowed shadow-xs"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Proceder al Pago Simulado
      </button>

      <button
        type="button"
        id="btn-whatsapp-order"
        disabled
        class="flex w-full items-center justify-center gap-2 rounded-lg border border-emerald-600 bg-emerald-50 py-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        Pedir vía WhatsApp
      </button>
    </div>
  </div>
</div>

<!-- Modal de Checkout Simulado -->
<div
  id="checkout-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs hidden"
>
  <div class="w-full max-w-lg rounded-2xl bg-white p-6 sm:p-8 shadow-2xl border border-neutral-200">
    <div class="flex items-center justify-between border-b border-neutral-100 pb-4">
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-accent text-white font-bold text-xs">A</span>
        <h3 class="font-display text-lg font-bold text-neutral-900">Checkout Simulado Archity</h3>
      </div>
      <button id="checkout-modal-close" class="text-neutral-400 hover:text-neutral-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>

    <form id="checkout-form" class="mt-5 space-y-4 text-xs">
      <div>
        <label class="block font-bold text-neutral-700">Nombre completo / Razón Social</label>
        <input type="text" required placeholder="Ej. Juan Pérez / Corporación ABC SAC" class="mt-1 w-full rounded-lg border border-neutral-300 p-2.5 text-xs text-neutral-900 focus:border-accent focus:outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-neutral-700">Teléfono / WhatsApp</label>
          <input type="tel" required placeholder="+51 987 654 321" class="mt-1 w-full rounded-lg border border-neutral-300 p-2.5 text-xs text-neutral-900 focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label class="block font-bold text-neutral-700">Correo Electrónico</label>
          <input type="email" required placeholder="contacto@empresa.com" class="mt-1 w-full rounded-lg border border-neutral-300 p-2.5 text-xs text-neutral-900 focus:border-accent focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block font-bold text-neutral-700">Dirección de entrega (Perú)</label>
        <input type="text" required placeholder="Av. Principal 123, Distrito, Región" class="mt-1 w-full rounded-lg border border-neutral-300 p-2.5 text-xs text-neutral-900 focus:border-accent focus:outline-none" />
      </div>

      <div>
        <label class="block font-bold text-neutral-700 mb-1.5">Método de Pago</label>
        <div class="grid grid-cols-3 gap-2">
          <label class="flex flex-col items-center justify-center p-2 rounded-lg border border-neutral-300 cursor-pointer hover:border-accent has-checked:border-accent has-checked:bg-accent-soft/30">
            <input type="radio" name="payment" value="yape" checked class="sr-only" />
            <span class="font-bold text-neutral-900">Yape / Plin</span>
            <span class="text-[10px] text-neutral-500">QR / Móvil</span>
          </label>
          <label class="flex flex-col items-center justify-center p-2 rounded-lg border border-neutral-300 cursor-pointer hover:border-accent has-checked:border-accent has-checked:bg-accent-soft/30">
            <input type="radio" name="payment" value="tarjeta" class="sr-only" />
            <span class="font-bold text-neutral-900">Tarjeta</span>
            <span class="text-[10px] text-neutral-500">Visa / MC</span>
          </label>
          <label class="flex flex-col items-center justify-center p-2 rounded-lg border border-neutral-300 cursor-pointer hover:border-accent has-checked:border-accent has-checked:bg-accent-soft/30">
            <input type="radio" name="payment" value="bcp" class="sr-only" />
            <span class="font-bold text-neutral-900">Transferencia</span>
            <span class="text-[10px] text-neutral-500">BCP / BBVA</span>
          </label>
        </div>
      </div>

      <div class="rounded-lg bg-neutral-50 p-3 text-neutral-600 border border-neutral-200">
        <div class="flex justify-between font-bold text-neutral-900">
          <span>Total a Pagar Simulado:</span>
          <span class="text-accent text-sm">S/ <span id="checkout-modal-total">0.00</span></span>
        </div>
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-accent py-3 font-semibold text-white hover:bg-accent-dark transition-colors shadow-sm"
      >
        Confirmar Pedido de Demostración
      </button>
    </form>
  </div>
</div>

<!-- Modal Pedido Exitoso -->
<div
  id="order-success-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs hidden"
>
  <div class="w-full max-w-md rounded-2xl bg-white p-6 sm:p-8 text-center shadow-2xl border border-neutral-200">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-display text-xl font-bold text-neutral-900">¡Pedido Simulado con Éxito!</h3>
    <p class="mt-2 text-xs text-neutral-600 leading-relaxed">
      Has probado con éxito el flujo de compra, cálculo automático y pasarela simulada del motor de comercio electrónico de Archity.
    </p>
    <div class="mt-4 rounded-lg bg-neutral-50 p-3 text-xs text-neutral-500 border border-neutral-200">
      Número de Orden Simulado: <strong class="text-neutral-900 font-mono">#ARC-2026-981</strong>
    </div>
    <button
      id="order-success-close"
      type="button"
      class="mt-6 w-full rounded-lg bg-neutral-900 py-2.5 text-xs font-semibold text-white hover:bg-neutral-800 transition-colors"
    >
      Entendido, volver a la tienda
    </button>
  </div>
</div>

<script>
  interface CartItem {
    id: string;
    name: string;
    price: number;
    image?: string;
    category?: string;
    quantity: number;
  }

  let cart: CartItem[] = [
    {
      id: "prod-1",
      name: "Kit Terminal de Telemetría Balanza IoT",
      price: 680.00,
      image: "",
      category: "Hardware Industrial",
      quantity: 1,
    },
    {
      id: "prod-3",
      name: "Licencia Anual SaaS AltoPlanta Tributario",
      price: 1200.00,
      image: "",
      category: "Software Corporativo",
      quantity: 1,
    }
  ];

  let appliedDiscount = 0; // Porcentaje 0 a 1

  const backdrop = document.getElementById("cart-backdrop");
  const drawer = document.getElementById("cart-drawer");
  const closeBtn = document.getElementById("cart-close-btn");
  const emptyState = document.getElementById("cart-empty-state");
  const itemsList = document.getElementById("cart-items-list");
  const itemCountEl = document.getElementById("cart-item-count");
  const subtotalEl = document.getElementById("cart-subtotal");
  const discountRow = document.getElementById("discount-row");
  const discountRateEl = document.getElementById("discount-rate");
  const discountEl = document.getElementById("cart-discount");
  const igvEl = document.getElementById("cart-igv");
  const shippingEl = document.getElementById("cart-shipping");
  const totalEl = document.getElementById("cart-total");
  const freeShippingText = document.getElementById("free-shipping-text");
  const freeShippingBar = document.getElementById("free-shipping-bar");
  const freeShippingPercent = document.getElementById("free-shipping-percent");

  const checkoutBtn = document.getElementById("btn-open-checkout") as HTMLButtonElement | null;
  const whatsappBtn = document.getElementById("btn-whatsapp-order") as HTMLButtonElement | null;

  const couponInput = document.getElementById("coupon-input") as HTMLInputElement | null;
  const applyCouponBtn = document.getElementById("apply-coupon-btn");
  const couponMsg = document.getElementById("coupon-message");

  const checkoutModal = document.getElementById("checkout-modal");
  const checkoutModalClose = document.getElementById("checkout-modal-close");
  const checkoutModalTotal = document.getElementById("checkout-modal-total");
  const checkoutForm = document.getElementById("checkout-form");
  const orderSuccessModal = document.getElementById("order-success-modal");
  const orderSuccessClose = document.getElementById("order-success-close");

  function openCart() {
    backdrop?.classList.remove("opacity-0", "pointer-events-none");
    backdrop?.classList.add("opacity-100");
    drawer?.classList.remove("translate-x-full");
  }

  function closeCart() {
    backdrop?.classList.remove("opacity-100");
    backdrop?.classList.add("opacity-0", "pointer-events-none");
    drawer?.classList.add("translate-x-full");
  }

  function renderCart() {
    const totalCount = cart.reduce((acc, item) => acc + item.quantity, 0);
    if (itemCountEl) itemCountEl.textContent = totalCount.toString();

    // Actualizar badges globales en la página (si existen)
    const globalBadges = document.querySelectorAll(".ecc-cart-badge-count");
    globalBadges.forEach(b => {
      b.textContent = totalCount.toString();
    });

    if (cart.length === 0) {
      if (emptyState) emptyState.classList.remove("hidden");
      if (itemsList) itemsList.innerHTML = "";
      if (checkoutBtn) checkoutBtn.disabled = true;
      if (whatsappBtn) whatsappBtn.disabled = true;
      if (subtotalEl) subtotalEl.textContent = "0.00";
      if (totalEl) totalEl.textContent = "0.00";
      if (igvEl) igvEl.textContent = "0.00";
      if (discountRow) discountRow.classList.add("hidden");
      if (freeShippingBar) freeShippingBar.style.width = "0%";
      if (freeShippingPercent) freeShippingPercent.textContent = "0%";
      return;
    }

    if (emptyState) emptyState.classList.add("hidden");
    if (checkoutBtn) checkoutBtn.disabled = false;
    if (whatsappBtn) whatsappBtn.disabled = false;

    // Calcular montos
    const subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    const discountAmount = subtotal * appliedDiscount;
    const discountedSubtotal = subtotal - discountAmount;
    const igv = discountedSubtotal * 0.18; // Calculado
    const shipping = discountedSubtotal >= 250 ? 0 : 15;
    const total = discountedSubtotal + shipping;

    if (subtotalEl) subtotalEl.textContent = subtotal.toFixed(2);
    if (igvEl) igvEl.textContent = igv.toFixed(2);
    if (shippingEl) shippingEl.textContent = shipping === 0 ? "¡Gratis!" : `S/ ${shipping.toFixed(2)}`;
    if (totalEl) totalEl.textContent = total.toFixed(2);
    if (checkoutModalTotal) checkoutModalTotal.textContent = total.toFixed(2);

    if (appliedDiscount > 0) {
      if (discountRow) discountRow.classList.remove("hidden");
      if (discountRateEl) discountRateEl.textContent = `${Math.round(appliedDiscount * 100)}%`;
      if (discountEl) discountEl.textContent = discountAmount.toFixed(2);
    } else {
      if (discountRow) discountRow.classList.add("hidden");
    }

    // Barra de envío gratis
    const targetShipping = 250;
    const progress = Math.min(100, Math.round((subtotal / targetShipping) * 100));
    if (freeShippingBar) freeShippingBar.style.width = `${progress}%`;
    if (freeShippingPercent) freeShippingPercent.textContent = `${progress}%`;
    if (freeShippingText) {
      if (subtotal >= targetShipping) {
        freeShippingText.textContent = "🎉 ¡Felicidades! Tienes Envío Gratis activado";
      } else {
        const missing = (targetShipping - subtotal).toFixed(2);
        freeShippingText.textContent = `Agrega S/ ${missing} más para Envío Gratis`;
      }
    }

    // Renderizar HTML de ítems
    if (itemsList) {
      itemsList.innerHTML = cart.map(item => `
        <div class="flex items-center gap-3 rounded-xl border border-neutral-200/80 bg-neutral-50/40 p-3">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-white border border-neutral-200 font-display font-bold text-accent text-sm">
            ${item.name.substring(0, 2).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="truncate text-xs font-bold text-neutral-900">${item.name}</h4>
            <span class="text-[11px] text-neutral-500">${item.category || "General"}</span>
            <div class="mt-1 font-display text-xs font-bold text-accent">
              S/ ${item.price.toFixed(2)}
            </div>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <button
              type="button"
              data-remove-id="${item.id}"
              class="cart-btn-remove text-neutral-400 hover:text-rose-600 transition-colors p-1"
              title="Eliminar ítem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
            <div class="flex items-center rounded-md border border-neutral-300 bg-white">
              <button
                type="button"
                data-decrease-id="${item.id}"
                class="cart-btn-decrease px-2 py-0.5 text-xs text-neutral-600 hover:bg-neutral-100"
              >-</button>
              <span class="px-2 text-xs font-semibold text-neutral-900">${item.quantity}</span>
              <button
                type="button"
                data-increase-id="${item.id}"
                class="cart-btn-increase px-2 py-0.5 text-xs text-neutral-600 hover:bg-neutral-100"
              >+</button>
            </div>
          </div>
        </div>
      `).join("");

      // Event listeners para los botones internos de cada fila
      itemsList.querySelectorAll(".cart-btn-remove").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = (e.currentTarget as HTMLElement).getAttribute("data-remove-id");
          if (target) {
            cart = cart.filter(i => i.id !== target);
            renderCart();
          }
        });
      });

      itemsList.querySelectorAll(".cart-btn-decrease").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = (e.currentTarget as HTMLElement).getAttribute("data-decrease-id");
          const item = cart.find(i => i.id === target);
          if (item) {
            if (item.quantity > 1) {
              item.quantity--;
            } else {
              cart = cart.filter(i => i.id !== target);
            }
            renderCart();
          }
        });
      });

      itemsList.querySelectorAll(".cart-btn-increase").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const target = (e.currentTarget as HTMLElement).getAttribute("data-increase-id");
          const item = cart.find(i => i.id === target);
          if (item) {
            item.quantity++;
            renderCart();
          }
        });
      });
    }
  }

  // Listener para agregar productos desde cualquier parte de la página
  window.addEventListener("ecc:add-to-cart", ((e: CustomEvent) => {
    const newProduct = e.detail;
    const existing = cart.find(i => i.id === newProduct.id);
    if (existing) {
      existing.quantity += newProduct.quantity || 1;
    } else {
      cart.push({
        id: newProduct.id,
        name: newProduct.name,
        price: Number(newProduct.price),
        image: newProduct.image || "",
        category: newProduct.category || "General",
        quantity: newProduct.quantity || 1
      });
    }
    renderCart();
    openCart();
  }) as EventListener);

  // Apertura del carrito desde botones con clase .ecc-open-cart
  document.querySelectorAll(".ecc-open-cart").forEach(btn => {
    btn.addEventListener("click", () => openCart());
  });

  closeBtn?.addEventListener("click", closeCart);
  backdrop?.addEventListener("click", closeCart);

  // Cupones
  applyCouponBtn?.addEventListener("click", () => {
    const code = couponInput?.value.trim().toUpperCase();
    if (code === "ARCHITY10") {
      appliedDiscount = 0.10;
      if (couponMsg) {
        couponMsg.className = "mt-1 text-[11px] text-emerald-600 font-medium block";
        couponMsg.textContent = "✓ Cupón ARCHITY10 aplicado: 10% de descuento.";
      }
    } else if (code === "EMPRESA20") {
      appliedDiscount = 0.20;
      if (couponMsg) {
        couponMsg.className = "mt-1 text-[11px] text-emerald-600 font-medium block";
        couponMsg.textContent = "✓ Cupón EMPRESA20 aplicado: 20% de descuento especial corporativo.";
      }
    } else {
      appliedDiscount = 0;
      if (couponMsg) {
        couponMsg.className = "mt-1 text-[11px] text-rose-500 font-medium block";
        couponMsg.textContent = "Código inválido. Prueba con ARCHITY10 o EMPRESA20";
      }
    }
    renderCart();
  });

  // Modal checkout
  checkoutBtn?.addEventListener("click", () => {
    checkoutModal?.classList.remove("hidden");
  });
  checkoutModalClose?.addEventListener("click", () => {
    checkoutModal?.classList.add("hidden");
  });

  checkoutForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    checkoutModal?.classList.add("hidden");
    orderSuccessModal?.classList.remove("hidden");
    cart = [];
    appliedDiscount = 0;
    renderCart();
    closeCart();
  });

  orderSuccessClose?.addEventListener("click", () => {
    orderSuccessModal?.classList.add("hidden");
  });

  // Botón WhatsApp
  whatsappBtn?.addEventListener("click", () => {
    const total = totalEl?.textContent || "0.00";
    const itemsSummary = cart.map(i => `• ${i.quantity}x ${i.name} (S/ ${(i.price * i.quantity).toFixed(2)})`).join("\n");
    const msg = encodeURIComponent(`Hola Archity, deseo cotizar y realizar este pedido en la tienda:\n\n${itemsSummary}\n\nTotal estimado: S/ ${total}\n\n¿Me pueden confirmar tiempos de entrega?`);
    window.open(`https://wa.me/51940771896?text=${msg}`, "_blank");
  });

  // Render inicial
  renderCart();
</script>
