---
// Componente ECC: Tarjeta de Producto E-Commerce con interactividad y disparo de carrito
interface Props {
  id: string;
  name: string;
  category: string;
  price: number;
  originalPrice?: number;
  badge?: string;
  stock?: number;
  rating?: number;
  description?: string;
  tags?: string[];
  image?: string;
}

const {
  id,
  name,
  category,
  price,
  originalPrice,
  badge = "Disponible",
  stock = 12,
  rating = 4.9,
  description = "Solución lista para despliegue con garantía y soporte continuo.",
  tags = ["Garantía Archity", "Despacho Inmediato"],
  image,
} = Astro.props;

const discountPercent = originalPrice ? Math.round(((originalPrice - price) / originalPrice) * 100) : 0;
---

<div
  class="group relative flex flex-col rounded-2xl border border-neutral-200/90 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl hover:shadow-neutral-900/5"
  data-product-id={id}
  data-product-category={category}
  data-product-name={name.toLowerCase()}
  data-product-price={price}
>
  <!-- Cabecera de la tarjeta: Categoría y Badge -->
  <div class="flex items-center justify-between gap-2">
    <span class="text-[11px] font-bold uppercase tracking-wider text-accent">{category}</span>
    {discountPercent > 0 ? (
      <span class="rounded-full bg-rose-50 px-2.5 py-0.5 text-[11px] font-bold text-rose-600 border border-rose-200">
        -{discountPercent}% OFF
      </span>
    ) : (
      <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-[11px] font-semibold text-neutral-700">
        {badge}
      </span>
    )}
  </div>

  <!-- Contenedor Visual del Producto -->
  <div class="relative mt-4 flex h-48 w-full items-center justify-center overflow-hidden rounded-xl border border-neutral-100 bg-neutral-100">
    {image ? (
      <div class="relative h-full w-full">
        <img
          src={image}
          alt={name}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute bottom-2 left-2 flex items-center gap-1 rounded-md bg-neutral-900/80 px-2 py-0.5 text-[11px] font-bold text-amber-400 backdrop-blur-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span>{rating.toFixed(1)}</span>
          <span class="text-[10px] text-neutral-300 font-normal">({stock} un.)</span>
        </div>
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center transition-transform duration-300 group-hover:scale-105">
        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-white border border-neutral-200 text-2xl font-bold font-display text-neutral-900 shadow-sm group-hover:border-accent group-hover:text-accent transition-colors">
          {name.substring(0, 2).toUpperCase()}
        </div>
        <div class="mt-3 flex items-center gap-1 text-amber-500 text-xs font-semibold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span>{rating.toFixed(1)}</span>
          <span class="text-[10px] text-neutral-400 font-normal">({stock} en stock)</span>
        </div>
      </div>
    )}
  </div>

  <!-- Información del Producto -->
  <div class="mt-4 flex-1">
    <h3 class="font-display text-lg font-bold text-neutral-900 line-clamp-1 group-hover:text-accent transition-colors">
      {name}
    </h3>
    <p class="mt-1 text-xs text-neutral-600 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Tags del producto -->
    <div class="mt-3 flex flex-wrap gap-1">
      {tags.map((t) => (
        <span class="rounded bg-neutral-100 px-2 py-0.5 text-[10px] font-medium text-neutral-600">
          {t}
        </span>
      ))}
    </div>
  </div>

  <!-- Precios y Botón de Compra -->
  <div class="mt-5 border-t border-neutral-100 pt-4">
    <div class="flex items-baseline justify-between mb-3">
      <div>
        <span class="text-[10px] uppercase font-bold text-neutral-400">Precio Online</span>
        <div class="flex items-baseline gap-1.5">
          <span class="text-xs font-bold text-neutral-500">S/</span>
          <span class="font-display text-2xl font-bold text-neutral-900">{price.toFixed(2)}</span>
          {originalPrice && (
            <span class="text-xs text-neutral-400 line-through">
              S/ {originalPrice.toFixed(2)}
            </span>
          )}
        </div>
      </div>
      <div class="text-right">
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Stock en Perú
        </span>
      </div>
    </div>

    <!-- Botón interactivo de añadir al carrito -->
    <button
      type="button"
      class="ecc-btn-add flex w-full items-center justify-center gap-2 rounded-lg bg-neutral-900 py-2.5 text-xs font-bold text-white transition-all hover:bg-accent hover:shadow-md hover:shadow-accent/20 active:scale-98"
      data-id={id}
      data-name={name}
      data-price={price}
      data-category={category}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Añadir al Carrito
    </button>
  </div>
</div>

<script>
  // Manejador del botón añadir al carrito
  document.querySelectorAll(".ecc-btn-add").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const button = e.currentTarget as HTMLElement;
      const id = button.getAttribute("data-id") || "";
      const name = button.getAttribute("data-name") || "";
      const price = parseFloat(button.getAttribute("data-price") || "0");
      const category = button.getAttribute("data-category") || "";

      // Disparar evento personalizado con los datos del producto
      const event = new CustomEvent("ecc:add-to-cart", {
        detail: { id, name, price, category, quantity: 1 }
      });
      window.dispatchEvent(event);

      // Feedback visual momentáneo en el botón
      const originalText = button.innerHTML;
      button.classList.add("bg-emerald-600");
      button.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        ¡Añadido!
      `;
      setTimeout(() => {
        button.classList.remove("bg-emerald-600");
        button.innerHTML = originalText;
      }, 1200);
    });
  });
</script>
