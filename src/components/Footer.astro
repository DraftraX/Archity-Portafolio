---
const year = new Date().getFullYear();

const navLinks = [
  { label: "AltoPlanta (SaaS PropTech)", href: "/productos/altoplanta" },
  { label: "ERP Grupo Pineda (Industrial)", href: "/productos/grupo-pineda" },
  { label: "Tiendas Virtuales & E-commerce", href: "/#servicios" },
  { label: "Landing Pages para Empresas", href: "/#servicios" },
  { label: "Contacto & Cotización", href: "/#contacto" },
];

const externalProducts = [
  { label: "AltoPlanta Oficial (altoplanta.com)", href: "https://altoplanta.com/" },
  { label: "Grupo Pineda Oficial (grupopineda.pe)", href: "https://grupopineda.pe/" },
];

const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/archit-tech/?viewAsMember=true" },
  { label: "WhatsApp Corporativo", href: "https://wa.me/51940771896" },
  { label: "GitHub", href: "https://github.com/DraftraX" },
];
---

<footer class="border-t border-neutral-200/80 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">

      <!-- Marca con Isotipo y Logotipo -->
      <div>
        <a href="/" class="flex items-center gap-2.5" aria-label="Archity — inicio">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white shadow-xs">
            <svg viewBox="0 0 150 140" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <polygon points="74.5,0 88.5,26 35.5,126 0,140" />
              <polygon points="97,43.5 86,63.5 100.5,90.5 70,90.5 62.5,104.5 108,104.5 126.5,138.5 149,138.5" />
            </svg>
          </span>
          <span class="font-display text-sm font-bold tracking-[0.25em] text-neutral-900">ARCHITY</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-neutral-600">
          Estudio de ingeniería de software en Perú. Creamos <strong>tiendas virtuales</strong>, <strong>landing pages corporativas</strong>, <strong>plataformas SaaS</strong> y <strong>ERPs a medida</strong>.
        </p>
        <a
          href="mailto:wmanuelga@gmail.com"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline transition-colors"
        >
          wmanuelga@gmail.com
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5 19.5 4.5m0 0H8.25m11.25 0v11.25" />
          </svg>
        </a>
      </div>

      <!-- Navegación interna -->
      <nav aria-label="Enlaces del pie de página">
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400">Soluciones &amp; Páginas</h3>
        <ul class="mt-4 space-y-2.5">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-neutral-600 transition-colors hover:text-neutral-900">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Plataformas en vivo & Redes -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400">Plataformas en Vivo</h3>
        <ul class="mt-4 space-y-2.5">
          {
            externalProducts.map((p) => (
              <li>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
                >
                  {p.label}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3 w-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5 19.5 4.5m0 0H8.25m11.25 0v11.25" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400">Canales Directos</h3>
        <ul class="mt-3 space-y-2.5 text-xs">
          <li>
            <a href="https://www.linkedin.com/company/archit-tech/?viewAsMember=true" target="_blank" rel="noopener" class="text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0" preserveAspectRatio="xMidYMid" viewBox="0 0 256 256">
                <path d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453" fill="#0A66C2"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/51940771896" target="_blank" rel="noopener" class="text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 360 362">
                <path fill="#25D366" fill-rule="evenodd" d="M307.546 52.566C273.709 18.684 228.706.017 180.756 0 81.951 0 1.538 80.404 1.504 179.235c-.017 31.594 8.242 62.432 23.928 89.609L0 361.736l95.024-24.925c26.179 14.285 55.659 21.805 85.655 21.814h.077c98.788 0 179.21-80.413 179.244-179.244.017-47.898-18.608-92.926-52.454-126.807v-.008Zm-126.79 275.788h-.06c-26.73-.008-52.952-7.194-75.831-20.765l-5.44-3.231-56.391 14.791 15.05-54.981-3.542-5.638c-14.912-23.721-22.793-51.139-22.776-79.286.035-82.14 66.867-148.973 149.051-148.973 39.793.017 77.198 15.53 105.328 43.695 28.131 28.157 43.61 65.596 43.593 105.398-.035 82.149-66.867 148.982-148.982 148.982v.008Zm81.719-111.577c-4.478-2.243-26.497-13.073-30.606-14.568-4.108-1.496-7.09-2.243-10.073 2.243-2.982 4.487-11.568 14.577-14.181 17.559-2.613 2.991-5.226 3.361-9.704 1.117-4.477-2.243-18.908-6.97-36.02-22.226-13.313-11.878-22.304-26.54-24.916-31.027-2.613-4.486-.275-6.91 1.959-9.136 2.011-2.011 4.478-5.234 6.721-7.847 2.244-2.613 2.983-4.486 4.478-7.469 1.496-2.991.748-5.603-.369-7.847-1.118-2.243-10.073-24.289-13.812-33.253-3.636-8.732-7.331-7.546-10.073-7.692-2.613-.13-5.595-.155-8.586-.155-2.991 0-7.839 1.118-11.947 5.604-4.108 4.486-15.677 15.324-15.677 37.361s16.047 43.344 18.29 46.335c2.243 2.991 31.585 48.225 76.51 67.632 10.684 4.615 19.029 7.374 25.535 9.437 10.727 3.412 20.49 2.931 28.208 1.779 8.604-1.289 26.498-10.838 30.228-21.298 3.73-10.46 3.73-19.433 2.613-21.298-1.117-1.865-4.108-2.991-8.586-5.234l.008-.017Z" clip-rule="evenodd"/>
              </svg>
              <span>WhatsApp Corporativo</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/DraftraX" target="_blank" rel="noopener" class="text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Barra inferior de copyright -->
    <div class="mt-12 flex flex-col items-center justify-between border-t border-neutral-200/80 pt-8 text-xs text-neutral-400 sm:flex-row">
      <p>© {year} Archity. Hecho con precisión técnica en Perú.</p>
      <p class="mt-2 sm:mt-0 flex items-center gap-1.5 font-medium text-neutral-500">
        Astro v5 · Tailwind v4 · Cloud Native
      </p>
    </div>
  </div>
</footer>
