---
import { CONTACT, EXTERNAL_URLS } from "../constants/site";

const projectLinks = [
  { label: "AltoPlanta", href: "/productos/altoplanta" },
  { label: "ERP Grupo Pineda", href: "/productos/grupo-pineda" },
  { label: "Restobar System", href: "/proyectos/restobar-system" },
];

const liveLinks = [
  { label: "AltoPlanta Live", href: EXTERNAL_URLS.altoplanta },
  { label: "Grupo Pineda Live", href: EXTERNAL_URLS.grupoPineda },
  { label: "Restobar Vercel (placeholder)", href: EXTERNAL_URLS.restobarVercel },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200/80 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <p class="font-display text-sm font-bold tracking-[0.25em] text-neutral-900">ARCHITY</p>
      <p class="mt-3 max-w-xs text-sm text-neutral-600">Portafolio limpio para enlazar despliegues en Vercel y mostrar solo proyectos reales.</p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-500">Proyectos</p>
      <ul class="mt-3 space-y-2 text-sm">
        {projectLinks.map((link) => (
          <li><a href={link.href} class="text-neutral-700 hover:text-neutral-900">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-500">Enlaces externos</p>
      <ul class="mt-3 space-y-2 text-sm">
        {liveLinks.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener" class="text-accent hover:text-accent-dark">{link.label}</a></li>
        ))}
        <li><a href={`mailto:${CONTACT.email}`} class="text-neutral-700 hover:text-neutral-900">{CONTACT.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-neutral-200/80 py-5 text-center text-xs text-neutral-500">
    © {year} Archity · Frontend Astro + TypeScript
  </div>
</footer>
