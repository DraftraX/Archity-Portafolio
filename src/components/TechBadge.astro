    </svg>
  )}

  {key === "react" && (
    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(0 12 12)" />
      <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(60 12 12)" />
      <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(120 12 12)" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" />
    </svg>
  )}

  {key.includes("next") && (
    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 180 180" fill="currentColor">
      <mask height="180" id="mask0_next" maskUnits="userSpaceOnUse" width="180" x="0" y="0" style="mask-type:alpha"><circle cx="90" cy="90" fill="black" r="90"/></mask>
      <g mask="url(#mask0_next)">
        <circle cx="90" cy="90" data-circle="true" fill="black" r="90"/>
        <path d="M149.508 157.52L69.142 54H54V125.97H66.1136V69.3836L139.999 164.845C143.333 162.614 146.509 160.165 149.508 157.52Z" fill="white"/>
        <rect fill="white" height="72" width="12" x="115" y="54"/>
      </g>
    </svg>
  )}

  {key.includes("type") && (
    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M1.5 0h21A1.5 1.5 0 0 1 24 1.5v21a1.5 1.5 0 0 1-1.5 1.5h-21A1.5 1.5 0 0 1 0 22.5v-21A1.5 1.5 0 0 1 1.5 0zm10.02 9.07H8.55v9.91h2.97v-9.91zm1.26 0v2.43h2.34v7.48h2.97v-7.48h2.34V9.07h-7.65z" fill="currentColor"/>
