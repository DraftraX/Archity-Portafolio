---
// Casos de éxito / proyectos a medida en formato lista limpia
// EDITA AQUÍ: tus casos. metric resalta el resultado clave en azul.
const cases = [
  {
    name: "Clínica San Rafael",
    sector: "Salud",
    year: "2024",
    description: "Historias clínicas digitales, agenda médica y facturación integrada.",
    metric: "−60%",
    metricLabel: "tiempo administrativo",
    image: "", // ej: "/images/cases/clinica.webp"
    url: "#",
  },
  {
    name: "Logística Andina",
    sector: "Logística",
    year: "2024",
    description: "Panel de control de flota, despachos y seguimiento de entregas en vivo.",
    metric: "+32%",
    metricLabel: "entregas puntuales",
    image: "",
    url: "#",
  },
  {
    name: "Academia Vertex",
    sector: "Educación",
    year: "2023",
    description: "Plataforma e-learning con cursos, pagos recurrentes y certificados.",
    metric: "3 500+",
    metricLabel: "estudiantes activos",
    image: "",
    url: "#",
  },
  {
    name: "Distribuidora Norka",
    sector: "Retail B2B",
    year: "2023",
    description: "Catálogo mayorista en línea con precios por volumen y cotizaciones.",
    metric: "+45%",
    metricLabel: "conversión a pedido",
    image: "",
    url: "#",
  },
];
---

<section id="casos" class="scroll-mt-20 border-t border-neutral-200/70 bg-neutral-50/50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">

    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Casos de éxito
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Proyectos a medida que funcionan
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Soluciones construidas junto a clientes reales, con resultados medibles.
      </p>
    </div>

    <ul class="mt-10 divide-y divide-neutral-200/70">
      {
        cases.map((c) => (
          <li>
            <a
              href={c.url}
              class="group -mx-3 flex flex-col gap-4 rounded-xl px-3 py-5 transition-colors hover:bg-white hover:shadow-sm sm:flex-row sm:items-center sm:gap-6"
            >
              <!-- Miniatura de referencia -->
              <div class="h-16 w-24 shrink-0 overflow-hidden rounded-lg border border-neutral-200 bg-neutral-100 sm:h-20 sm:w-32">
                {c.image ? (
                  <img src={c.image} alt={`Referencia de ${c.name}`} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-neutral-400 bg-gradient-to-br from-neutral-50 to-neutral-100">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-neutral-300 transition-transform group-hover:scale-110" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A1.5 1.5 0 0 0 21.75 19.5V4.5A1.5 1.5 0 0 0 20.25 3H3.75A1.5 1.5 0 0 0 2.25 4.5v15A1.5 1.5 0 0 0 3.75 21Z" />
                    </svg>
                  </div>
                )}
              </div>

              <!-- Info -->
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display text-base font-semibold text-neutral-900 transition-colors group-hover:text-accent sm:text-lg">{c.name}</h3>
                  <span class="rounded-md border border-neutral-200 bg-white px-2 py-0.5 text-[11px] font-medium text-neutral-500">
                    {c.sector}
                  </span>
                  <span class="text-xs text-neutral-400">{c.year}</span>
                </div>
                <p class="mt-1 text-sm text-neutral-600 line-clamp-1">{c.description}</p>
              </div>

              <!-- Métrica destacada -->
              <div class="flex items-baseline gap-2 sm:flex-col sm:items-end sm:gap-0">
                <span class="font-display text-2xl font-bold tracking-tight text-accent sm:text-3xl">{c.metric}</span>
                <span class="text-xs font-medium text-neutral-500">{c.metricLabel}</span>
              </div>

              <!-- Flecha icono -->
              <div class="hidden text-neutral-400 transition-transform group-hover:translate-x-1 group-hover:text-neutral-900 sm:block">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
