---
// Casos de éxito y despliegues reales desarrollados por Archity con sus logotipos oficiales
const cases = [
  {
    name: "AltoPlanta — Plataforma SaaS PropTech & Cartografía CAD",
    sector: "PropTech / GIS / SaaS",
    year: "2024 - 2026",
    logo: "/logos/altoplanta-symbol.svg",
    description: "Digitalización de planos CAD (.DXF) georreferenciados sobre Google Maps, recorridos virtuales 360°, portales White-Label, pagos divididos con Mercado Pago Marketplace y app Android GPS.",
    metric: "360° + CAD",
    metricLabel: "lotización interactiva",
    url: "/productos/altoplanta",
    externalUrl: "https://altoplanta.com/",
  },
  {
    name: "Vinkula CRM — Suite Inmobiliaria Multicanal & Agente IA",
    sector: "CRM B2B / WhatsApp API / IA",
    year: "2025 - 2026",
    logo: "/logos/vinkula-mark.svg",
    description: "CRM multi-tenant inspirado en Twenty con vista Spreadsheet reactiva, embudo Kanban, bandeja compartida WhatsApp Cloud API y chatbot IA 24/7 con Google Gemini.",
    metric: "24/7 IA",
    metricLabel: "calificación en WhatsApp",
    url: "/productos/vinkula",
    externalUrl: "https://vinkula.altoplanta.com/",
  },
  {
    name: "Sencillo — Gestión de Letras, Cronogramas & Recaudación",
    sector: "FinTech / Cobranza Automatizada",
    year: "2025 - 2026",
    logo: "/logos/sencillo-mark.svg",
    description: "Generación automática de contratos, cronogramas de amortización (Francés o 0% TEA), cálculo diario de mora, conciliación vía Webhooks de Mercado Pago y Kardex digital.",
    metric: "100%",
    metricLabel: "conciliación automática",
    url: "/productos/sencillo",
    externalUrl: "https://sencillo.altoplanta.com/",
  },
  {
    name: "Grupo Pineda — ERP Consorcio Industrial (MATEPCO & ROCAFER)",
    sector: "Industrial / Concreto / Minería",
    year: "2024 - 2026",
    logo: "/logos/grupo-pineda-mark.svg",
    description: "ERP multiempresa para consorcio líder en el nororiente peruano: control de plantas de concreto MATEPCO (Tarapoto, Moyobamba, Chachapoyas), cantera ROCAFER y flota SERVIPIPA.",
    metric: "780 TM",
    metricLabel: "capacidad/día ROCAFER",
    url: "/productos/grupo-pineda",
    externalUrl: "https://grupopineda.pe/",
  },
  {
    name: "Inmobiliaria Flamingo — Proyecto Residencial Flamingo",
    sector: "Inmobiliaria / Showroom 360°",
    year: "2026",
    logo: "/logos/flamingo-logo.png",
    description: "Showroom inmersivo con transiciones de video de dron 0ms crossfade, plano SVG de 133 lotes (Mz K–R), modo Día/Noche, 4 modelos de casa con tour 360° y calibrador OpenCV.",
    metric: "133 Lotes",
    metricLabel: "masterplan interactivo",
    url: "/productos/proyect-flamingo",
    externalUrl: "https://proyect-flamingo.vercel.app/",
  },
  {
    name: "Centro Hemodador Regional de Loreto — Banco de Sangre Tipo II",
    sector: "Salud Pública / Hemoterapia",
    year: "2025 - 2026",
    logo: "/logos/bankblood-logo.png",
    description: "Plataforma institucional en Iquitos para los 15 servicios clínicos del flujo de donación (Admisión, Triaje, Tamizaje, Inmunohematología, Aféresis, Hemored) y campañas regionales.",
    metric: "Tipo II",
    metricLabel: "Centro Hemodador Loreto",
    url: "/productos/bank-blood",
    externalUrl: "https://bank-blood-lake.vercel.app/",
  },
  {
    name: "RestoManager 3D (RESTORY) — Sistema Gastronómico & Plano 3D",
    sector: "Gastronomía / Three.js WebGL",
    year: "2025 - 2026",
    logo: "/logos/restory-logo.png",
    description: "Sistema full-stack con diseñador de salón 3D interactivo en Three.js (12m x 10m), rutas de evacuación CatmullRom, carta digital con video HD y descuento atómico de insumos.",
    metric: "3D WebGL",
    metricLabel: "salón interactivo en vivo",
    url: "/productos/restorant-system",
    externalUrl: "https://github.com/DraftraX/restorant_system",
  },
  {
    name: "Archity Billing Service — Facturación Electrónica SUNAT UBL 2.1",
    sector: "FinTech / Tributario SUNAT",
    year: "2025 - 2026",
    logo: "/logos/billing-mark.svg",
    description: "Microservicio multi-tenant con consola Front-End interactiva: emisión de Facturas, Boletas, Notas de Crédito/Débito, firma XMLDSig RSA-SHA256, envío SOAP SUNAT y SDKs en 3 lenguajes.",
    metric: "UBL 2.1",
    metricLabel: "XMLDSig + CDR SUNAT",
    url: "/productos/billing-service",
    externalUrl: "https://github.com/DraftraX/billing-service",
  },
];
---

<section id="casos" class="scroll-mt-20 border-t border-neutral-200/70 bg-neutral-50/50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Índice de Despliegues Reales
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Los 8 sistemas construidos por Archity
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Cada proyecto cuenta con su identidad visual oficial, arquitectura verificable, repositorio o despliegue en producción activa.
      </p>
    </div>

    <ul class="mt-12 divide-y divide-neutral-200/80">
      {
        cases.map((c) => (
          <li>
            <div
              class="group -mx-4 flex flex-col gap-4 rounded-2xl p-5 transition-colors hover:bg-white hover:shadow-sm sm:flex-row sm:items-center sm:gap-6"
            >
              <!-- Logo oficial del proyecto -->
              <a
                href={c.url}
                class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-neutral-200 bg-white p-2.5 shadow-2xs group-hover:border-accent transition-colors"
              >
                <img src={c.logo} alt={c.name} class="h-full w-full object-contain" loading="lazy" />
              </a>

              <!-- Info -->
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={c.url} class="font-display text-base font-bold text-neutral-900 transition-colors group-hover:text-accent sm:text-lg">
                    {c.name}
                  </a>
                  <span class="rounded-md border border-neutral-200 bg-neutral-100 px-2 py-0.5 text-[11px] font-semibold text-neutral-600">
                    {c.sector}
                  </span>
                  <span class="text-xs text-neutral-400">{c.year}</span>
                </div>
                <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{c.description}</p>
                <div class="mt-2 flex items-center gap-4 text-xs">
                  <a href={c.url} class="font-semibold text-accent hover:underline">
                    Ver arquitectura e interfaz &rarr;
                  </a>
                  {c.externalUrl && (
                    <a href={c.externalUrl} target="_blank" rel="noopener" class="text-neutral-500 hover:text-neutral-900 font-medium transition-colors">
                      Abrir enlace oficial ↗
                    </a>
                  )}
                </div>
              </div>

              <!-- Métrica destacada -->
              <div class="flex items-baseline gap-2 sm:flex-col sm:items-end sm:gap-0 pl-2 sm:pl-4 border-l border-neutral-100 shrink-0">
                <span class="font-display text-2xl font-bold tracking-tight text-accent sm:text-3xl">{c.metric}</span>
                <span class="text-xs font-medium text-neutral-500">{c.metricLabel}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
