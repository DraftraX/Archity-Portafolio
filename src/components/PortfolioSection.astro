---
import { EXTERNAL_URLS } from "../constants/site";

const cases = [
  {
    name: "AltoPlanta",
    impact: "SaaS tributario operando en producción",
    metric: "100%",
    metricLabel: "flujo digital",
    detailUrl: "/productos/altoplanta",
    liveUrl: EXTERNAL_URLS.altoplanta,
  },
  {
    name: "ERP Grupo Pineda",
    impact: "Operación industrial con control centralizado",
    metric: "3",
    metricLabel: "sedes conectadas",
    detailUrl: "/productos/grupo-pineda",
    liveUrl: EXTERNAL_URLS.grupoPineda,
  },
  {
    name: "Restobar System",
    impact: "Frontend temporal sin backend con persistencia local",
    metric: "0",
    metricLabel: "dependencias servidor",
    detailUrl: "/proyectos/restobar-system",
    liveUrl: EXTERNAL_URLS.restobarVercel,
  },
];
---

<section id="casos" class="scroll-mt-20 border-t border-neutral-200/80 bg-neutral-50/50 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Casos reales</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Resultados visibles en proyectos reales</h2>
    </div>

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {cases.map((item) => (
        <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h3 class="font-display text-xl font-bold text-neutral-900">{item.name}</h3>
          <p class="mt-2 text-sm text-neutral-600">{item.impact}</p>
          <p class="mt-5 font-display text-4xl font-bold text-accent">{item.metric}</p>
          <p class="text-xs uppercase tracking-wide text-neutral-500">{item.metricLabel}</p>
          <div class="mt-5 flex items-center justify-between">
            <a href={item.detailUrl} class="text-sm font-semibold text-neutral-900 hover:text-accent">Caso</a>
            <a href={item.liveUrl} target="_blank" rel="noopener" class="text-sm font-semibold text-accent hover:text-accent-dark">Live ↗</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
