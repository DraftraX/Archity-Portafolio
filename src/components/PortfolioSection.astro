---
// Casos de éxito y proyectos reales desarrollados por Archity
const cases = [
  {
    name: "Grupo Pineda — Infraestructura & Minería",
    sector: "Industrial / Minería",
    year: "2024 - 2026",
    description: "ERP a medida para integración vertical: plantas de concreto, canteras de caliza, balanza y transporte pesado en la Amazonía peruana.",
    metric: "780 TM",
    metricLabel: "capacidad/día ROCAFER",
    url: "/productos/grupo-pineda",
    externalUrl: "https://grupopineda.pe/",
  },
  {
    name: "AltoPlanta — Ecosistema PropTech",
    sector: "Inmobiliario / SaaS",
    year: "2024 - 2026",
    description: "Plataforma nacional de búsqueda de inmuebles en Perú con tours virtuales 360°, generador de proformas PDF y CRM de leads.",
    metric: "Nacional",
    metricLabel: "cobertura en Perú",
    url: "/productos/altoplanta",
    externalUrl: "https://altoplanta.com/",
  },
  {
    name: "MATEPCO — Plantas de Concreto Automatizado",
    sector: "Construcción Vial",
    year: "2024 - 2025",
    description: "Automatización de dosificación y despacho de concreto premezclado en plantas de Tarapoto, Moyobamba y Chachapoyas.",
    metric: "3 Sedes",
    metricLabel: "plantas en línea",
    url: "/productos/grupo-pineda",
    externalUrl: "https://grupopineda.pe/services",
  },
];
---

<section id="casos" class="scroll-mt-20 border-t border-neutral-200/70 bg-neutral-50/50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Casos de Éxito Reales
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Soluciones construidas junto a clientes e industrias reales
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Cada proyecto que asumimos está diseñado para responder a requerimientos operativos estrictos y producir resultados cuantitativos.
      </p>
    </div>

    <ul class="mt-12 divide-y divide-neutral-200/80">
      {
        cases.map((c) => (
          <li>
            <div
              class="group -mx-4 flex flex-col gap-4 rounded-2xl p-5 transition-colors hover:bg-white hover:shadow-sm sm:flex-row sm:items-center sm:gap-6"
            >
              <!-- Icono o iniciales -->
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-neutral-200 bg-white font-display text-lg font-bold text-neutral-800 shadow-2xs group-hover:border-accent group-hover:text-accent transition-colors">
                {c.name.slice(0, 2).toUpperCase()}
              </div>

              <!-- Info -->
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <a href={c.url} class="font-display text-base font-bold text-neutral-900 transition-colors group-hover:text-accent sm:text-lg">
                    {c.name}
                  </a>
                  <span class="rounded-md border border-neutral-200 bg-neutral-100 px-2 py-0.5 text-[11px] font-semibold text-neutral-600">
                    {c.sector}
                  </span>
                  <span class="text-xs text-neutral-400">{c.year}</span>
                </div>
                <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{c.description}</p>
                <div class="mt-2 flex items-center gap-3 text-xs">
                  <a href={c.url} class="font-semibold text-accent hover:underline">
                    Ver caso completo &rarr;
                  </a>
                  {c.externalUrl && (
                    <a href={c.externalUrl} target="_blank" rel="noopener" class="text-neutral-400 hover:text-neutral-700 transition-colors">
                      Sitio en vivo ↗
                    </a>
                  )}
                </div>
              </div>

              <!-- Métrica destacada -->
              <div class="flex items-baseline gap-2 sm:flex-col sm:items-end sm:gap-0 pl-2 sm:pl-4 border-l border-neutral-100">
                <span class="font-display text-2xl font-bold tracking-tight text-accent sm:text-3xl">{c.metric}</span>
                <span class="text-xs font-medium text-neutral-500">{c.metricLabel}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
