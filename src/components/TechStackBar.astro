---
import TechBadge from "./TechBadge.astro";

const stack = [
  "Astro",
  "Django",
  "React",
  "Next.js",
  "TypeScript",
  "Python",
  "Node.js",
  "PostgreSQL",
  "Tailwind CSS",
  "Docker",
  "Redis",
];
---

<section class="border-b border-neutral-200/80 bg-white py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="shrink-0 text-center md:text-left">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Herramientas &amp; Stack</span>
        <p class="text-sm font-bold text-neutral-900 mt-0.5">Tecnologías modernas de ingeniería</p>
      </div>

      <div class="flex flex-wrap items-center justify-center md:justify-end gap-2">
        {stack.map((t) => (
          <TechBadge name={t} />
        ))}
      </div>
    </div>
  </div>
</section>
