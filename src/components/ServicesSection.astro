---
const services = [
  {
    title: "Astro + TypeScript",
    summary: "Landing pages y portafolios rápidos con arquitectura mantenible.",
  },
  {
    title: "E-commerce UX",
    summary: "Catálogos, filtros, carrito y checkout simulado listos para conectar.",
  },
  {
    title: "SaaS & Paneles",
    summary: "Interfaces orientadas a métricas, operación y escalabilidad.",
  },
  {
    title: "Migración Frontend",
    summary: "Separación de backend y migración a frontend temporal con cache local.",
  },
];
---

<section id="servicios" class="scroll-mt-20 border-t border-neutral-200/80 bg-neutral-50/40 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Servicios</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Construcción digital enfocada en impacto</h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {services.map((service) => (
        <article class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <h3 class="font-display text-xl font-semibold text-neutral-900">{service.title}</h3>
          <p class="mt-2 text-sm text-neutral-600">{service.summary}</p>
        </article>
      ))}
    </div>
  </div>
</section>
