---
// Sección de capacidades y servicios de ingeniería de Archity
const services = [
  {
    icon: "layers",
    title: "Plataformas SaaS & Marketplaces",
    description: "Diseñamos y desarrollamos productos de software desde cero: autenticación segura, roles avanzados, arquitectura multi-tenant, pagos en línea y alta velocidad.",
    highlight: "Caso referente: AltoPlanta.com",
    tags: ["Astro", "React", "Next.js", "PostgreSQL", "Tours 360°", "PDFs"],
  },
  {
    icon: "cpu",
    title: "ERPs & Software Industrial a Medida",
    description: "Sistemas robustos adaptados a las operaciones reales de tu empresa: control de producción, balanzas y canteras, plantas automatizadas y logística de flota pesada.",
    highlight: "Caso referente: ERP Grupo Pineda",
    tags: ["Control de Plantas", "Telemetría", "Gestión de Flota", "Facturación B2B"],
  },
  {
    icon: "zap",
    title: "Automatización & APIs de Integración",
    description: "Conectamos tu ecosistema tecnológico: integración con facturación electrónica SUNAT, automatizaciones por WhatsApp, CRMs y microservicios en la nube.",
    highlight: "Menos tareas manuales, mayor velocidad",
    tags: ["APIs REST", "Webhooks", "SUNAT", "WhatsApp API", "Cron Jobs"],
  },
  {
    icon: "shield",
    title: "Arquitectura Cloud & DevOps Moderno",
    description: "Infraestructura cloud moderna, segura y optimizada para máxima velocidad y disponibilidad continua. Cero tiempos muertos y monitoreo preventivo.",
    highlight: "Disponibilidad y velocidad garantizadas",
    tags: ["Docker", "Linux", "CI/CD", "Postgres", "Redis", "SSL"],
  },
];
---

<section id="servicios" class="scroll-mt-20 border-t border-neutral-200/70 bg-neutral-50/50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Capacidades de Ingeniería
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        ¿Qué podemos construir para tu empresa?
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Somos un estudio de software nuevo, ágil y enfocado en entregar productos de alta fidelidad técnica que resuelvan problemas operativos reales.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:gap-8">
      {
        services.map((s) => (
          <div class="group relative flex flex-col rounded-2xl border border-neutral-200/80 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl hover:shadow-neutral-900/5">
            <span class="inline-block text-xs font-bold text-accent mb-2">{s.highlight}</span>
            <h3 class="font-display text-xl font-bold text-neutral-900">{s.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-neutral-600 grow">{s.description}</p>

            <ul class="mt-6 flex flex-wrap gap-1.5 border-t border-neutral-100 pt-4" aria-label="Tecnologías">
              {s.tags.map((t) => (
                <li class="rounded-md border border-neutral-200/80 bg-neutral-50 px-2 py-0.5 text-[11px] font-medium text-neutral-600">
                  {t}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

  </div>
</section>
