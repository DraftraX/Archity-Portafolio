---
// Sección de soluciones a construir por Archity: E-commerce, Landing Pages, SaaS y ERPs
// Paleta estricta: Azul (#1a5cff), Negro (#09090b) y Blanco (#ffffff)
const solutions = [
  {
    category: "Comercio Electrónico",
    title: "Tiendas Virtuales & E-commerce",
    badge: "Ventas 24/7",
    description: "Desarrollamos tiendas online ultrarrápidas y optimizadas para vender: catálogos interactivos, carrito sin fricción, pasarelas de pago (Yape, Plin, Culqi, Stripe) y panel de control de pedidos e inventario.",
    highlights: [
      "Integración de pagos peruanos e internacionales",
      "Experiencia de compra optimizada para celulares",
      "Alertas automáticas de pedidos a WhatsApp",
      "Panel de administración simple e intuitivo",
    ],
    tags: ["E-commerce", "Yape / Plin", "Culqi / Stripe", "Catálogo Rápido", "Stock"],
  },
  {
    category: "Presencia Corporativa",
    title: "Landing Pages de Alta Conversión",
    badge: "Captación de Clientes",
    description: "Diseñamos páginas web profesionales y modernas para tu empresa con la estética limpia y angular de Archity. Enfocadas en transmitir credibilidad, indexar en Google y convertir visitantes en prospectos calificados.",
    highlights: [
      "Diseño exclusivo y minimalista (sin plantillas lentas)",
      "Velocidad de carga de 1 segundo (Astro + Tailwind)",
      "Formularios inteligentes y enlace directo a WhatsApp",
      "SEO técnico para destacar en los buscadores",
    ],
    tags: ["Landing Page", "SEO Google", "Alta Velocidad", "Conversión", "Mobile First"],
  },
  {
    category: "Software Escalable",
    title: "Plataformas SaaS & Marketplaces",
    badge: "Referente: AltoPlanta",
    description: "De la idea al producto en producción: arquitectura cloud multiusuario, suscripciones recurrentes, dashboards y funcionalidades avanzadas como tours virtuales 360° y generación de documentos PDF.",
    highlights: [
      "Búsqueda geolocalizada y filtros en tiempo real",
      "Generación instantánea de proformas en PDF",
      "CRM de prospectos y trazabilidad de ventas",
      "Infraestructura cloud para miles de usuarios",
    ],
    tags: ["PropTech", "SaaS Multi-tenant", "Tours 360°", "Proformas PDF", "CRM"],
  },
  {
    category: "Operaciones Complejas",
    title: "ERPs & Sistemas a la Medida",
    badge: "Referente: Grupo Pineda",
    description: "Digitalizamos procesos críticos que las soluciones enlatadas no pueden resolver: control de plantas de producción, telemetría de balanzas, gestión de maquinaria pesada, canteras y facturación B2B.",
    highlights: [
      "Control en tiempo real de plantas y canteras",
      "Telemetría de balanza y pesaje de vehículos",
      "Monitoreo de maquinaria pesada y combustible",
      "Facturación electrónica masiva integrada",
    ],
    tags: ["ERP Industrial", "Control de Plantas", "Balanza", "Maquinaria", "Logística"],
  },
];
---

<section id="servicios" class="scroll-mt-20 border-t border-neutral-200/80 bg-neutral-50/50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="max-w-2xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        Soluciones que Construimos
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        ¿Qué proyecto deseas desarrollar para tu empresa?
      </h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Desde tiendas virtuales para vender en todo el país hasta páginas corporativas de alto impacto y plataformas SaaS a gran escala.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        solutions.map((s) => (
          <div class="group relative flex flex-col rounded-2xl border border-neutral-200/90 bg-white p-8 transition duration-300 hover:-translate-y-1 hover:border-neutral-300 hover:shadow-xl hover:shadow-neutral-900/5">
            
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-bold uppercase tracking-wider text-accent">{s.category}</span>
              <span class="rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-semibold text-accent border border-accent/20">
                {s.badge}
              </span>
            </div>

            <h3 class="font-display text-2xl font-bold text-neutral-900">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">{s.description}</p>

            <!-- Lista de puntos clave con icono azul -->
            <ul class="my-5 space-y-2 border-t border-b border-neutral-100 py-4 text-xs text-neutral-700">
              {s.highlights.map((h) => (
                <li class="flex items-center gap-2.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <!-- Tags -->
            <ul class="mt-auto flex flex-wrap gap-1.5" aria-label="Tecnologías">
              {s.tags.map((t) => (
                <li class="rounded-md border border-neutral-200/80 bg-neutral-50 px-2.5 py-1 text-[11px] font-medium text-neutral-600">
                  {t}
                </li>
              ))}
            </ul>

            <!-- Botón CTA hacia cotizador -->
            <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between">
              <span class="text-xs text-neutral-400">Entrega rápida &amp; código a medida</span>
              <a
                href="#contacto"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-accent hover:text-accent-dark transition-colors"
              >
                Cotizar este desarrollo &rarr;
              </a>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
