const solutions = [
  {
    category: "Ecosistema SaaS PropTech & FinTech",
    title: "Cartografía Interactiva, CRM Multicanal & Recaudación",
    badge: "AltoPlanta · Vinkula · Sencillo",
    logo: "/logos/altoplanta-symbol.svg",
    description: "Desarrollamos el ecosistema SaaS inmobiliario más completo del Perú: desde la digitalización de planos CAD .DXF sobre Google Maps y portales White-Label (AltoPlanta), hasta CRM con bandeja WhatsApp e IA (Vinkula) y cobranza automatizada de letras (Sencillo).",
    highlights: [
      "Visor cartográfico con vuelos de cámara van Wijk y recorridos 360°",
      "CRM inspirado en Twenty con bandeja WhatsApp Cloud API y Agente IA Gemini",
      "Cronogramas de amortización (Francés / 0% TEA) con cálculo diario de mora",
      "Split de pagos automático y conciliación vía Webhooks de Mercado Pago",
    ],
    tags: ["Astro 5", "Django 5", "Google Maps JS API", "WhatsApp Cloud API", "Gemini AI", "Mercado Pago"],
    demoUrl: "/productos/altoplanta",
    demoLabel: "Explorar Ecosistema AltoPlanta ↗",
  },
  {
    category: "Operaciones Industriales & Consorcios",
    title: "ERPs Multi-Empresa & Telemetría de Planta",
    badge: "ERP Grupo Pineda",
