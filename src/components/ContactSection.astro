---
// Sección interactiva de cotización y contacto
---

<section id="contacto" class="scroll-mt-20 border-t border-neutral-200/70 bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <!-- Columna izquierda: Información -->
      <div>
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
          Hablemos de tu Proyecto
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
          Construyamos software que haga crecer tu negocio
        </h2>
        <p class="mt-4 text-base leading-relaxed text-neutral-600">
          Ya sea que desees lanzar una plataforma SaaS como <strong>AltoPlanta</strong> o implementar un ERP operativo como el de <strong>Grupo Pineda</strong>, estamos listos para evaluar tus requerimientos y proponerte la mejor arquitectura.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">Correo Electrónico</strong>
              <a href="mailto:hola@archity.dev" class="text-sm text-neutral-600 hover:text-accent transition-colors">hola@archity.dev</a>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v5.009z" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">Atención Rápida por WhatsApp</strong>
              <span class="text-sm text-neutral-600">Coordinación directa de reuniones técnicas</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-neutral-100 text-neutral-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">Ubicación</strong>
              <span class="text-sm text-neutral-600">Perú (Servicio a nivel nacional y remoto)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Formulario interactivo -->
      <div class="rounded-2xl border border-neutral-200/80 bg-neutral-50/60 p-6 sm:p-8 shadow-sm">
        <h3 class="font-display text-lg font-bold text-neutral-900 mb-4">
          Solicita una cotización o asesoría técnica
        </h3>

        <form id="contact-form" class="space-y-4">
          <!-- Tipo de proyecto -->
          <div>
            <label class="block text-xs font-semibold text-neutral-700 mb-1.5">Tipo de Solución</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent">
                <input type="radio" name="tipo" value="Plataforma SaaS" checked class="text-accent focus:ring-accent" />
                <span>Plataforma SaaS</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent">
                <input type="radio" name="tipo" value="ERP / Sistema a Medida" class="text-accent focus:ring-accent" />
                <span>ERP a Medida</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent">
                <input type="radio" name="tipo" value="PropTech / Tours 360" class="text-accent focus:ring-accent" />
                <span>Solución PropTech</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent">
                <input type="radio" name="tipo" value="Automatización / Integración" class="text-accent focus:ring-accent" />
                <span>Integración / API</span>
              </label>
            </div>
          </div>

          <!-- Nombre y Email -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="nombre" class="block text-xs font-semibold text-neutral-700 mb-1">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                placeholder="Tu nombre o empresa"
                class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-800 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-neutral-700 mb-1">Correo Electrónico</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@empresa.com"
                class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-800 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
              />
            </div>
          </div>

          <!-- Mensaje -->
          <div>
            <label for="mensaje" class="block text-xs font-semibold text-neutral-700 mb-1">Detalles de tu idea o requerimiento</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="3"
              required
              placeholder="Cuéntanos brevemente qué necesitas automatizar o construir..."
              class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-800 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
            ></textarea>
          </div>

          <!-- Botones de envío -->
          <div class="pt-2 flex flex-col sm:flex-row gap-2">
            <button
              type="submit"
              class="w-full rounded-lg bg-accent px-5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-accent-dark transition-colors"
            >
              Enviar por Correo
            </button>
            <button
              type="button"
              id="btn-whatsapp"
              class="w-full rounded-lg border border-emerald-600 bg-emerald-500 px-5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-emerald-600 transition-colors flex items-center justify-center gap-1.5"
            >
              Contactar por WhatsApp
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const btnWhatsapp = document.getElementById("btn-whatsapp");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const nombre = formData.get("nombre") || "";
    const email = formData.get("email") || "";
    const tipo = formData.get("tipo") || "";
    const mensaje = formData.get("mensaje") || "";

    const subject = encodeURIComponent(`[Archity] Consulta de Proyecto: ${tipo} - ${nombre}`);
    const body = encodeURIComponent(
      `Hola equipo de Archity,\n\nMi nombre es: ${nombre}\nEmail: ${email}\nTipo de proyecto: ${tipo}\n\nDetalles:\n${mensaje}\n\nQuedo atento a su respuesta.`
    );
    window.location.href = `mailto:hola@archity.dev?subject=${subject}&body=${body}`;
  });

  btnWhatsapp?.addEventListener("click", () => {
    const formData = form ? new FormData(form) : null;
    const nombre = formData?.get("nombre") || "un interesado";
    const tipo = formData?.get("tipo") || "nuevo proyecto";
    const text = encodeURIComponent(
      `¡Hola Archity! Mi nombre es ${nombre}. Me interesa cotizar una solución de tipo: ${tipo}.`
    );
    // WhatsApp corporativo de enlace directo
    window.open(`https://wa.me/?text=${text}`, "_blank");
  });
</script>
