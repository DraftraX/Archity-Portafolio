---
// Sección interactiva de cotización y contacto con paleta estricta: azul, negro y blanco
---

<section id="contacto" class="scroll-mt-20 border-t border-neutral-200/80 bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <!-- Columna izquierda: Información -->
      <div>
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
          Hablemos de tu Proyecto
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
          Construyamos software que haga crecer tu negocio
        </h2>
        <p class="mt-4 text-base leading-relaxed text-neutral-600">
          Desarrollamos <strong>tiendas virtuales e-commerce</strong> de alta velocidad, <strong>landing pages corporativas</strong> para tu empresa, <strong>plataformas SaaS</strong> y <strong>ERPs industriales</strong> a la medida. Cuéntanos qué necesitas y te responderemos de inmediato.
        </p>

        <div class="mt-8 space-y-4">
          <!-- Email -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-neutral-900 text-white shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">Correo Electrónico</strong>
              <a href="mailto:wmanuelga@gmail.com" class="text-sm font-medium text-accent hover:underline transition-colors">wmanuelga@gmail.com</a>
            </div>
          </div>

          <!-- WhatsApp -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent text-white shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v5.009z" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">WhatsApp Directo</strong>
              <a href="https://wa.me/51940771896" target="_blank" rel="noopener" class="text-sm font-medium text-accent hover:underline transition-colors">
                +51 940 771 896
              </a>
              <span class="block text-xs text-neutral-500">Atención rápida y coordinación de reuniones</span>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-neutral-100 text-neutral-900 border border-neutral-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.8v8.37h-2.8v-8.37M7.86 6.81a1.63 1.63 0 1 0 1.63 1.63 1.63 1.63 0 0 0-1.63-1.63Z" />
              </svg>
            </div>
            <div>
              <strong class="block text-sm font-semibold text-neutral-900">LinkedIn Corporativo</strong>
              <a href="https://www.linkedin.com/company/archit-tech/?viewAsMember=true" target="_blank" rel="noopener" class="text-sm font-medium text-accent hover:underline transition-colors">
                Archity en LinkedIn
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Formulario interactivo -->
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8 shadow-xs">
        <h3 class="font-display text-lg font-bold text-neutral-900 mb-4">
          Solicita una cotización o asesoría técnica
        </h3>

        <form id="contact-form" class="space-y-4">
          <!-- Tipo de proyecto -->
          <div>
            <label class="block text-xs font-semibold text-neutral-700 mb-1.5">¿Qué deseas construir?</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent transition-colors">
                <input type="radio" name="tipo" value="Tienda Virtual / E-commerce" checked class="text-accent focus:ring-accent" />
                <span class="font-medium">Tienda Virtual E-commerce</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent transition-colors">
                <input type="radio" name="tipo" value="Landing Page Empresarial" class="text-accent focus:ring-accent" />
                <span class="font-medium">Landing Page Empresa</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent transition-colors">
                <input type="radio" name="tipo" value="Plataforma SaaS" class="text-accent focus:ring-accent" />
                <span class="font-medium">Plataforma SaaS</span>
              </label>
              <label class="flex items-center gap-2 rounded-lg border border-neutral-200 bg-white p-2.5 cursor-pointer hover:border-accent transition-colors">
                <input type="radio" name="tipo" value="ERP / Sistema a Medida" class="text-accent focus:ring-accent" />
                <span class="font-medium">ERP / Sistema a Medida</span>
              </label>
            </div>
          </div>

          <!-- Nombre y Email -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="nombre" class="block text-xs font-semibold text-neutral-700 mb-1">Tu Nombre o Empresa</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                placeholder="Ej. Manuel García"
                class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-neutral-700 mb-1">Tu Correo Electrónico</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@empresa.com"
                class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
              />
            </div>
          </div>

          <!-- Mensaje -->
          <div>
            <label for="mensaje" class="block text-xs font-semibold text-neutral-700 mb-1">Detalles de tu requerimiento</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="3"
              required
              placeholder="Cuéntanos sobre tu tienda virtual, landing page o sistema que deseas desarrollar..."
              class="w-full rounded-lg border border-neutral-200 bg-white px-3.5 py-2 text-sm text-neutral-900 placeholder-neutral-400 focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
            ></textarea>
          </div>

          <!-- Botones de envío: estricto azul y negro -->
          <div class="pt-2 flex flex-col sm:flex-row gap-2.5">
            <button
              type="submit"
              class="w-full rounded-lg bg-accent px-5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:bg-accent-dark transition-colors"
            >
              Enviar por Correo
            </button>
            <button
              type="button"
              id="btn-whatsapp"
              class="w-full rounded-lg border border-neutral-900 bg-neutral-900 px-5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:bg-neutral-800 transition-colors flex items-center justify-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              Escribir al WhatsApp
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const btnWhatsapp = document.getElementById("btn-whatsapp");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const nombre = formData.get("nombre") || "";
    const email = formData.get("email") || "";
    const tipo = formData.get("tipo") || "";
    const mensaje = formData.get("mensaje") || "";

    const subject = encodeURIComponent(`[Archity] Solicitud de Cotización: ${tipo} - ${nombre}`);
    const body = encodeURIComponent(
      `Hola equipo de Archity,\n\nMi nombre es: ${nombre}\nEmail: ${email}\nTipo de proyecto: ${tipo}\n\nDetalles del proyecto:\n${mensaje}\n\nQuedo atento a su propuesta.`
    );
    window.location.href = `mailto:wmanuelga@gmail.com?subject=${subject}&body=${body}`;
  });

  btnWhatsapp?.addEventListener("click", () => {
    const formData = form ? new FormData(form) : null;
    const nombre = formData?.get("nombre") || "Hola";
    const tipo = formData?.get("tipo") || "un proyecto de software";
    const text = encodeURIComponent(
      `¡Hola Archity! Mi nombre es ${nombre}. Me gustaría cotizar: ${tipo}.`
    );
    window.open(`https://wa.me/51940771896?text=${text}`, "_blank");
  });
</script>
